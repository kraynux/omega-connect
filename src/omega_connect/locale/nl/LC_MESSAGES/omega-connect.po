#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — machine {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== Bijwerken van {tool} naar {version} ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ {tool} {version} geïnstalleerd."

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· al ingesteld: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "archief geweigerd: onverwacht pad {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr "archief geweigerd: {name} is geen bestand en geen map"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "archief geweigerd: te groot na uitpakken"

#, python-brace-format
msgid "archive refusée : pas de dossier {tool}/"
msgstr "archief geweigerd: geen map {tool}/"

#, python-brace-format
msgid "{path} est un lien : rien n'est copié dedans"
msgstr "{path} is een link: er wordt niets in gekopieerd"

#, python-brace-format
msgid "{root} n'est pas un dossier d'installation"
msgstr "{root} is geen installatiemap"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} is niet van dit account: handmatig bijwerken"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr ""
"vingerafdruk van het archief wijkt af van sha.txt: er wordt niets "
"geïnstalleerd"

#, python-brace-format
msgid "Mise de côté de l'ancienne installation : {old} → {new}"
msgstr "Oude installatie apart gezet: {old} → {new}"

msgid "impossible de mettre l'ancienne installation de côté (sudo mv)"
msgstr "kan de oude installatie niet apart zetten (sudo mv)"

#, python-brace-format
msgid "{count} fichiers installés dans {root}."
msgstr "{count} bestanden geïnstalleerd in {root}."

#, python-brace-format
msgid "install.sh introuvable dans {root}"
msgstr "install.sh niet gevonden in {root}"

#, python-brace-format
msgid ""
"Environnement Python (.venv) incomplet mis de côté : {path} — install.sh en "
"recrée un."
msgstr ""
"Onvolledige Python-omgeving (.venv) apart gezet: {path} — install.sh maakt "
"een nieuwe aan."

#, python-brace-format
msgid "Lancement de {path} :"
msgstr "Starten van {path}:"

#, python-brace-format
msgid "install.sh a échoué (code {code})"
msgstr "install.sh is mislukt (code {code})"

#, python-brace-format
msgid "{script} introuvable : réglages et données restés dans {old}"
msgstr "{script} niet gevonden: instellingen en gegevens gebleven in {old}"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"Instellingen en gegevens overgenomen van {old} (andere oude installaties "
"genegeerd: {others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "overnemen van {old} mislukt ({script})"

msgid "contient l'installation d'omega-connect"
msgstr "bevat de installatie van omega-connect"

