msgid ""
"omega-connect — authentification sudo pour les commandes affichées (le mot "
"de passe ne s'affiche pas pendant la saisie). L'interface revient ensuite."
msgstr ""
"omega-connect — autenticazione sudo per i comandi mostrati (la password non "
"viene visualizzata durante la digitazione). Poi l'interfaccia ritorna."

msgid "Aucune commande à copier."
msgstr "Nessun comando da copiare."

#, python-brace-format
msgid ""
