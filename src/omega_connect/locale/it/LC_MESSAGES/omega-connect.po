msgstr "{script} non trovato: impostazioni e dati rimasti in {old}"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"Recupero delle impostazioni e dei dati da {old} (altre vecchie installazioni"
" ignorate: {others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "recupero da {old} non riuscito ({script})"

