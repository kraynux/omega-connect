msgstr "{root} non è una cartella di installazione"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} non appartiene a questo account: aggiornamento da fare a mano"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr "impronta dell'archivio diversa da sha.txt: non viene installato nulla"

