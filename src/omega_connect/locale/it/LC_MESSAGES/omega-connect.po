#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — macchina {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== Aggiornamento di {tool} alla versione {version} ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ {tool} {version} installato."

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· già sistemato: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "archivio rifiutato: percorso inatteso {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr "archivio rifiutato: {name} non è né un file né una cartella"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "archivio rifiutato: troppo voluminoso una volta estratto"

#, python-brace-format
