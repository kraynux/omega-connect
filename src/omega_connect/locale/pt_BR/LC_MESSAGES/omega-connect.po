#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — máquina {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== Atualização de {tool} para {version} ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ {tool} {version} instalado."

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· já ajustado: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "arquivo compactado recusado: caminho inesperado {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr ""
"arquivo compactado recusado: {name} não é nem um arquivo nem uma pasta"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "arquivo compactado recusado: grande demais depois de extraído"

#, python-brace-format
msgid "archive refusée : pas de dossier {tool}/"
msgstr "arquivo compactado recusado: sem pasta {tool}/"

#, python-brace-format
msgid "{path} est un lien : rien n'est copié dedans"
msgstr "{path} é um link: nada é copiado nele"

#, python-brace-format
msgid "{root} n'est pas un dossier d'installation"
msgstr "{root} não é uma pasta de instalação"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} não pertence a esta conta: atualização feita manualmente"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr "hash do arquivo compactado diferente do sha.txt: nada foi instalado"

#, python-brace-format
msgid "Mise de côté de l'ancienne installation : {old} → {new}"
msgstr "Instalação antiga deixada de lado: {old} → {new}"

msgid "impossible de mettre l'ancienne installation de côté (sudo mv)"
msgstr "não foi possível deixar a instalação antiga de lado (sudo mv)"

#, python-brace-format
msgid "{count} fichiers installés dans {root}."
msgstr "{count} arquivos instalados em {root}."

#, python-brace-format
msgid "install.sh introuvable dans {root}"
msgstr "install.sh não encontrado em {root}"

#, python-brace-format
msgid ""
"Environnement Python (.venv) incomplet mis de côté : {path} — install.sh en "
"recrée un."
msgstr ""
"Ambiente Python (.venv) incompleto deixado de lado: {path} — o install.sh "
"cria um novo."

#, python-brace-format
msgid "Lancement de {path} :"
msgstr "Executando {path}:"

#, python-brace-format
msgid "install.sh a échoué (code {code})"
msgstr "o install.sh falhou (código {code})"

#, python-brace-format
msgid "{script} introuvable : réglages et données restés dans {old}"
msgstr "{script} não encontrado: configurações e dados permaneceram em {old}"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"Recuperação das configurações e dados de {old} (outras instalações antigas "
"ignoradas: {others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "falha ao recuperar {old} ({script})"

msgid "contient l'installation d'omega-connect"
msgstr "contém a instalação do omega-connect"

