msgstr "install.sh no encontrado en {root}"

#, python-brace-format
msgid ""
"Environnement Python (.venv) incomplet mis de côté : {path} — install.sh en "
"recrée un."
msgstr ""
"Entorno Python (.venv) incompleto apartado: {path} — install.sh crea uno "
"nuevo."

#, python-brace-format
msgid "Lancement de {path} :"
msgstr "Ejecución de {path}:"

