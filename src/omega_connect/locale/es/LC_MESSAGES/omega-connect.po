msgstr "{script} no encontrado: ajustes y datos se quedan en {old}"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"Recuperación de los ajustes y datos de {old} (otras instalaciones anteriores"
" ignoradas: {others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "recuperación de {old} fallida ({script})"

msgid "contient l'installation d'omega-connect"
msgstr "contiene la instalación de omega-connect"

