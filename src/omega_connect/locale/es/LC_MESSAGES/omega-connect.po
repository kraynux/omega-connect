#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — máquina {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== Actualización de {tool} a {version} ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ {tool} {version} instalado."

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· ya ajustado: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "archivo rechazado: ruta inesperada {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr "archivo rechazado: {name} no es ni un archivo ni una carpeta"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "archivo rechazado: demasiado voluminoso una vez extraído"

#, python-brace-format
msgid "archive refusée : pas de dossier {tool}/"
msgstr "archivo rechazado: no hay carpeta {tool}/"

#, python-brace-format
msgid "{path} est un lien : rien n'est copié dedans"
msgstr "{path} es un enlace: no se copia nada en él"

#, python-brace-format
msgid "{root} n'est pas un dossier d'installation"
msgstr "{root} no es una carpeta de instalación"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} no pertenece a esta cuenta: actualización hecha a mano"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr "huella del archivo distinta de sha.txt: no se instala nada"

#, python-brace-format
msgid "Mise de côté de l'ancienne installation : {old} → {new}"
msgstr "Se aparta la instalación anterior: {old} → {new}"

msgid "impossible de mettre l'ancienne installation de côté (sudo mv)"
msgstr "imposible apartar la instalación anterior (sudo mv)"

#, python-brace-format
