msgstr "อ่านไม่ได้ (สิทธิ์)"

msgid "abîmé"
msgstr "เสียหาย"

msgid "d'une version plus récente qu'omega-connect"
msgstr "มาจากเวอร์ชันที่ใหม่กว่า omega-connect"

msgid "non fournie (version de l'outil trop ancienne ?)"
msgstr "ไม่ได้ให้มา (เวอร์ชันของเครื่องมือเก่าเกินไป?)"

msgid "non obtenue"
msgstr "ไม่ได้รับ"

msgid "illisible"
msgstr "อ่านไม่ได้"

msgid "active"
msgstr "ใช้งานอยู่"

msgid "désactivée"
msgstr "ปิดใช้งาน"

msgid "absente"
msgstr "ไม่มี"

msgid "inconnue"
msgstr "ไม่ทราบ"

#, python-brace-format
msgid "registre des instances omega-serv illisible : {detail}"
msgstr "อ่านทะเบียนอินสแตนซ์ omega-serv ไม่ได้: {detail}"

#, python-brace-format
msgid "instance omega-serv enregistrée mais dossier disparu : {detail}"
msgstr "อินสแตนซ์ omega-serv ลงทะเบียนไว้แต่โฟลเดอร์หายไป: {detail}"

#, python-brace-format
msgid "fichier de service illisible : {detail}"
msgstr "อ่านไฟล์บริการไม่ได้: {detail}"

#, python-brace-format
msgid "service {detail} : dossier d'installation introuvable"
msgstr "บริการ {detail}: ไม่พบโฟลเดอร์การติดตั้ง"

#, python-brace-format
msgid "recherche arrêtée (trop de dossiers) dans {detail}"
msgstr "หยุดการค้นหา (โฟลเดอร์มากเกินไป) ใน {detail}"

#, python-brace-format
msgid "montage réseau non parcouru : {detail}"
msgstr "ไม่ได้สำรวจจุดเมานต์เครือข่าย: {detail}"

#, python-brace-format
msgid "dossier introuvable : {detail}"
msgstr "ไม่พบโฟลเดอร์: {detail}"

#, python-brace-format
msgid "aucun outil omega dans : {detail}"
msgstr "ไม่มีเครื่องมือ omega ใน: {detail}"

#, python-brace-format
msgid "créez-le sous le compte {owner} : {command}"
msgstr "สร้างภายใต้บัญชี {owner}: {command}"

msgid "outil inconnu"
msgstr "เครื่องมือที่ไม่รู้จัก"

#, python-brace-format
msgid "trouvé par : {sources}"
msgstr "พบโดย: {sources}"

#, python-brace-format
msgid "propriétaire : {owner}"
msgstr "เจ้าของ: {owner}"

#, python-brace-format
msgid "service : {names}"
msgstr "บริการ: {names}"

#, python-brace-format
msgid "jeton : présent (identifiant {identifier}, version {version})"
msgstr "โทเค็น: มีอยู่ (ตัวระบุ {identifier}, เวอร์ชัน {version})"

#, python-brace-format
msgid "jeton : {state}"
msgstr "โทเค็น: {state}"

#, python-brace-format
msgid "fiche : {state}"
msgstr "เอกสารข้อมูล: {state}"

#, python-brace-format
msgid "détail technique : {detail}"
msgstr "รายละเอียดทางเทคนิค: {detail}"

#, python-brace-format
msgid "fiche : instance {instance}"
msgstr "เอกสารข้อมูล: อินสแตนซ์ {instance}"

#, python-brace-format
msgid "service {manager} ({state})"
msgstr "บริการ {manager} ({state})"

msgid "partielle (sans root)"
msgstr "บางส่วน (ไม่มี root)"

#, python-brace-format
msgid "fonctions : {states}"
msgstr "ฟังก์ชัน: {states}"

#, python-brace-format
msgid "Détection des outils omega (HOME examiné : {home})"
msgstr "การตรวจหาเครื่องมือ omega (HOME ที่ตรวจ: {home})"

msgid "Aucun outil omega trouvé. Indiquez un dossier avec --chemin."
msgstr "ไม่พบเครื่องมือ omega ระบุโฟลเดอร์ด้วย --chemin"

#, python-brace-format
msgid ""
"Identifiant en double {identifier} : {roots} (dossier copié à la main ?). "
"Ces installations ne sont pas fusionnées ; ouvrez la copie une fois pour lui"
" donner un nouvel identifiant."
msgstr ""
"ตัวระบุซ้ำ {identifier}: {roots} (คัดลอกโฟลเดอร์ด้วยมือ?) "
"การติดตั้งเหล่านี้จะไม่ถูกรวมกัน "
"เปิดสำเนานั้นหนึ่งครั้งเพื่อให้ได้ตัวระบุใหม่"

msgid "Remarques sur la recherche :"
msgstr "หมายเหตุเกี่ยวกับการค้นหา:"

#, python-brace-format
msgid "{count} installation(s) trouvée(s)."
msgstr "พบการติดตั้ง {count} รายการ"

msgid "Détectée"
msgstr "ตรวจพบแล้ว"

msgid "Inscrite"
msgstr "ลงทะเบียนแล้ว"

msgid "Reliée"
msgstr "เชื่อมโยงแล้ว"

msgid "À réparer"
msgstr "ต้องซ่อมแซม"

msgid "Ancienne version"
msgstr "เวอร์ชันเก่า"

msgid "Installation inachevée"
msgstr "ติดตั้งไม่เสร็จ"

msgid "Injoignable"
msgstr "ติดต่อไม่ได้"

msgid "trouvée, sans carte d'identité : la Synchronisation la lui crée"
msgstr "พบแล้ว ไม่มีบัตรประจำตัว: การซิงค์จะสร้างให้"

msgid ""
"a sa carte d'identité, pas encore dans l'espace partagé : la Synchronisation"
" l'y ajoute"
msgstr ""
"มีบัตรประจำตัวแล้ว ยังไม่อยู่ในพื้นที่ใช้ร่วมกัน: การซิงค์จะเพิ่มเข้าไป"

msgid "dans l'espace partagé, à jour"
msgstr "อยู่ในพื้นที่ใช้ร่วมกัน เป็นปัจจุบัน"

msgid "un écart : Réparer le corrige"
msgstr "มีความคลาดเคลื่อน: ซ่อมแซมจะแก้ไขให้"

msgid "trop ancienne pour avoir une carte d'identité : mettez-la à jour"
msgstr "เก่าเกินกว่าจะมีบัตรประจำตัว: โปรดอัปเดต"

msgid ""
"installée, mais son install.sh ne s'est pas terminé (environnement Python ou"
" carte d'identité manquants) : « Réinstaller l'application » (Registre)"
msgstr ""
"ติดตั้งแล้ว แต่ install.sh ทำงานไม่เสร็จ (ไม่มีสภาพแวดล้อม Python "
"หรือบัตรประจำตัว): «ติดตั้งแอปพลิเคชันใหม่» (ทะเบียน)"

msgid "machine qui ne répond pas"
msgstr "เครื่องที่ไม่ตอบสนอง"

#, python-brace-format
msgid ""
"trop ancienne pour avoir une carte d'identité : {tool} {version} ou plus "
"récent requis (machine distante : Synchronisation la met à jour depuis "
"GitHub)"
msgstr ""
"เก่าเกินกว่าจะมีบัตรประจำตัว: ต้องใช้ {tool} {version} หรือใหม่กว่า "
"(เครื่องระยะไกล: การซิงค์จะอัปเดตจาก GitHub)"

msgid "pas encore préparé — la Synchronisation le prépare"
msgstr "ยังไม่ได้เตรียม — การซิงค์จะเตรียมให้"

msgid "prêt"
msgstr "พร้อม"

msgid "à corriger — la Synchronisation le remet en état"
msgstr "ต้องแก้ไข — การซิงค์จะคืนสภาพให้"

msgid "prêt (lu avec votre autorisation)"
msgstr "พร้อม (อ่านโดยได้รับอนุญาตจากคุณ)"

msgid ""
"état inconnu depuis cette session — la Synchronisation le lira avec votre "
"autorisation"
msgstr "ไม่ทราบสถานะในเซสชันนี้ — การซิงค์จะอ่านโดยได้รับอนุญาตจากคุณ"

#, python-brace-format
msgid "Registre — machine {machine}"
msgstr "ทะเบียน — เครื่อง {machine}"

msgid "Aucune application omega trouvée sur cette machine."
msgstr "ไม่พบแอปพลิเคชัน omega บนเครื่องนี้"

#, python-brace-format
msgid "Espace partagé : {status}"
msgstr "พื้นที่ใช้ร่วมกัน: {status}"

msgid "Synchroniser : un seul plan, un seul mot de passe administrateur"
msgstr "ซิงค์: แผนเดียว รหัสผ่านผู้ดูแลระบบครั้งเดียว"

msgid "Rien à faire : tout est déjà synchronisé."
msgstr "ไม่มีอะไรต้องทำ: ทุกอย่างซิงค์แล้ว"

msgid ""
"1. Cartes d'identité à créer (par chaque outil, sous son compte, sans mot de"
" passe) :"
msgstr ""
"1. บัตรประจำตัวที่ต้องสร้าง (โดยแต่ละเครื่องมือ ภายใต้บัญชีของตน "
"ไม่ต้องใช้รหัสผ่าน):"

msgid "aucune : chaque application choisie a déjà la sienne."
msgstr "ไม่มี: แต่ละแอปพลิเคชันที่เลือกมีบัตรของตนแล้ว"

msgid "2. Espace partagé (en administrateur, une commande après l'autre) :"
msgstr "2. พื้นที่ใช้ร่วมกัน (ในฐานะผู้ดูแลระบบ ทีละคำสั่ง):"

#, python-brace-format
msgid "Recopier la carte d'identité de {root} (créée à l'étape 1)"
msgstr "คัดลอกบัตรประจำตัวของ {root} (สร้างในขั้นตอนที่ 1)"

msgid "rien : l'espace partagé est déjà à jour."
msgstr "ไม่มี: พื้นที่ใช้ร่วมกันเป็นปัจจุบันแล้ว"

msgid "Une commande qui n'est pas annoncée ici n'est jamais lancée."
msgstr "คำสั่งที่ไม่ได้แสดงไว้ที่นี่จะไม่ถูกเรียกใช้เด็ดขาด"

#, python-brace-format
msgid ""
"Arrêt : la carte d'identité de {root} n'a pas pu être créée ({error}). Rien "
"d'autre n'a été lancé."
msgstr ""
"หยุด: ไม่สามารถสร้างบัตรประจำตัวของ {root} ได้ ({error}) "
"ไม่มีการเรียกใช้สิ่งอื่น"

msgid "échec"
msgstr "ล้มเหลว"

#, python-brace-format
msgid ""
"Arrêt avant l'espace partagé : le plan a changé ({step}). Rien de plus n'a "
"été lancé ; relancez la synchronisation pour voir le nouveau plan."
msgstr ""
"หยุดก่อนถึงพื้นที่ใช้ร่วมกัน: แผนเปลี่ยนไป ({step}) "
"ไม่มีการเรียกใช้สิ่งใดเพิ่ม เรียกการซิงค์อีกครั้งเพื่อดูแผนใหม่"

#, python-brace-format
msgid ""
"Arrêt à l'étape « {step} » : {error}. Ce qui a été créé est noté ; relancez "
"la synchronisation après avoir corrigé la cause."
msgstr ""
"หยุดที่ขั้นตอน «{step}»: {error} สิ่งที่สร้างแล้วถูกบันทึกไว้ "
"เรียกการซิงค์อีกครั้งหลังแก้ไขสาเหตุ"

msgid "Synchronisation terminée : les applications choisies sont reliées."
msgstr "การซิงค์เสร็จสิ้น: แอปพลิเคชันที่เลือกเชื่อมโยงกันแล้ว"

msgid "DÉMARRAGE RAPIDE"
msgstr "เริ่มต้นอย่างรวดเร็ว"

msgid "RACCOURCIS"
msgstr "ปุ่มลัด"

msgid "Aide d’omega-connect"
msgstr "ความช่วยเหลือของ omega-connect"

msgid "Aide complète : chaque menu, sa fonction et le détail."
msgstr "ความช่วยเหลือฉบับเต็ม: แต่ละเมนู หน้าที่ และรายละเอียด"

msgid "Démarrage rapide"
msgstr "เริ่มต้นอย่างรวดเร็ว"

msgid "Raccourcis"
msgstr "ปุ่มลัด"

msgid "Touche"
msgstr "ปุ่ม"

msgid "Action"
msgstr "การดำเนินการ"

#, python-brace-format
msgid "OMEGA-CONNECT {version} — aide."
msgstr "OMEGA-CONNECT {version} — ความช่วยเหลือ"

msgid "Aide - Omega-Connect"
msgstr "ความช่วยเหลือ - Omega-Connect"

msgid ""
"Interconnecteur de la suite omega : détecte les outils installés, vérifie et"
" attribue les droits entre eux."
msgstr ""
"ตัวเชื่อมต่อของชุด omega: ตรวจหาเครื่องมือที่ติดตั้ง "
"ตรวจสอบและกำหนดสิทธิ์ระหว่างกัน"

msgid "commandes"
msgstr "คำสั่ง"

msgid "COMMANDE"
msgstr "คำสั่ง"

msgid "Cherche les outils omega installés (lecture seule, sans root)."
msgstr "ค้นหาเครื่องมือ omega ที่ติดตั้ง (อ่านอย่างเดียว ไม่ต้องใช้ root)"

msgid ""
"Cherche les outils omega installés : registre d'omega-serv, services systemd"
" / OpenRC / runit, HOME (3 niveaux), /srv (2 niveaux) et chemins saisis. Ne "
"suit jamais un lien symbolique ni un montage réseau. Lit le jeton de chaque "
"installation et demande sa fiche à l'outil, sous le compte propriétaire du "
"dossier."
msgstr ""
"ค้นหาเครื่องมือ omega ที่ติดตั้ง: ทะเบียนของ omega-serv, บริการ systemd / "
"OpenRC / runit, HOME (3 ระดับ), /srv (2 ระดับ) และพาธที่ป้อน "
"ไม่ตามลิงก์สัญลักษณ์หรือจุดเมานต์เครือข่ายเด็ดขาด "
"อ่านโทเค็นของแต่ละการติดตั้งและขอเอกสารข้อมูลจากเครื่องมือ "
"ภายใต้บัญชีเจ้าของโฟลเดอร์"

msgid "DOSSIER"
msgstr "โฟลเดอร์"

msgid "Dossier d'installation à examiner en plus (option répétable)."
msgstr "โฟลเดอร์การติดตั้งที่จะตรวจเพิ่ม (ใช้ตัวเลือกซ้ำได้)"

msgid ""
"Ne demande pas la fiche aux outils (plus rapide, aucune commande lancée)."
msgstr "ไม่ขอเอกสารข้อมูลจากเครื่องมือ (เร็วกว่า ไม่เรียกใช้คำสั่งใด)"

msgid "texte (défaut, traduit) ou json (pour les scripts, jamais traduit)."
msgstr "texte (ค่าเริ่มต้น แปลแล้ว) หรือ json (สำหรับสคริปต์ ไม่แปลเด็ดขาด)"

msgid "Vérifie les liens existants entre outils (lecture seule, sans root)."
msgstr ""
"ตรวจสอบการเชื่อมโยงที่มีอยู่ระหว่างเครื่องมือ (อ่านอย่างเดียว ไม่ต้องใช้ "
"root)"

msgid ""
"Détecte les outils (avec leur fiche), puis contrôle chaque lien : journaux "
"d'omega-serv et de magnet lus par les jails d'omega-jail, pont fail2ban vers"
" la liste noire, liste protégée, droits de la liste noire, fichiers d'omega-"
"jail dans fail2ban, jetons. Chaque écart affiche la commande qui le "
"corrigerait, sans jamais la lancer. Code de sortie : 0 sans écart, 1 si un "
"lien est cassé ou dégradé."
msgstr ""
"ตรวจหาเครื่องมือ (พร้อมเอกสารข้อมูล) แล้วตรวจแต่ละการเชื่อมโยง: ล็อกของ "
"omega-serv และ magnet ที่ jail ของ omega-jail อ่าน, สะพาน fail2ban "
"ไปยังบัญชีดำ, รายการที่ได้รับการปกป้อง, สิทธิ์ของบัญชีดำ, ไฟล์ของ omega-jail"
" ใน fail2ban, โทเค็น แต่ละความคลาดเคลื่อนจะแสดงคำสั่งที่ใช้แก้ไข "
"โดยไม่เรียกใช้เด็ดขาด รหัสออก: 0 เมื่อไม่มีความคลาดเคลื่อน, 1 "
"หากการเชื่อมโยงเสียหรือเสื่อมสภาพ"

msgid "Affiche aussi les contrôles conformes."
msgstr "แสดงการตรวจที่ผ่านด้วย"

msgid ""
"Ouvre le tableau de bord (défaut sans commande) : outils, liens et leur "
"état, en lecture seule."
msgstr ""
"เปิดแดชบอร์ด (ค่าเริ่มต้นเมื่อไม่มีคำสั่ง): เครื่องมือ การเชื่อมโยงและสถานะ "
"แบบอ่านอย่างเดียว"

msgid ""
"Tableau de bord en lecture seule : outils et instances, état de chaque lien,"
" contrôles et commandes de correction (jamais lancées). Nouvelle "
"vérification à intervalle régulier tant que l'écran est ouvert."
msgstr ""
"แดชบอร์ดแบบอ่านอย่างเดียว: เครื่องมือและอินสแตนซ์ สถานะของแต่ละการเชื่อมโยง "
"การตรวจและคำสั่งแก้ไข (ไม่เรียกใช้เด็ดขาด) "
"ตรวจสอบใหม่เป็นระยะตราบที่หน้าจอเปิดอยู่"

msgid ""
"Crée la zone neutre et y recopie jetons et fiches (root, après accord)."
msgstr ""
"สร้างโซนกลางและคัดลอกโทเค็นและเอกสารข้อมูลเข้าไป (root หลังได้รับความยินยอม)"

msgid ""
"Crée le groupe omega-synchro et la zone neutre (/var/lib/omega-synchro, "
"2750), vous ajoute au groupe, recopie le jeton et la fiche de chaque outil "
"détecté, et inscrit tout au registre. Relancée, elle actualise les copies. "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"สร้างกลุ่ม omega-synchro และโซนกลาง (/var/lib/omega-synchro, 2750) "
"เพิ่มคุณเข้ากลุ่ม คัดลอกโทเค็นและเอกสารข้อมูลของแต่ละเครื่องมือที่ตรวจพบ "
"และลงทุกอย่างในทะเบียน เมื่อเรียกอีกครั้งจะอัปเดตสำเนา "
"แต่ละคำสั่งจะแสดงก่อนเรียกใช้ด้วย sudo"

msgid ""
"Défait ce qu'omega-connect a créé : un outil désinstallé, ou toute la zone "
"(root, après accord)."
msgstr ""
"ยกเลิกสิ่งที่ omega-connect สร้างไว้: เครื่องมือที่ถอนการติดตั้งแล้ว "
"หรือทั้งโซน (root หลังได้รับความยินยอม)"

msgid ""
"« retirer CIBLE » enlève de la zone un outil désinstallé (nom, dossier ou 8 "
"premiers caractères de l'identifiant). « retirer --tout » défait exactement "
"ce que le registre liste, ou garde la zone telle quelle (liens figés). "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"«retirer CIBLE» นำเครื่องมือที่ถอนการติดตั้งแล้วออกจากโซน (ชื่อ โฟลเดอร์ "
"หรือ 8 อักขระแรกของตัวระบุ) «retirer --tout» ยกเลิกตรงตามที่ทะเบียนระบุ "
"หรือคงโซนไว้ตามเดิม (การเชื่อมโยงถูกตรึง) แต่ละคำสั่งจะแสดงก่อนเรียกใช้ด้วย "
"sudo"

msgid "CIBLE"
msgstr "CIBLE"

msgid "Outil à retirer de la zone."
msgstr "เครื่องมือที่จะนำออกจากโซน"

msgid "Toute la zone (question : garder ou tout retirer)."
msgstr "ทั้งโซน (ถาม: เก็บไว้หรือนำออกทั้งหมด)"

msgid "Avec --tout : garder la zone, liens figés (rien n'est supprimé)."
msgstr "ใช้กับ --tout: เก็บโซนไว้ การเชื่อมโยงถูกตรึง (ไม่มีการลบสิ่งใด)"

msgid "Avec --tout : tout retirer, sans question."
msgstr "ใช้กับ --tout: นำออกทั้งหมด โดยไม่ถาม"

msgid ""
"Recherche les applications omega de cette machine et met à jour le registre "
"(lecture seule)."
msgstr "ค้นหาแอปพลิเคชัน omega ของเครื่องนี้และอัปเดตทะเบียน (อ่านอย่างเดียว)"

msgid ""
"Lecture seule, sans mot de passe : chaque application trouvée, son service "
"et son état (Détectée, Inscrite, Reliée, À réparer, Ancienne version, "
"Installation inachevée). Le résultat est enregistré dans le registre du parc"
" (var/parc.json)."
msgstr ""
"อ่านอย่างเดียว ไม่ต้องใช้รหัสผ่าน: แต่ละแอปพลิเคชันที่พบ บริการ และสถานะ "
"(ตรวจพบแล้ว, ลงทะเบียนแล้ว, เชื่อมโยงแล้ว, ต้องซ่อมแซม, เวอร์ชันเก่า, "
"ติดตั้งไม่เสร็จ) ผลลัพธ์จะบันทึกในทะเบียนเครื่อง (var/parc.json)"

msgid "UTILISATEUR@MACHINE"
msgstr "UTILISATEUR@MACHINE"

msgid ""
"Machine distante à scanner par SSH avec vos clés (rien n'y est installé) ; "
"sans cible : cette machine."
msgstr ""
"เครื่องระยะไกลที่จะสแกนผ่าน SSH ด้วยคีย์ของคุณ (ไม่ติดตั้งสิ่งใดที่นั่น) "
"หากไม่ระบุเป้าหมาย: เครื่องนี้"

msgid "MACHINE"
msgstr "MACHINE"

msgid ""
"Retire une machine distante du registre (nom, adresse ou "
"utilisateur@adresse) ; rien n'est modifié sur elle."
msgstr ""
"นำเครื่องระยะไกลออกจากทะเบียน (ชื่อ ที่อยู่ หรือ ผู้ใช้@ที่อยู่) "
"ไม่มีการแก้ไขสิ่งใดบนเครื่องนั้น"

msgid ""
"Liste les machines que cet ordinateur sait déjà joindre (profils Unison, "
"~/.ssh/config, known_hosts)."
msgstr ""
"แสดงรายการเครื่องที่คอมพิวเตอร์นี้รู้วิธีเชื่อมต่ออยู่แล้ว (โปรไฟล์ Unison, "
"~/.ssh/config, known_hosts)"

msgid ""
"Remet en place les liens de ce qui est installé : cartes d'identité, espace "
"partagé, accès des services — un seul plan."
msgstr ""
"คืนการเชื่อมโยงของสิ่งที่ติดตั้งไว้: บัตรประจำตัว พื้นที่ใช้ร่วมกัน "
"การเข้าถึงของบริการ — แผนเดียว"

msgid ""
"Une seule action (décision de l'auteur) : recrée les cartes d'identité qui "
"manquent (commande de chaque outil, sous son compte), prépare l'espace "
"partagé, y recopie les cartes et donne l'accès aux services. Tout est "
"affiché avant d'agir ; un seul mot de passe administrateur. Sans CIBLE : "
"toutes les applications de la machine."
msgstr ""
"การดำเนินการเดียว (การตัดสินใจของผู้พัฒนา): สร้างบัตรประจำตัวที่ขาดหายใหม่ "
"(คำสั่งของแต่ละเครื่องมือ ภายใต้บัญชีของตน) เตรียมพื้นที่ใช้ร่วมกัน "
"คัดลอกบัตรเข้าไป และให้สิทธิ์เข้าถึงแก่บริการ ทุกอย่างแสดงก่อนดำเนินการ "
"ใช้รหัสผ่านผู้ดูแลระบบครั้งเดียว หากไม่ระบุ CIBLE: ทุกแอปพลิเคชันของเครื่อง"

msgid ""
"Application à synchroniser : nom (omega-fire) ou dossier ; plusieurs "
"possibles."
msgstr ""
"แอปพลิเคชันที่จะซิงค์: ชื่อ (omega-fire) หรือโฟลเดอร์ ระบุได้หลายรายการ"

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; option "
"répétable) : réparer puis synchroniser, sans rien taper là-bas (une "
"application trop ancienne : mettre-a-jour d'abord)."
msgstr ""
"เครื่องระยะไกลที่สแกนแล้ว (ชื่อ ที่อยู่ หรือ ผู้ใช้@เครื่อง "
"ใช้ตัวเลือกซ้ำได้): ซ่อมแซมแล้วซิงค์ โดยไม่ต้องพิมพ์อะไรที่นั่น "
"(แอปพลิเคชันที่เก่าเกินไป: ใช้ mettre-a-jour ก่อน)"

msgid ""
"Toutes les machines distantes du registre, une à une (un mot de passe par "
"machine)."
msgstr ""
"เครื่องระยะไกลทั้งหมดในทะเบียน ทีละเครื่อง (รหัสผ่านหนึ่งครั้งต่อเครื่อง)"

msgid ""
"Met à jour les applications trop anciennes d'une machine distante, depuis "
"leur Release GitHub (rien d'autre)."
msgstr ""
"อัปเดตแอปพลิเคชันที่เก่าเกินไปของเครื่องระยะไกล จาก Release บน GitHub "
"(ไม่ทำอย่างอื่น)"

msgid ""
"Archive prise sur GitHub, empreinte vérifiée avec sha.txt, puis installée "
"sur la machine (comme la section « Mise à jour » du README de l'outil). Ne "
"répare ni ne synchronise : voir synchroniser."
msgstr ""
"ดาวน์โหลดไฟล์เก็บถาวรจาก GitHub ตรวจค่าแฮชกับ sha.txt แล้วติดตั้งบนเครื่อง "
"(เหมือนหัวข้อ «อัปเดต» ใน README ของเครื่องมือ) ไม่ซ่อมแซมและไม่ซิงค์: ดู "
"synchroniser"

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; "
"répétable)."
msgstr ""
"เครื่องระยะไกลที่สแกนแล้ว (ชื่อ ที่อยู่ หรือ ผู้ใช้@เครื่อง ใช้ซ้ำได้)"

msgid "Toutes les machines distantes du registre, une à une."
msgstr "เครื่องระยะไกลทั้งหมดในทะเบียน ทีละเครื่อง"

msgid ""
"Corrige les écarts trouvés par verifier avec la commande de l'outil qui les "
"possède (root, après accord)."
msgstr ""
"แก้ไขความคลาดเคลื่อนที่ verifier พบ ด้วยคำสั่งของเครื่องมือที่เป็นเจ้าของ "
"(root หลังได้รับความยินยอม)"

msgid ""
"Ne corrige que ce qu'un outil sait corriger lui-même (omega-jail --apply "
"--update, omega-serv service permissions, synchro jeton de chaque outil) et "
"ce que le registre de la zone dit qu'omega-connect a créé (plan d'etablir, "
"affiché à son tour). omega-connect ne réécrit jamais le fichier d'un autre "
"outil : le reste est affiché, à faire à la main. Chaque commande est "
"affichée avant d'être lancée."
msgstr ""
"แก้ไขเฉพาะสิ่งที่เครื่องมือแก้เองได้ (omega-jail --apply --update, omega-"
"serv service permissions, synchro jeton ของแต่ละเครื่องมือ) "
"และสิ่งที่ทะเบียนของโซนระบุว่า omega-connect สร้างไว้ (แผนของ etablir "
"ซึ่งจะแสดงในลำดับถัดไป) omega-connect "
"ไม่เขียนทับไฟล์ของเครื่องมืออื่นเด็ดขาด: ส่วนที่เหลือจะแสดงไว้ให้ทำด้วยตนเอง"
" แต่ละคำสั่งจะแสดงก่อนเรียกใช้"

msgid ""
"Machine distante déjà scannée : réparée depuis ici, rien à taper là-bas "
"(répétable)."
msgstr ""
"เครื่องระยะไกลที่สแกนแล้ว: ซ่อมแซมจากที่นี่ ไม่ต้องพิมพ์อะไรที่นั่น "
"(ใช้ซ้ำได้)"

msgid ""
"Rapport complet : outils, jetons, fiches, liens et tous leurs contrôles, "
"zone et registre (lecture seule)."
msgstr ""
"รายงานฉบับเต็ม: เครื่องมือ โทเค็น เอกสารข้อมูล การเชื่อมโยงและการตรวจทั้งหมด"
" โซนและทะเบียน (อ่านอย่างเดียว)"

msgid ""
"Tout ce qu'omega-connect sait à cet instant, en lecture seule et sans root :"
" outils et instances, jetons, fiches, chaque lien avec tous ses contrôles et"
" les commandes de correction, remarques de la recherche, zone neutre et son "
"registre. Affiché, ou enregistré dans var/exports/ avec --enregistrer."
msgstr ""
"ทุกสิ่งที่ omega-connect รู้ ณ ขณะนี้ แบบอ่านอย่างเดียวและไม่ต้องใช้ root: "
"เครื่องมือและอินสแตนซ์ โทเค็น เอกสารข้อมูล "
"แต่ละการเชื่อมโยงพร้อมการตรวจทั้งหมดและคำสั่งแก้ไข หมายเหตุการค้นหา "
"โซนกลางและทะเบียนของโซน แสดงผล หรือบันทึกลงใน var/exports/ ด้วย "
"--enregistrer"

msgid ""
"texte (défaut, traduit), json (jamais traduit) ou html (page autonome)."
msgstr ""
"texte (ค่าเริ่มต้น แปลแล้ว), json (ไม่แปลเด็ดขาด) หรือ html "
"(หน้าเว็บแบบสแตนด์อโลน)"

msgid "Thème de la page HTML."
msgstr "ธีมของหน้า HTML"

msgid "Enregistre dans var/exports/ au lieu d'afficher, et donne le chemin."
msgstr "บันทึกลงใน var/exports/ แทนการแสดงผล และแจ้งพาธ"

msgid "Affiche seulement les commandes, sans rien lancer."
msgstr "แสดงเฉพาะคำสั่ง โดยไม่เรียกใช้สิ่งใด"

msgid "Lance sans demander l'accord (les commandes restent affichées)."
msgstr "เรียกใช้โดยไม่ขอความยินยอม (คำสั่งยังคงแสดงอยู่)"

msgid ""
"Votre session n'a pas encore le groupe omega-synchro (il ne compte qu'après "
"une reconnexion) : lecture de la zone avec sudo (find, stat, cat)."
msgstr ""
"เซสชันของคุณยังไม่มีกลุ่ม omega-synchro "
"(มีผลหลังจากเข้าสู่ระบบใหม่เท่านั้น): อ่านโซนด้วย sudo (find, stat, cat)"

msgid "Authentification sudo refusée ou annulée : rien n'est fait."
msgstr "การยืนยันตัวตน sudo ถูกปฏิเสธหรือยกเลิก: ไม่มีการดำเนินการใด"

#, python-brace-format
msgid "Lancer ces {count} commande(s) en root ? [o/N] "
msgstr "เรียกใช้ {count} คำสั่งนี้ในฐานะ root? [o/N] "

msgid "Authentification sudo refusée ou annulée : rien n'a été lancé."
msgstr "การยืนยันตัวตน sudo ถูกปฏิเสธหรือยกเลิก: ไม่มีการเรียกใช้สิ่งใด"

msgid ""
"Pas de terminal pour poser la question : relancez avec --garder-zone ou "
"--effacer."
msgstr ""
"ไม่มีเทอร์มินัลสำหรับถามคำถาม: เรียกใหม่ด้วย --garder-zone หรือ --effacer"

msgid "Garder la zone (liens figés) [g], tout retirer [t], ou annuler [a] ? "
msgstr ""
"เก็บโซนไว้ (การเชื่อมโยงถูกตรึง) [g], นำออกทั้งหมด [t] หรือยกเลิก [a]? "

msgid ""
"Pas de terminal pour demander l'accord : relancez avec --oui, ou "
"--simulation."
msgstr ""
"ไม่มีเทอร์มินัลสำหรับขอความยินยอม: เรียกใหม่ด้วย --oui หรือ --simulation"

msgid "Abandon : rien n'a été lancé."
msgstr "ยกเลิก: ไม่มีการเรียกใช้สิ่งใด"

#, python-brace-format
msgid "Lancer ces {count} commande(s) ? [o/N] "
msgstr "เรียกใช้ {count} คำสั่งนี้? [o/N] "

msgid ""
"Zone neutre : plan d'« etablir » (seulement ce que le registre dit avoir "
"créé)."
msgstr "โซนกลาง: แผนของ «etablir» (เฉพาะสิ่งที่ทะเบียนระบุว่าสร้างไว้)"

#, python-brace-format
msgid "Registre du parc non enregistré : {error}"
msgstr "ไม่ได้บันทึกทะเบียนกลุ่มเครื่อง: {error}"

msgid "Saisissez utilisateur@machine (nom ou adresse), sans espace ni option."
msgstr "ป้อน ผู้ใช้@เครื่อง (ชื่อหรือที่อยู่) โดยไม่มีช่องว่างหรือตัวเลือก"

msgid "Pas de terminal pour demander la confiance : rien n'a été fait."
msgstr "ไม่มีเทอร์มินัลสำหรับขอการยืนยันความเชื่อถือ: ไม่มีการดำเนินการใด"

msgid "Faire confiance à cette machine ? [o/N] "
msgstr "เชื่อถือเครื่องนี้หรือไม่? [o/N] "

msgid "Rien n'a été fait."
msgstr "ไม่มีการดำเนินการใด"

msgid "Impossible d'ajouter la clé à ~/.ssh/known_hosts."
msgstr "ไม่สามารถเพิ่มคีย์ลงใน ~/.ssh/known_hosts ได้"

#, python-brace-format
msgid "Aucune application ne correspond à : {targets}"
msgstr "ไม่มีแอปพลิเคชันที่ตรงกับ: {targets}"

msgid "Lancer ce plan ? [o/N] "
msgstr "เรียกใช้แผนนี้? [o/N] "

msgid "Authentification refusée ou annulée : rien n'a été lancé."
msgstr "การยืนยันตัวตนถูกปฏิเสธหรือยกเลิก: ไม่มีการเรียกใช้สิ่งใด"

#, python-brace-format
msgid "Machine inconnue ou mal écrite : {target}"
msgstr "ไม่รู้จักเครื่องหรือเขียนผิด: {target}"

msgid ""
"Aucune machine distante dans le registre : scannez-en une d'abord (scanner "
"utilisateur@machine)."
msgstr ""
