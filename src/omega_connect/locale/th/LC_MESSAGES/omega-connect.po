#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — เครื่อง {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== กำลังอัปเดต {tool} เป็น {version} ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ ติดตั้ง {tool} {version} แล้ว"

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· ตั้งค่าไว้แล้ว: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "ปฏิเสธไฟล์เก็บถาวร: พาธที่ไม่คาดคิด {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr "ปฏิเสธไฟล์เก็บถาวร: {name} ไม่ใช่ทั้งไฟล์และโฟลเดอร์"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "ปฏิเสธไฟล์เก็บถาวร: ใหญ่เกินไปเมื่อแตกไฟล์แล้ว"

#, python-brace-format
msgid "archive refusée : pas de dossier {tool}/"
msgstr "ปฏิเสธไฟล์เก็บถาวร: ไม่มีโฟลเดอร์ {tool}/"

#, python-brace-format
msgid "{path} est un lien : rien n'est copié dedans"
msgstr "{path} เป็นลิงก์: ไม่มีการคัดลอกสิ่งใดลงไป"

#, python-brace-format
msgid "{root} n'est pas un dossier d'installation"
msgstr "{root} ไม่ใช่โฟลเดอร์การติดตั้ง"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} ไม่ได้เป็นของบัญชีนี้: ต้องอัปเดตด้วยตนเอง"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr "ค่าแฮชของไฟล์เก็บถาวรไม่ตรงกับ sha.txt: ไม่มีการติดตั้งสิ่งใด"

#, python-brace-format
msgid "Mise de côté de l'ancienne installation : {old} → {new}"
msgstr "ย้ายการติดตั้งเดิมไปเก็บไว้: {old} → {new}"

msgid "impossible de mettre l'ancienne installation de côté (sudo mv)"
msgstr "ไม่สามารถย้ายการติดตั้งเดิมไปเก็บไว้ได้ (sudo mv)"

#, python-brace-format
msgid "{count} fichiers installés dans {root}."
msgstr "ติดตั้ง {count} ไฟล์ใน {root} แล้ว"

#, python-brace-format
msgid "install.sh introuvable dans {root}"
msgstr "ไม่พบ install.sh ใน {root}"

#, python-brace-format
msgid ""
"Environnement Python (.venv) incomplet mis de côté : {path} — install.sh en "
"recrée un."
msgstr ""
"ย้ายสภาพแวดล้อม Python (.venv) ที่ไม่สมบูรณ์ไปเก็บไว้: {path} — install.sh "
"จะสร้างขึ้นใหม่"

#, python-brace-format
msgid "Lancement de {path} :"
msgstr "กำลังเรียกใช้ {path}:"

#, python-brace-format
msgid "install.sh a échoué (code {code})"
msgstr "install.sh ล้มเหลว (รหัส {code})"

#, python-brace-format
msgid "{script} introuvable : réglages et données restés dans {old}"
msgstr "ไม่พบ {script}: การตั้งค่าและข้อมูลยังอยู่ใน {old}"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"นำการตั้งค่าและข้อมูลจาก {old} กลับมาใช้ (ข้ามการติดตั้งเก่าอื่น ๆ: "
"{others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "นำข้อมูลจาก {old} กลับมาใช้ไม่สำเร็จ ({script})"

msgid "contient l'installation d'omega-connect"
msgstr "มีการติดตั้ง omega-connect อยู่"

msgid "registre omega-serv"
msgstr "ทะเบียน omega-serv"

msgid "systemd"
msgstr "systemd"

msgid "OpenRC"
msgstr "OpenRC"

msgid "runit"
msgstr "runit"

msgid "dossier personnel"
msgstr "โฟลเดอร์ส่วนตัว"

