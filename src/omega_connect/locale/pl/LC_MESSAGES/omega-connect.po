#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — maszyna {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== Aktualizacja {tool} do {version} ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ {tool} {version} zainstalowany."

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· już ustawione: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "archiwum odrzucone: nieoczekiwana ścieżka {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr "archiwum odrzucone: {name} nie jest ani plikiem, ani katalogiem"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "archiwum odrzucone: za duże po rozpakowaniu"

#, python-brace-format
msgid "archive refusée : pas de dossier {tool}/"
msgstr "archiwum odrzucone: brak katalogu {tool}/"

#, python-brace-format
msgid "{path} est un lien : rien n'est copié dedans"
msgstr "{path} jest dowiązaniem: nic nie jest do niego kopiowane"

#, python-brace-format
msgid "{root} n'est pas un dossier d'installation"
msgstr "{root} nie jest katalogiem instalacji"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} nie należy do tego konta: aktualizację trzeba wykonać ręcznie"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr ""
"suma kontrolna archiwum różni się od sha.txt: nic nie zostało zainstalowane"

#, python-brace-format
msgid "Mise de côté de l'ancienne installation : {old} → {new}"
msgstr "Odkładanie starej instalacji na bok: {old} → {new}"

msgid "impossible de mettre l'ancienne installation de côté (sudo mv)"
msgstr "nie można odłożyć starej instalacji na bok (sudo mv)"

#, python-brace-format
msgid "{count} fichiers installés dans {root}."
msgstr "Pliki zainstalowane w {root}: {count}."

#, python-brace-format
msgid "install.sh introuvable dans {root}"
msgstr "nie znaleziono install.sh w {root}"

#, python-brace-format
msgid ""
"Environnement Python (.venv) incomplet mis de côté : {path} — install.sh en "
"recrée un."
msgstr ""
"Niekompletne środowisko Python (.venv) odłożone na bok: {path} — install.sh "
"utworzy nowe."

#, python-brace-format
msgid "Lancement de {path} :"
msgstr "Uruchamianie {path}:"

#, python-brace-format
msgid "install.sh a échoué (code {code})"
msgstr "install.sh zakończył się błędem (kod {code})"

#, python-brace-format
msgid "{script} introuvable : réglages et données restés dans {old}"
msgstr "nie znaleziono {script}: ustawienia i dane pozostały w {old}"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"Przejmowanie ustawień i danych z {old} (pozostałe stare instalacje "
"pominięte: {others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "przejęcie z {old} nie powiodło się ({script})"

msgid "contient l'installation d'omega-connect"
msgstr "zawiera instalację omega-connect"

msgid "registre omega-serv"
msgstr "rejestr omega-serv"

msgid "systemd"
msgstr "systemd"

msgid "OpenRC"
msgstr "OpenRC"

msgid "runit"
msgstr "runit"

msgid "dossier personnel"
msgstr "katalog domowy"

msgid "/srv"
msgstr "/srv"

msgid "chemin saisi"
msgstr "podana ścieżka"

msgid "absent"
msgstr "brak"

msgid "illisible (droits)"
msgstr "nieczytelny (uprawnienia)"

msgid "abîmé"
msgstr "uszkodzony"

msgid "d'une version plus récente qu'omega-connect"
msgstr "z nowszej wersji niż omega-connect"

msgid "non fournie (version de l'outil trop ancienne ?)"
msgstr "nie dostarczono (zbyt stara wersja narzędzia?)"

msgid "non obtenue"
msgstr "nie uzyskano"

msgid "illisible"
msgstr "nieczytelny"

msgid "active"
msgstr "aktywne"

msgid "désactivée"
msgstr "wyłączona"

msgid "absente"
msgstr "brak"

msgid "inconnue"
msgstr "nieznany"

#, python-brace-format
msgid "registre des instances omega-serv illisible : {detail}"
msgstr "rejestr instancji omega-serv nieczytelny: {detail}"

#, python-brace-format
msgid "instance omega-serv enregistrée mais dossier disparu : {detail}"
msgstr ""
"instancja omega-serv zarejestrowana, ale jej katalog zniknął: {detail}"

#, python-brace-format
msgid "fichier de service illisible : {detail}"
msgstr "plik usługi nieczytelny: {detail}"

#, python-brace-format
msgid "service {detail} : dossier d'installation introuvable"
msgstr "usługa {detail}: nie znaleziono katalogu instalacji"

#, python-brace-format
msgid "recherche arrêtée (trop de dossiers) dans {detail}"
msgstr "wyszukiwanie przerwane (za dużo katalogów) w {detail}"

#, python-brace-format
msgid "montage réseau non parcouru : {detail}"
msgstr "pominięto montowanie sieciowe: {detail}"

#, python-brace-format
msgid "dossier introuvable : {detail}"
msgstr "nie znaleziono katalogu: {detail}"

#, python-brace-format
msgid "aucun outil omega dans : {detail}"
msgstr "brak narzędzi omega w: {detail}"

#, python-brace-format
msgid "créez-le sous le compte {owner} : {command}"
msgstr "utwórz go na koncie {owner}: {command}"

msgid "outil inconnu"
msgstr "nieznane narzędzie"

#, python-brace-format
msgid "trouvé par : {sources}"
msgstr "znalezione przez: {sources}"

#, python-brace-format
msgid "propriétaire : {owner}"
msgstr "właściciel: {owner}"

#, python-brace-format
msgid "service : {names}"
msgstr "usługa: {names}"

#, python-brace-format
msgid "jeton : présent (identifiant {identifier}, version {version})"
msgstr "token: obecny (identyfikator {identifier}, wersja {version})"

#, python-brace-format
msgid "jeton : {state}"
msgstr "token: {state}"

#, python-brace-format
msgid "fiche : {state}"
msgstr "opis: {state}"

#, python-brace-format
msgid "détail technique : {detail}"
msgstr "szczegóły techniczne: {detail}"

#, python-brace-format
msgid "fiche : instance {instance}"
msgstr "opis: instancja {instance}"

#, python-brace-format
msgid "service {manager} ({state})"
msgstr "usługa {manager} ({state})"

msgid "partielle (sans root)"
msgstr "częściowa (bez root)"

#, python-brace-format
msgid "fonctions : {states}"
msgstr "funkcje: {states}"

#, python-brace-format
msgid "Détection des outils omega (HOME examiné : {home})"
msgstr "Wykrywanie narzędzi omega (sprawdzany HOME: {home})"

msgid "Aucun outil omega trouvé. Indiquez un dossier avec --chemin."
msgstr ""
"Nie znaleziono żadnego narzędzia omega. Wskaż katalog za pomocą --chemin."

#, python-brace-format
msgid ""
"Identifiant en double {identifier} : {roots} (dossier copié à la main ?). "
"Ces installations ne sont pas fusionnées ; ouvrez la copie une fois pour lui"
" donner un nouvel identifiant."
msgstr ""
"Zduplikowany identyfikator {identifier}: {roots} (katalog skopiowany "
"ręcznie?). Te instalacje nie są scalane; uruchom kopię raz, aby nadać jej "
"nowy identyfikator."

msgid "Remarques sur la recherche :"
msgstr "Uwagi dotyczące wyszukiwania:"

#, python-brace-format
msgid "{count} installation(s) trouvée(s)."
msgstr "Znalezione instalacje: {count}."

msgid "Détectée"
msgstr "Wykryta"

msgid "Inscrite"
msgstr "Zarejestrowana"

msgid "Reliée"
msgstr "Połączona"

msgid "À réparer"
msgstr "Do naprawy"

msgid "Ancienne version"
msgstr "Stara wersja"

msgid "Installation inachevée"
msgstr "Niedokończona instalacja"

msgid "Injoignable"
msgstr "Nieosiągalna"

msgid "trouvée, sans carte d'identité : la Synchronisation la lui crée"
msgstr "znaleziona, bez karty identyfikacyjnej: Synchronizacja ją utworzy"

msgid ""
"a sa carte d'identité, pas encore dans l'espace partagé : la Synchronisation"
" l'y ajoute"
msgstr ""
"ma kartę identyfikacyjną, ale jeszcze nie jest w przestrzeni współdzielonej:"
" Synchronizacja ją tam doda"

msgid "dans l'espace partagé, à jour"
msgstr "w przestrzeni współdzielonej, aktualna"

msgid "un écart : Réparer le corrige"
msgstr "niezgodność: naprawia ją menu Napraw"

msgid "trop ancienne pour avoir une carte d'identité : mettez-la à jour"
msgstr "zbyt stara, by mieć kartę identyfikacyjną: zaktualizuj ją"

msgid ""
"installée, mais son install.sh ne s'est pas terminé (environnement Python ou"
" carte d'identité manquants) : « Réinstaller l'application » (Registre)"
msgstr ""
"zainstalowana, ale jej install.sh nie zakończył się (brak środowiska Python "
"lub karty identyfikacyjnej): „Zainstaluj aplikację ponownie” (Rejestr)"

msgid "machine qui ne répond pas"
msgstr "maszyna nie odpowiada"

#, python-brace-format
msgid ""
"trop ancienne pour avoir une carte d'identité : {tool} {version} ou plus "
"récent requis (machine distante : Synchronisation la met à jour depuis "
"GitHub)"
msgstr ""
"zbyt stara, by mieć kartę identyfikacyjną: wymagany {tool} {version} lub "
"nowszy (maszyna zdalna: Synchronizacja aktualizuje ją z GitHub)"

msgid "pas encore préparé — la Synchronisation le prépare"
msgstr "jeszcze nieprzygotowana — Synchronizacja ją przygotuje"

msgid "prêt"
msgstr "gotowa"

msgid "à corriger — la Synchronisation le remet en état"
msgstr "do poprawy — Synchronizacja przywróci ją do porządku"

msgid "prêt (lu avec votre autorisation)"
msgstr "gotowa (odczytana za Twoją zgodą)"

msgid ""
"état inconnu depuis cette session — la Synchronisation le lira avec votre "
"autorisation"
msgstr "stan nieznany w tej sesji — Synchronizacja odczyta go za Twoją zgodą"

#, python-brace-format
msgid "Registre — machine {machine}"
msgstr "Rejestr — maszyna {machine}"

msgid "Aucune application omega trouvée sur cette machine."
msgstr "Na tej maszynie nie znaleziono żadnej aplikacji omega."

#, python-brace-format
msgid "Espace partagé : {status}"
msgstr "Przestrzeń współdzielona: {status}"

msgid "Synchroniser : un seul plan, un seul mot de passe administrateur"
msgstr "Synchronizuj: jeden plan, jedno hasło administratora"

msgid "Rien à faire : tout est déjà synchronisé."
msgstr "Nic do zrobienia: wszystko jest już zsynchronizowane."

msgid ""
"1. Cartes d'identité à créer (par chaque outil, sous son compte, sans mot de"
" passe) :"
msgstr ""
"1. Karty identyfikacyjne do utworzenia (przez każde narzędzie, na jego "
"koncie, bez hasła):"

msgid "aucune : chaque application choisie a déjà la sienne."
msgstr "brak: każda wybrana aplikacja ma już swoją."

msgid "2. Espace partagé (en administrateur, une commande après l'autre) :"
msgstr ""
"2. Przestrzeń współdzielona (jako administrator, polecenie po poleceniu):"

#, python-brace-format
msgid "Recopier la carte d'identité de {root} (créée à l'étape 1)"
msgstr "Skopiuj kartę identyfikacyjną {root} (utworzoną w kroku 1)"

msgid "rien : l'espace partagé est déjà à jour."
msgstr "nic: przestrzeń współdzielona jest już aktualna."

msgid "Une commande qui n'est pas annoncée ici n'est jamais lancée."
msgstr ""
"Polecenie, które nie jest tu zapowiedziane, nigdy nie zostanie uruchomione."

#, python-brace-format
msgid ""
"Arrêt : la carte d'identité de {root} n'a pas pu être créée ({error}). Rien "
"d'autre n'a été lancé."
msgstr ""
"Zatrzymano: nie udało się utworzyć karty identyfikacyjnej {root} ({error}). "
"Nic więcej nie zostało uruchomione."

msgid "échec"
msgstr "niepowodzenie"

#, python-brace-format
msgid ""
"Arrêt avant l'espace partagé : le plan a changé ({step}). Rien de plus n'a "
"été lancé ; relancez la synchronisation pour voir le nouveau plan."
msgstr ""
"Zatrzymano przed przestrzenią współdzieloną: plan się zmienił ({step}). Nic "
"więcej nie zostało uruchomione; uruchom synchronizację ponownie, aby "
"zobaczyć nowy plan."

#, python-brace-format
msgid ""
"Arrêt à l'étape « {step} » : {error}. Ce qui a été créé est noté ; relancez "
"la synchronisation après avoir corrigé la cause."
msgstr ""
"Zatrzymano na kroku „{step}”: {error}. To, co zostało utworzone, jest "
"zapisane; uruchom synchronizację ponownie po usunięciu przyczyny."

msgid "Synchronisation terminée : les applications choisies sont reliées."
msgstr "Synchronizacja zakończona: wybrane aplikacje są połączone."

msgid "DÉMARRAGE RAPIDE"
msgstr "SZYBKI START"

msgid "RACCOURCIS"
msgstr "SKRÓTY"

msgid "Aide d’omega-connect"
msgstr "Pomoc omega-connect"

msgid "Aide complète : chaque menu, sa fonction et le détail."
msgstr "Pełna pomoc: każde menu, jego funkcja i szczegóły."

msgid "Démarrage rapide"
msgstr "Szybki start"

msgid "Raccourcis"
msgstr "Skróty"

msgid "Touche"
msgstr "Klawisz"

msgid "Action"
msgstr "Akcja"

#, python-brace-format
msgid "OMEGA-CONNECT {version} — aide."
msgstr "OMEGA-CONNECT {version} — pomoc."

msgid "Aide - Omega-Connect"
msgstr "Pomoc - Omega-Connect"

msgid ""
"Interconnecteur de la suite omega : détecte les outils installés, vérifie et"
" attribue les droits entre eux."
msgstr ""
"Łącznik pakietu omega: wykrywa zainstalowane narzędzia, sprawdza i nadaje "
"uprawnienia między nimi."

msgid "commandes"
msgstr "polecenia"

msgid "COMMANDE"
msgstr "POLECENIE"

msgid "Cherche les outils omega installés (lecture seule, sans root)."
msgstr "Wyszukuje zainstalowane narzędzia omega (tylko odczyt, bez root)."

msgid ""
"Cherche les outils omega installés : registre d'omega-serv, services systemd"
" / OpenRC / runit, HOME (3 niveaux), /srv (2 niveaux) et chemins saisis. Ne "
"suit jamais un lien symbolique ni un montage réseau. Lit le jeton de chaque "
"installation et demande sa fiche à l'outil, sous le compte propriétaire du "
"dossier."
msgstr ""
"Wyszukuje zainstalowane narzędzia omega: rejestr omega-serv, usługi systemd "
"/ OpenRC / runit, HOME (3 poziomy), /srv (2 poziomy) i podane ścieżki. Nigdy"
" nie podąża za dowiązaniem symbolicznym ani montowaniem sieciowym. Odczytuje"
" token każdej instalacji i prosi narzędzie o jego opis, na koncie "
"właściciela katalogu."

msgid "DOSSIER"
msgstr "KATALOG"

msgid "Dossier d'installation à examiner en plus (option répétable)."
msgstr "Dodatkowy katalog instalacji do sprawdzenia (opcję można powtarzać)."

msgid ""
"Ne demande pas la fiche aux outils (plus rapide, aucune commande lancée)."
msgstr ""
"Nie prosi narzędzi o opis (szybciej, żadne polecenie nie jest uruchamiane)."

msgid "texte (défaut, traduit) ou json (pour les scripts, jamais traduit)."
msgstr ""
"texte (domyślnie, tłumaczony) lub json (dla skryptów, nigdy nietłumaczony)."

msgid "Vérifie les liens existants entre outils (lecture seule, sans root)."
msgstr ""
"Sprawdza istniejące powiązania między narzędziami (tylko odczyt, bez root)."

msgid ""
"Détecte les outils (avec leur fiche), puis contrôle chaque lien : journaux "
"d'omega-serv et de magnet lus par les jails d'omega-jail, pont fail2ban vers"
" la liste noire, liste protégée, droits de la liste noire, fichiers d'omega-"
"jail dans fail2ban, jetons. Chaque écart affiche la commande qui le "
"corrigerait, sans jamais la lancer. Code de sortie : 0 sans écart, 1 si un "
"lien est cassé ou dégradé."
msgstr ""
"Wykrywa narzędzia (wraz z ich opisem), a następnie kontroluje każde "
"powiązanie: logi omega-serv i magnet czytane przez jaile omega-jail, most "
"fail2ban do czarnej listy, lista chroniona, uprawnienia czarnej listy, pliki"
" omega-jail w fail2ban, tokeny. Przy każdej niezgodności pokazuje polecenie,"
" które by ją naprawiło, nigdy go nie uruchamiając. Kod wyjścia: 0 bez "
"niezgodności, 1 jeśli powiązanie jest zerwane lub osłabione."

msgid "Affiche aussi les contrôles conformes."
msgstr "Pokazuje również zgodne kontrole."

msgid ""
"Ouvre le tableau de bord (défaut sans commande) : outils, liens et leur "
"état, en lecture seule."
msgstr ""
"Otwiera pulpit (domyślnie, gdy nie podano polecenia): narzędzia, powiązania "
"i ich stan, tylko do odczytu."

msgid ""
"Tableau de bord en lecture seule : outils et instances, état de chaque lien,"
" contrôles et commandes de correction (jamais lancées). Nouvelle "
"vérification à intervalle régulier tant que l'écran est ouvert."
msgstr ""
"Pulpit tylko do odczytu: narzędzia i instancje, stan każdego powiązania, "
"kontrole i polecenia naprawcze (nigdy nieuruchamiane). Ponowne sprawdzanie w"
" regularnych odstępach, dopóki ekran jest otwarty."

msgid ""
"Crée la zone neutre et y recopie jetons et fiches (root, après accord)."
msgstr ""
"Tworzy strefę neutralną i kopiuje do niej tokeny i opisy (root, po zgodzie)."

msgid ""
"Crée le groupe omega-synchro et la zone neutre (/var/lib/omega-synchro, "
"2750), vous ajoute au groupe, recopie le jeton et la fiche de chaque outil "
"détecté, et inscrit tout au registre. Relancée, elle actualise les copies. "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"Tworzy grupę omega-synchro i strefę neutralną (/var/lib/omega-synchro, "
"2750), dodaje Cię do grupy, kopiuje token i opis każdego wykrytego narzędzia"
" i wpisuje wszystko do rejestru. Uruchomiona ponownie, odświeża kopie. Każde"
" polecenie jest wyświetlane przed uruchomieniem przez sudo."

msgid ""
"Défait ce qu'omega-connect a créé : un outil désinstallé, ou toute la zone "
"(root, après accord)."
msgstr ""
"Cofa to, co utworzył omega-connect: odinstalowane narzędzie lub całą strefę "
"(root, po zgodzie)."

msgid ""
"« retirer CIBLE » enlève de la zone un outil désinstallé (nom, dossier ou 8 "
"premiers caractères de l'identifiant). « retirer --tout » défait exactement "
"ce que le registre liste, ou garde la zone telle quelle (liens figés). "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"„retirer CEL” usuwa ze strefy odinstalowane narzędzie (nazwa, katalog lub 8 "
"pierwszych znaków identyfikatora). „retirer --tout” cofa dokładnie to, co "
"wymienia rejestr, albo zachowuje strefę bez zmian (powiązania zamrożone). "
"Każde polecenie jest wyświetlane przed uruchomieniem przez sudo."

msgid "CIBLE"
msgstr "CEL"

msgid "Outil à retirer de la zone."
msgstr "Narzędzie do usunięcia ze strefy."

msgid "Toute la zone (question : garder ou tout retirer)."
msgstr "Cała strefa (pytanie: zachować czy usunąć wszystko)."

msgid "Avec --tout : garder la zone, liens figés (rien n'est supprimé)."
msgstr ""
"Z --tout: zachowaj strefę, powiązania zamrożone (nic nie jest usuwane)."

msgid "Avec --tout : tout retirer, sans question."
msgstr "Z --tout: usuń wszystko, bez pytania."

msgid ""
"Recherche les applications omega de cette machine et met à jour le registre "
"(lecture seule)."
msgstr ""
"Wyszukuje aplikacje omega na tej maszynie i aktualizuje rejestr (tylko "
"odczyt)."

msgid ""
"Lecture seule, sans mot de passe : chaque application trouvée, son service "
"et son état (Détectée, Inscrite, Reliée, À réparer, Ancienne version, "
"Installation inachevée). Le résultat est enregistré dans le registre du parc"
" (var/parc.json)."
msgstr ""
"Tylko odczyt, bez hasła: każda znaleziona aplikacja, jej usługa i stan "
"(Wykryta, Zarejestrowana, Połączona, Do naprawy, Stara wersja, Niedokończona"
" instalacja). Wynik zapisuje się w rejestrze maszyn (var/parc.json)."

msgid "UTILISATEUR@MACHINE"
msgstr "UŻYTKOWNIK@MASZYNA"

msgid ""
"Machine distante à scanner par SSH avec vos clés (rien n'y est installé) ; "
"sans cible : cette machine."
msgstr ""
"Maszyna zdalna do przeskanowania przez SSH Twoimi kluczami (nic nie jest na "
"niej instalowane); bez celu: ta maszyna."

msgid "MACHINE"
msgstr "MACHINE"

msgid ""
"Retire une machine distante du registre (nom, adresse ou "
"utilisateur@adresse) ; rien n'est modifié sur elle."
msgstr ""
"Usuwa maszynę zdalną z rejestru (nazwa, adres lub użytkownik@adres); nic nie"
" jest na niej zmieniane."

msgid ""
"Liste les machines que cet ordinateur sait déjà joindre (profils Unison, "
"~/.ssh/config, known_hosts)."
msgstr ""
"Wyświetla maszyny, z którymi ten komputer już umie się połączyć (profile "
"Unison, ~/.ssh/config, known_hosts)."

msgid ""
"Remet en place les liens de ce qui est installé : cartes d'identité, espace "
"partagé, accès des services — un seul plan."
msgstr ""
"Przywraca powiązania tego, co jest zainstalowane: karty identyfikacyjne, "
"przestrzeń współdzielona, dostęp usług — jeden plan."

msgid ""
"Une seule action (décision de l'auteur) : recrée les cartes d'identité qui "
"manquent (commande de chaque outil, sous son compte), prépare l'espace "
"partagé, y recopie les cartes et donne l'accès aux services. Tout est "
"affiché avant d'agir ; un seul mot de passe administrateur. Sans CIBLE : "
"toutes les applications de la machine."
msgstr ""
"Jedna akcja (decyzja autora): odtwarza brakujące karty identyfikacyjne "
"(polecenie każdego narzędzia, na jego koncie), przygotowuje przestrzeń "
"współdzieloną, kopiuje do niej karty i daje dostęp usługom. Wszystko jest "
"wyświetlane przed działaniem; jedno hasło administratora. Bez argumentu CEL:"
" wszystkie aplikacje maszyny."

msgid ""
"Application à synchroniser : nom (omega-fire) ou dossier ; plusieurs "
"possibles."
msgstr ""
"Aplikacja do synchronizacji: nazwa (omega-fire) lub katalog; można podać "
"kilka."

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; option "
"répétable) : réparer puis synchroniser, sans rien taper là-bas (une "
"application trop ancienne : mettre-a-jour d'abord)."
msgstr ""
"Maszyna zdalna już przeskanowana (nazwa, adres lub użytkownik@maszyna; opcję"
" można powtarzać): naprawa, a potem synchronizacja, bez wpisywania "
"czegokolwiek na niej (zbyt stara aplikacja: najpierw mettre-a-jour)."

msgid ""
"Toutes les machines distantes du registre, une à une (un mot de passe par "
"machine)."
msgstr ""
"Wszystkie maszyny zdalne z rejestru, jedna po drugiej (jedno hasło na "
"maszynę)."

msgid ""
"Met à jour les applications trop anciennes d'une machine distante, depuis "
"leur Release GitHub (rien d'autre)."
msgstr ""
"Aktualizuje zbyt stare aplikacje maszyny zdalnej z ich Release na GitHub "
"(nic poza tym)."

msgid ""
"Archive prise sur GitHub, empreinte vérifiée avec sha.txt, puis installée "
"sur la machine (comme la section « Mise à jour » du README de l'outil). Ne "
"répare ni ne synchronise : voir synchroniser."
msgstr ""
"Archiwum pobierane z GitHub, suma kontrolna sprawdzana z sha.txt, a "
"następnie instalowane na maszynie (jak w sekcji „Aktualizacja” README "
"narzędzia). Nie naprawia ani nie synchronizuje: zobacz synchroniser."

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; "
"répétable)."
msgstr ""
"Maszyna zdalna już przeskanowana (nazwa, adres lub użytkownik@maszyna; można"
" powtarzać)."

msgid "Toutes les machines distantes du registre, une à une."
msgstr "Wszystkie maszyny zdalne z rejestru, jedna po drugiej."

msgid ""
"Corrige les écarts trouvés par verifier avec la commande de l'outil qui les "
"possède (root, après accord)."
msgstr ""
"Naprawia niezgodności wykryte przez verifier poleceniem narzędzia, do "
"którego należą (root, po zgodzie)."

msgid ""
"Ne corrige que ce qu'un outil sait corriger lui-même (omega-jail --apply "
"--update, omega-serv service permissions, synchro jeton de chaque outil) et "
"ce que le registre de la zone dit qu'omega-connect a créé (plan d'etablir, "
"affiché à son tour). omega-connect ne réécrit jamais le fichier d'un autre "
"outil : le reste est affiché, à faire à la main. Chaque commande est "
"affichée avant d'être lancée."
msgstr ""
"Naprawia tylko to, co narzędzie umie naprawić samo (omega-jail --apply "
"--update, omega-serv service permissions, synchro jeton każdego narzędzia) "
"oraz to, co według rejestru strefy utworzył omega-connect (plan etablir, "
"wyświetlany osobno). omega-connect nigdy nie nadpisuje pliku innego "
"narzędzia: reszta jest wyświetlana, do wykonania ręcznie. Każde polecenie "
"jest wyświetlane przed uruchomieniem."

msgid ""
"Machine distante déjà scannée : réparée depuis ici, rien à taper là-bas "
"(répétable)."
msgstr ""
"Maszyna zdalna już przeskanowana: naprawiana stąd, nic do wpisywania na niej"
" (można powtarzać)."

msgid ""
"Rapport complet : outils, jetons, fiches, liens et tous leurs contrôles, "
"zone et registre (lecture seule)."
msgstr ""
"Pełny raport: narzędzia, tokeny, opisy, powiązania i wszystkie ich kontrole,"
" strefa i rejestr (tylko odczyt)."

msgid ""
"Tout ce qu'omega-connect sait à cet instant, en lecture seule et sans root :"
" outils et instances, jetons, fiches, chaque lien avec tous ses contrôles et"
" les commandes de correction, remarques de la recherche, zone neutre et son "
"registre. Affiché, ou enregistré dans var/exports/ avec --enregistrer."
msgstr ""
"Wszystko, co omega-connect wie w tej chwili, tylko do odczytu i bez root: "
"narzędzia i instancje, tokeny, opisy, każde powiązanie ze wszystkimi "
"kontrolami i poleceniami naprawczymi, uwagi z wyszukiwania, strefa neutralna"
" i jej rejestr. Wyświetlane lub zapisywane w var/exports/ z --enregistrer."

msgid ""
"texte (défaut, traduit), json (jamais traduit) ou html (page autonome)."
msgstr ""
"texte (domyślnie, tłumaczony), json (nigdy nietłumaczony) lub html "
"(samodzielna strona)."

msgid "Thème de la page HTML."
msgstr "Motyw strony HTML."

msgid "Enregistre dans var/exports/ au lieu d'afficher, et donne le chemin."
msgstr "Zapisuje w var/exports/ zamiast wyświetlać i podaje ścieżkę."

msgid "Affiche seulement les commandes, sans rien lancer."
msgstr "Pokazuje tylko polecenia, niczego nie uruchamiając."

msgid "Lance sans demander l'accord (les commandes restent affichées)."
msgstr "Uruchamia bez pytania o zgodę (polecenia są nadal wyświetlane)."

msgid ""
"Votre session n'a pas encore le groupe omega-synchro (il ne compte qu'après "
"une reconnexion) : lecture de la zone avec sudo (find, stat, cat)."
msgstr ""
"Twoja sesja nie ma jeszcze grupy omega-synchro (działa ona dopiero po "
"ponownym zalogowaniu): odczyt strefy przez sudo (find, stat, cat)."

msgid "Authentification sudo refusée ou annulée : rien n'est fait."
msgstr ""
"Uwierzytelnianie sudo odrzucone lub anulowane: nic nie zostało zrobione."

