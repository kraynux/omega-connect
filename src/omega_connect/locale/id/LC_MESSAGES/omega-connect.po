msgstr "{path} adalah tautan simbolik: tidak ada yang disalin ke dalamnya"

#, python-brace-format
msgid "{root} n'est pas un dossier d'installation"
msgstr "{root} bukan folder instalasi"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} bukan milik akun ini: pembaruan dilakukan secara manual"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr "sidik jari arsip berbeda dari sha.txt: tidak ada yang dipasang"

