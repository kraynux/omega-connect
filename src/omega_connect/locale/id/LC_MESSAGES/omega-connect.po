msgstr "install.sh tidak ditemukan di {root}"

#, python-brace-format
msgid ""
"Environnement Python (.venv) incomplet mis de côté : {path} — install.sh en "
"recrée un."
msgstr ""
"Lingkungan Python (.venv) yang tidak lengkap disisihkan: {path} — install.sh"
" akan membuat yang baru."

#, python-brace-format
msgid "Lancement de {path} :"
msgstr "Menjalankan {path}:"

#, python-brace-format
msgid "install.sh a échoué (code {code})"
msgstr "install.sh gagal (kode {code})"

#, python-brace-format
msgid "{script} introuvable : réglages et données restés dans {old}"
msgstr "{script} tidak ditemukan: pengaturan dan data tetap di {old}"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"Mengambil alih pengaturan dan data dari {old} (instalasi lama lainnya "
"diabaikan: {others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "pengambilalihan dari {old} gagal ({script})"

