#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — mesin {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== Memperbarui {tool} ke {version} ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ {tool} {version} terpasang."

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· sudah diatur: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "arsip ditolak: jalur tak terduga {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr "arsip ditolak: {name} bukan berkas maupun folder"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "arsip ditolak: terlalu besar setelah diekstrak"

#, python-brace-format
msgid "archive refusée : pas de dossier {tool}/"
msgstr "arsip ditolak: tidak ada folder {tool}/"

