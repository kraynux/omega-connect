#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — машина {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== Обновление {tool} до {version} ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ {tool} {version} установлен."

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· уже настроено: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "архив отклонён: неожиданный путь {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr "архив отклонён: {name} не является ни файлом, ни папкой"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "архив отклонён: слишком большой после распаковки"

#, python-brace-format
msgid "archive refusée : pas de dossier {tool}/"
msgstr "архив отклонён: нет папки {tool}/"

#, python-brace-format
msgid "{path} est un lien : rien n'est copié dedans"
msgstr "{path} — это ссылка: в неё ничего не копируется"

#, python-brace-format
msgid "{root} n'est pas un dossier d'installation"
msgstr "{root} не является папкой установки"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} не принадлежит этой учётной записи: обновите вручную"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr ""
"контрольная сумма архива не совпадает с sha.txt: ничего не установлено"

#, python-brace-format
msgid "Mise de côté de l'ancienne installation : {old} → {new}"
msgstr "Старая установка отложена: {old} → {new}"

msgid "impossible de mettre l'ancienne installation de côté (sudo mv)"
msgstr "не удалось отложить старую установку (sudo mv)"

#, python-brace-format
msgid "{count} fichiers installés dans {root}."
msgstr "Установлено файлов в {root}: {count}."

#, python-brace-format
msgid "install.sh introuvable dans {root}"
msgstr "install.sh не найден в {root}"

#, python-brace-format
msgid ""
"Environnement Python (.venv) incomplet mis de côté : {path} — install.sh en "
"recrée un."
msgstr ""
"Неполное окружение Python (.venv) отложено: {path} — install.sh создаст "
"новое."

#, python-brace-format
msgid "Lancement de {path} :"
msgstr "Запуск {path}:"

#, python-brace-format
msgid "install.sh a échoué (code {code})"
msgstr "install.sh завершился с ошибкой (код {code})"

#, python-brace-format
msgid "{script} introuvable : réglages et données restés dans {old}"
msgstr "{script} не найден: настройки и данные остались в {old}"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"Перенос настроек и данных из {old} (другие старые установки пропущены: "
"{others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "перенос из {old} не удался ({script})"

msgid "contient l'installation d'omega-connect"
msgstr "содержит установку omega-connect"

msgid "registre omega-serv"
msgstr "реестр omega-serv"

msgid "systemd"
msgstr "systemd"

msgid "OpenRC"
msgstr "OpenRC"

msgid "runit"
msgstr "runit"

msgid "dossier personnel"
msgstr "домашняя папка"

msgid "/srv"
msgstr "/srv"

msgid "chemin saisi"
msgstr "указанный путь"

msgid "absent"
msgstr "отсутствует"

msgid "illisible (droits)"
msgstr "нечитаемо (права)"

msgid "abîmé"
msgstr "повреждено"

msgid "d'une version plus récente qu'omega-connect"
msgstr "из более новой версии, чем omega-connect"

msgid "non fournie (version de l'outil trop ancienne ?)"
msgstr "не предоставлено (слишком старая версия инструмента?)"

msgid "non obtenue"
msgstr "не получено"

msgid "illisible"
msgstr "нечитаемо"

msgid "active"
msgstr "активно"

msgid "désactivée"
msgstr "отключён"

msgid "absente"
msgstr "отсутствует"

msgid "inconnue"
msgstr "неизвестно"

#, python-brace-format
msgid "registre des instances omega-serv illisible : {detail}"
msgstr "реестр экземпляров omega-serv нечитаем: {detail}"

#, python-brace-format
msgid "instance omega-serv enregistrée mais dossier disparu : {detail}"
msgstr "экземпляр omega-serv зарегистрирован, но папка исчезла: {detail}"

#, python-brace-format
msgid "fichier de service illisible : {detail}"
msgstr "файл службы нечитаем: {detail}"

#, python-brace-format
msgid "service {detail} : dossier d'installation introuvable"
msgstr "служба {detail}: папка установки не найдена"

#, python-brace-format
msgid "recherche arrêtée (trop de dossiers) dans {detail}"
msgstr "поиск остановлен (слишком много папок) в {detail}"

#, python-brace-format
msgid "montage réseau non parcouru : {detail}"
msgstr "сетевое подключение не просматривалось: {detail}"

#, python-brace-format
msgid "dossier introuvable : {detail}"
msgstr "папка не найдена: {detail}"

#, python-brace-format
msgid "aucun outil omega dans : {detail}"
msgstr "нет инструментов omega в: {detail}"

#, python-brace-format
msgid "créez-le sous le compte {owner} : {command}"
msgstr "создайте его под учётной записью {owner}: {command}"

msgid "outil inconnu"
msgstr "неизвестный инструмент"

#, python-brace-format
msgid "trouvé par : {sources}"
msgstr "найдено через: {sources}"

#, python-brace-format
msgid "propriétaire : {owner}"
msgstr "владелец: {owner}"

#, python-brace-format
msgid "service : {names}"
msgstr "служба: {names}"

#, python-brace-format
msgid "jeton : présent (identifiant {identifier}, version {version})"
msgstr "токен: есть (идентификатор {identifier}, версия {version})"

#, python-brace-format
msgid "jeton : {state}"
msgstr "токен: {state}"

#, python-brace-format
msgid "fiche : {state}"
msgstr "описание: {state}"

#, python-brace-format
msgid "détail technique : {detail}"
msgstr "технические подробности: {detail}"

#, python-brace-format
msgid "fiche : instance {instance}"
msgstr "описание: экземпляр {instance}"

#, python-brace-format
msgid "service {manager} ({state})"
msgstr "служба {manager} ({state})"

msgid "partielle (sans root)"
msgstr "частично (без root)"

#, python-brace-format
msgid "fonctions : {states}"
msgstr "функции: {states}"

#, python-brace-format
msgid "Détection des outils omega (HOME examiné : {home})"
msgstr "Обнаружение инструментов omega (проверенный HOME: {home})"

msgid "Aucun outil omega trouvé. Indiquez un dossier avec --chemin."
msgstr "Инструменты omega не найдены. Укажите папку с помощью --chemin."

#, python-brace-format
msgid ""
"Identifiant en double {identifier} : {roots} (dossier copié à la main ?). "
"Ces installations ne sont pas fusionnées ; ouvrez la copie une fois pour lui"
" donner un nouvel identifiant."
msgstr ""
"Повторяющийся идентификатор {identifier}: {roots} (папка скопирована "
"вручную?). Эти установки не объединяются; откройте копию один раз, чтобы она"
" получила новый идентификатор."

msgid "Remarques sur la recherche :"
msgstr "Замечания о поиске:"

#, python-brace-format
msgid "{count} installation(s) trouvée(s)."
msgstr "Найдено установок: {count}."

msgid "Détectée"
msgstr "Обнаружено"

msgid "Inscrite"
msgstr "Зарегистрировано"

msgid "Reliée"
msgstr "Связано"

msgid "À réparer"
msgstr "Требует исправления"

msgid "Ancienne version"
msgstr "Старая версия"

msgid "Installation inachevée"
msgstr "Незавершённая установка"

msgid "Injoignable"
msgstr "Недоступно"

msgid "trouvée, sans carte d'identité : la Synchronisation la lui crée"
msgstr "найдено, без паспорта: Синхронизация создаст его"

msgid ""
"a sa carte d'identité, pas encore dans l'espace partagé : la Synchronisation"
" l'y ajoute"
msgstr ""
"есть паспорт, но ещё нет в общем пространстве: Синхронизация добавит его "
"туда"

msgid "dans l'espace partagé, à jour"
msgstr "в общем пространстве, актуально"

msgid "un écart : Réparer le corrige"
msgstr "есть расхождение: Исправление его устранит"

msgid "trop ancienne pour avoir une carte d'identité : mettez-la à jour"
msgstr "слишком старое, чтобы иметь паспорт: обновите его"

msgid ""
"installée, mais son install.sh ne s'est pas terminé (environnement Python ou"
" carte d'identité manquants) : « Réinstaller l'application » (Registre)"
msgstr ""
"установлено, но его install.sh не завершился (нет окружения Python или "
"паспорта): «Переустановить приложение» (Реестр)"

msgid "machine qui ne répond pas"
msgstr "машина не отвечает"

#, python-brace-format
msgid ""
"trop ancienne pour avoir une carte d'identité : {tool} {version} ou plus "
"récent requis (machine distante : Synchronisation la met à jour depuis "
"GitHub)"
msgstr ""
"слишком старое, чтобы иметь паспорт: требуется {tool} {version} или новее "
"(удалённая машина: Синхронизация обновит его с GitHub)"

msgid "pas encore préparé — la Synchronisation le prépare"
msgstr "ещё не подготовлено — Синхронизация подготовит его"

msgid "prêt"
msgstr "готово"

msgid "à corriger — la Synchronisation le remet en état"
msgstr "требует исправления — Синхронизация приведёт его в порядок"

msgid "prêt (lu avec votre autorisation)"
msgstr "готово (прочитано с вашего разрешения)"

msgid ""
"état inconnu depuis cette session — la Synchronisation le lira avec votre "
"autorisation"
msgstr ""
"состояние неизвестно в этом сеансе — Синхронизация прочитает его с вашего "
"разрешения"

#, python-brace-format
msgid "Registre — machine {machine}"
msgstr "Реестр — машина {machine}"

msgid "Aucune application omega trouvée sur cette machine."
msgstr "На этой машине не найдено приложений omega."

#, python-brace-format
msgid "Espace partagé : {status}"
msgstr "Общее пространство: {status}"

msgid "Synchroniser : un seul plan, un seul mot de passe administrateur"
msgstr "Синхронизация: один план, один пароль администратора"

msgid "Rien à faire : tout est déjà synchronisé."
msgstr "Делать нечего: всё уже синхронизировано."

msgid ""
"1. Cartes d'identité à créer (par chaque outil, sous son compte, sans mot de"
" passe) :"
msgstr ""
"1. Паспорта для создания (каждым инструментом, под его учётной записью, без "
"пароля):"

msgid "aucune : chaque application choisie a déjà la sienne."
msgstr "нет: у каждого выбранного приложения уже есть свой."

msgid "2. Espace partagé (en administrateur, une commande après l'autre) :"
msgstr ""
"2. Общее пространство (от имени администратора, команды одна за другой):"

#, python-brace-format
msgid "Recopier la carte d'identité de {root} (créée à l'étape 1)"
msgstr "Скопировать паспорт {root} (созданный на шаге 1)"

msgid "rien : l'espace partagé est déjà à jour."
msgstr "ничего: общее пространство уже актуально."

msgid "Une commande qui n'est pas annoncée ici n'est jamais lancée."
msgstr "Команда, не объявленная здесь, никогда не запускается."

#, python-brace-format
msgid ""
"Arrêt : la carte d'identité de {root} n'a pas pu être créée ({error}). Rien "
"d'autre n'a été lancé."
msgstr ""
"Остановка: не удалось создать паспорт {root} ({error}). Больше ничего не "
"запускалось."

msgid "échec"
msgstr "ошибка"

#, python-brace-format
msgid ""
"Arrêt avant l'espace partagé : le plan a changé ({step}). Rien de plus n'a "
"été lancé ; relancez la synchronisation pour voir le nouveau plan."
msgstr ""
"Остановка перед общим пространством: план изменился ({step}). Больше ничего "
"не запускалось; запустите синхронизацию снова, чтобы увидеть новый план."

#, python-brace-format
msgid ""
"Arrêt à l'étape « {step} » : {error}. Ce qui a été créé est noté ; relancez "
"la synchronisation après avoir corrigé la cause."
msgstr ""
"Остановка на шаге «{step}»: {error}. Созданное записано; запустите "
"синхронизацию снова после устранения причины."

msgid "Synchronisation terminée : les applications choisies sont reliées."
msgstr "Синхронизация завершена: выбранные приложения связаны."

msgid "DÉMARRAGE RAPIDE"
msgstr "БЫСТРЫЙ СТАРТ"

msgid "RACCOURCIS"
msgstr "СОЧЕТАНИЯ КЛАВИШ"

msgid "Aide d’omega-connect"
msgstr "Справка omega-connect"

msgid "Aide complète : chaque menu, sa fonction et le détail."
msgstr "Полная справка: каждое меню, его назначение и подробности."

msgid "Démarrage rapide"
msgstr "Быстрый старт"

msgid "Raccourcis"
msgstr "Сочетания клавиш"

msgid "Touche"
msgstr "Клавиша"

msgid "Action"
msgstr "Действие"

#, python-brace-format
msgid "OMEGA-CONNECT {version} — aide."
msgstr "OMEGA-CONNECT {version} — справка."

msgid "Aide - Omega-Connect"
msgstr "Справка - Omega-Connect"

msgid ""
"Interconnecteur de la suite omega : détecte les outils installés, vérifie et"
" attribue les droits entre eux."
msgstr ""
"Связующее звено набора omega: обнаруживает установленные инструменты, "
"проверяет и назначает права между ними."

msgid "commandes"
msgstr "команды"

msgid "COMMANDE"
msgstr "КОМАНДА"

msgid "Cherche les outils omega installés (lecture seule, sans root)."
msgstr "Ищет установленные инструменты omega (только чтение, без root)."

msgid ""
"Cherche les outils omega installés : registre d'omega-serv, services systemd"
" / OpenRC / runit, HOME (3 niveaux), /srv (2 niveaux) et chemins saisis. Ne "
"suit jamais un lien symbolique ni un montage réseau. Lit le jeton de chaque "
"installation et demande sa fiche à l'outil, sous le compte propriétaire du "
"dossier."
msgstr ""
"Ищет установленные инструменты omega: реестр omega-serv, службы systemd / "
"OpenRC / runit, HOME (3 уровня), /srv (2 уровня) и указанные пути. Никогда "
"не переходит по символическим ссылкам и в сетевые подключения. Читает токен "
"каждой установки и запрашивает у инструмента его описание от имени учётной "
"записи владельца папки."

msgid "DOSSIER"
msgstr "ПАПКА"

msgid "Dossier d'installation à examiner en plus (option répétable)."
msgstr ""
"Дополнительная папка установки для проверки (параметр можно повторять)."

msgid ""
"Ne demande pas la fiche aux outils (plus rapide, aucune commande lancée)."
msgstr ""
"Не запрашивать описание у инструментов (быстрее, никакие команды не "
"запускаются)."

msgid "texte (défaut, traduit) ou json (pour les scripts, jamais traduit)."
msgstr ""
"текст (по умолчанию, переведён) или json (для скриптов, никогда не "
"переводится)."

msgid "Vérifie les liens existants entre outils (lecture seule, sans root)."
msgstr ""
"Проверяет существующие связи между инструментами (только чтение, без root)."

msgid ""
"Détecte les outils (avec leur fiche), puis contrôle chaque lien : journaux "
"d'omega-serv et de magnet lus par les jails d'omega-jail, pont fail2ban vers"
" la liste noire, liste protégée, droits de la liste noire, fichiers d'omega-"
"jail dans fail2ban, jetons. Chaque écart affiche la commande qui le "
"corrigerait, sans jamais la lancer. Code de sortie : 0 sans écart, 1 si un "
"lien est cassé ou dégradé."
msgstr ""
"Обнаруживает инструменты (с их описанием), затем проверяет каждую связь: "
"журналы omega-serv и magnet, читаемые jail'ами omega-jail, мост fail2ban к "
"чёрному списку, защищённый список, права чёрного списка, файлы omega-jail в "
"fail2ban, токены. Для каждого расхождения показывается команда, которая его "
"исправит, но она никогда не запускается. Код выхода: 0 без расхождений, 1 "
"если связь нарушена или ухудшена."

msgid "Affiche aussi les contrôles conformes."
msgstr "Показывать также проверки без замечаний."

msgid ""
"Ouvre le tableau de bord (défaut sans commande) : outils, liens et leur "
"état, en lecture seule."
msgstr ""
"Открывает панель мониторинга (по умолчанию без команды): инструменты, связи "
"и их состояние, только чтение."

msgid ""
"Tableau de bord en lecture seule : outils et instances, état de chaque lien,"
" contrôles et commandes de correction (jamais lancées). Nouvelle "
"vérification à intervalle régulier tant que l'écran est ouvert."
msgstr ""
"Панель мониторинга только для чтения: инструменты и экземпляры, состояние "
"каждой связи, проверки и команды исправления (никогда не запускаются). "
"Повторная проверка через равные промежутки времени, пока экран открыт."

msgid ""
"Crée la zone neutre et y recopie jetons et fiches (root, après accord)."
msgstr ""
"Создаёт нейтральную зону и копирует в неё токены и описания (root, после "
"согласия)."

msgid ""
"Crée le groupe omega-synchro et la zone neutre (/var/lib/omega-synchro, "
"2750), vous ajoute au groupe, recopie le jeton et la fiche de chaque outil "
"détecté, et inscrit tout au registre. Relancée, elle actualise les copies. "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"Создаёт группу omega-synchro и нейтральную зону (/var/lib/omega-synchro, "
"2750), добавляет вас в группу, копирует токен и описание каждого "
"обнаруженного инструмента и записывает всё в реестр. При повторном запуске "
"обновляет копии. Каждая команда показывается перед запуском через sudo."

msgid ""
"Défait ce qu'omega-connect a créé : un outil désinstallé, ou toute la zone "
"(root, après accord)."
msgstr ""
"Отменяет то, что создал omega-connect: удалённый инструмент или всю зону "
"(root, после согласия)."

msgid ""
"« retirer CIBLE » enlève de la zone un outil désinstallé (nom, dossier ou 8 "
"premiers caractères de l'identifiant). « retirer --tout » défait exactement "
"ce que le registre liste, ou garde la zone telle quelle (liens figés). "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"«retirer CIBLE» убирает из зоны удалённый инструмент (имя, папка или первые "
"8 символов идентификатора). «retirer --tout» отменяет ровно то, что "
"перечислено в реестре, или оставляет зону как есть (связи заморожены). "
"Каждая команда показывается перед запуском через sudo."

msgid "CIBLE"
msgstr "CIBLE"

msgid "Outil à retirer de la zone."
msgstr "Инструмент, который нужно убрать из зоны."

msgid "Toute la zone (question : garder ou tout retirer)."
msgstr "Вся зона (вопрос: оставить или убрать всё)."

msgid "Avec --tout : garder la zone, liens figés (rien n'est supprimé)."
msgstr "С --tout: оставить зону, связи заморожены (ничего не удаляется)."

msgid "Avec --tout : tout retirer, sans question."
msgstr "С --tout: убрать всё, без вопроса."

msgid ""
"Recherche les applications omega de cette machine et met à jour le registre "
"(lecture seule)."
msgstr ""
"Ищет приложения omega на этой машине и обновляет реестр (только чтение)."

msgid ""
"Lecture seule, sans mot de passe : chaque application trouvée, son service "
"et son état (Détectée, Inscrite, Reliée, À réparer, Ancienne version, "
"Installation inachevée). Le résultat est enregistré dans le registre du parc"
" (var/parc.json)."
msgstr ""
"Только чтение, без пароля: каждое найденное приложение, его служба и "
"состояние (Обнаружено, Зарегистрировано, Связано, Требует исправления, "
"Старая версия, Незавершённая установка). Результат сохраняется в реестре "
"машин (var/parc.json)."

msgid "UTILISATEUR@MACHINE"
msgstr "UTILISATEUR@MACHINE"

msgid ""
"Machine distante à scanner par SSH avec vos clés (rien n'y est installé) ; "
"sans cible : cette machine."
msgstr ""
"Удалённая машина для сканирования по SSH с вашими ключами (на неё ничего не "
"устанавливается); без цели: эта машина."

msgid "MACHINE"
msgstr "MACHINE"

msgid ""
"Retire une machine distante du registre (nom, adresse ou "
"utilisateur@adresse) ; rien n'est modifié sur elle."
msgstr ""
"Убирает удалённую машину из реестра (имя, адрес или пользователь@адрес); на "
"ней ничего не меняется."

msgid ""
"Liste les machines que cet ordinateur sait déjà joindre (profils Unison, "
"~/.ssh/config, known_hosts)."
msgstr ""
"Показывает машины, к которым этот компьютер уже умеет подключаться (профили "
"Unison, ~/.ssh/config, known_hosts)."

msgid ""
"Remet en place les liens de ce qui est installé : cartes d'identité, espace "
"partagé, accès des services — un seul plan."
msgstr ""
"Восстанавливает связи установленных приложений: паспорта, общее "
"пространство, доступ служб — единым планом."

msgid ""
"Une seule action (décision de l'auteur) : recrée les cartes d'identité qui "
"manquent (commande de chaque outil, sous son compte), prépare l'espace "
"partagé, y recopie les cartes et donne l'accès aux services. Tout est "
"affiché avant d'agir ; un seul mot de passe administrateur. Sans CIBLE : "
"toutes les applications de la machine."
msgstr ""
"Одно действие (решение автора): заново создаёт недостающие паспорта "
"(командой каждого инструмента, под его учётной записью), подготавливает "
"общее пространство, копирует туда паспорта и даёт доступ службам. Всё "
"показывается до выполнения; один пароль администратора. Без CIBLE: все "
"приложения машины."

msgid ""
"Application à synchroniser : nom (omega-fire) ou dossier ; plusieurs "
"possibles."
msgstr ""
"Приложение для синхронизации: имя (omega-fire) или папка; можно несколько."

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; option "
"répétable) : réparer puis synchroniser, sans rien taper là-bas (une "
"application trop ancienne : mettre-a-jour d'abord)."
msgstr ""
"Уже просканированная удалённая машина (имя, адрес или пользователь@машина; "
"параметр можно повторять): исправить, затем синхронизировать, ничего не "
"вводя там (слишком старое приложение: сначала mettre-a-jour)."

msgid ""
"Toutes les machines distantes du registre, une à une (un mot de passe par "
"machine)."
msgstr "Все удалённые машины из реестра, по очереди (один пароль на машину)."

msgid ""
"Met à jour les applications trop anciennes d'une machine distante, depuis "
"leur Release GitHub (rien d'autre)."
msgstr ""
"Обновляет слишком старые приложения удалённой машины из их Release на GitHub"
" (и больше ничего)."

msgid ""
"Archive prise sur GitHub, empreinte vérifiée avec sha.txt, puis installée "
"sur la machine (comme la section « Mise à jour » du README de l'outil). Ne "
"répare ni ne synchronise : voir synchroniser."
msgstr ""
"Архив берётся с GitHub, контрольная сумма проверяется по sha.txt, затем он "
"устанавливается на машину (как в разделе «Обновление» README инструмента). "
"Не исправляет и не синхронизирует: см. synchroniser."

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; "
"répétable)."
msgstr ""
"Уже просканированная удалённая машина (имя, адрес или пользователь@машина; "
"можно повторять)."

msgid "Toutes les machines distantes du registre, une à une."
msgstr "Все удалённые машины из реестра, по очереди."

msgid ""
"Corrige les écarts trouvés par verifier avec la commande de l'outil qui les "
"possède (root, après accord)."
msgstr ""
"Исправляет расхождения, найденные verifier, командой инструмента-владельца "
"(root, после согласия)."

msgid ""
"Ne corrige que ce qu'un outil sait corriger lui-même (omega-jail --apply "
"--update, omega-serv service permissions, synchro jeton de chaque outil) et "
"ce que le registre de la zone dit qu'omega-connect a créé (plan d'etablir, "
"affiché à son tour). omega-connect ne réécrit jamais le fichier d'un autre "
"outil : le reste est affiché, à faire à la main. Chaque commande est "
"affichée avant d'être lancée."
msgstr ""
"Исправляет только то, что инструмент умеет исправлять сам (omega-jail "
"--apply --update, omega-serv service permissions, synchro jeton каждого "
"инструмента), и то, что по реестру зоны создал omega-connect (план etablir, "
"показывается в свою очередь). omega-connect никогда не переписывает файл "
"другого инструмента: остальное показывается для выполнения вручную. Каждая "
"команда показывается перед запуском."

msgid ""
"Machine distante déjà scannée : réparée depuis ici, rien à taper là-bas "
"(répétable)."
msgstr ""
"Уже просканированная удалённая машина: исправляется отсюда, там ничего "
"вводить не нужно (можно повторять)."

msgid ""
"Rapport complet : outils, jetons, fiches, liens et tous leurs contrôles, "
"zone et registre (lecture seule)."
msgstr ""
"Полный отчёт: инструменты, токены, описания, связи и все их проверки, зона и"
" реестр (только чтение)."

msgid ""
"Tout ce qu'omega-connect sait à cet instant, en lecture seule et sans root :"
" outils et instances, jetons, fiches, chaque lien avec tous ses contrôles et"
" les commandes de correction, remarques de la recherche, zone neutre et son "
"registre. Affiché, ou enregistré dans var/exports/ avec --enregistrer."
msgstr ""
"Всё, что omega-connect знает на данный момент, только чтение и без root: "
"инструменты и экземпляры, токены, описания, каждая связь со всеми проверками"
" и командами исправления, замечания о поиске, нейтральная зона и её реестр. "
"Выводится на экран или сохраняется в var/exports/ с --enregistrer."

msgid ""
"texte (défaut, traduit), json (jamais traduit) ou html (page autonome)."
msgstr ""
"текст (по умолчанию, переведён), json (никогда не переводится) или html "
"(автономная страница)."

msgid "Thème de la page HTML."
msgstr "Тема HTML-страницы."

msgid "Enregistre dans var/exports/ au lieu d'afficher, et donne le chemin."
msgstr "Сохранить в var/exports/ вместо вывода на экран и показать путь."

msgid "Affiche seulement les commandes, sans rien lancer."
msgstr "Показать только команды, ничего не запуская."

msgid "Lance sans demander l'accord (les commandes restent affichées)."
msgstr "Запустить без запроса согласия (команды всё равно показываются)."

msgid ""
"Votre session n'a pas encore le groupe omega-synchro (il ne compte qu'après "
"une reconnexion) : lecture de la zone avec sudo (find, stat, cat)."
msgstr ""
"В вашем сеансе ещё нет группы omega-synchro (она действует только после "
"повторного входа): зона читается через sudo (find, stat, cat)."

msgid "Authentification sudo refusée ou annulée : rien n'est fait."
msgstr "Аутентификация sudo отклонена или отменена: ничего не сделано."

#, python-brace-format
msgid "Lancer ces {count} commande(s) en root ? [o/N] "
msgstr "Запустить эти команды от root (количество: {count})? [o/N] "

msgid "Authentification sudo refusée ou annulée : rien n'a été lancé."
msgstr "Аутентификация sudo отклонена или отменена: ничего не запущено."

msgid ""
"Pas de terminal pour poser la question : relancez avec --garder-zone ou "
"--effacer."
msgstr ""
"Нет терминала, чтобы задать вопрос: запустите снова с --garder-zone или "
"--effacer."

msgid "Garder la zone (liens figés) [g], tout retirer [t], ou annuler [a] ? "
msgstr ""
"Оставить зону (связи заморожены) [g], убрать всё [t] или отменить [a]? "

msgid ""
"Pas de terminal pour demander l'accord : relancez avec --oui, ou "
"--simulation."
msgstr ""
"Нет терминала, чтобы запросить согласие: запустите снова с --oui или "
"--simulation."

msgid "Abandon : rien n'a été lancé."
msgstr "Отмена: ничего не запущено."

#, python-brace-format
msgid "Lancer ces {count} commande(s) ? [o/N] "
msgstr "Запустить эти команды (количество: {count})? [o/N] "

msgid ""
"Zone neutre : plan d'« etablir » (seulement ce que le registre dit avoir "
"créé)."
msgstr ""
"Нейтральная зона: план «etablir» (только то, что по реестру было создано)."

#, python-brace-format
msgid "Registre du parc non enregistré : {error}"
msgstr "Реестр машин не сохранён: {error}"

msgid "Saisissez utilisateur@machine (nom ou adresse), sans espace ni option."
msgstr ""
"Введите пользователь@машина (имя или адрес), без пробелов и параметров."

msgid "Pas de terminal pour demander la confiance : rien n'a été fait."
msgstr "Нет терминала, чтобы запросить доверие: ничего не сделано."

msgid "Faire confiance à cette machine ? [o/N] "
msgstr "Доверять этой машине? [o/N] "

msgid "Rien n'a été fait."
msgstr "Ничего не сделано."

msgid "Impossible d'ajouter la clé à ~/.ssh/known_hosts."
msgstr "Не удалось добавить ключ в ~/.ssh/known_hosts."

#, python-brace-format
msgid "Aucune application ne correspond à : {targets}"
msgstr "Ни одно приложение не соответствует: {targets}"

msgid "Lancer ce plan ? [o/N] "
msgstr "Запустить этот план? [o/N] "

msgid "Authentification refusée ou annulée : rien n'a été lancé."
msgstr "Аутентификация отклонена или отменена: ничего не запущено."

#, python-brace-format
msgid "Machine inconnue ou mal écrite : {target}"
msgstr "Машина неизвестна или указана с ошибкой: {target}"

msgid ""
"Aucune machine distante dans le registre : scannez-en une d'abord (scanner "
"utilisateur@machine)."
msgstr ""
"В реестре нет удалённых машин: сначала просканируйте хотя бы одну (scanner "
"пользователь@машина)."

#, python-brace-format
msgid ""
"{target} : clé de la machine pas encore acceptée, ou machine injoignable — "
"scannez-la d'abord (scanner {target})."
msgstr ""
"{target}: ключ машины ещё не принят, или машина недоступна — сначала "
"просканируйте её (scanner {target})."

#, python-brace-format
msgid "Lancer sur {name} ? [o/N] "
msgstr "Запустить на {name}? [o/N] "

#, python-brace-format
msgid "Rien n'a été lancé sur {name}."
msgstr "На {name} ничего не запущено."

msgid "Indiquez soit un outil à retirer, soit --tout."
msgstr "Укажите либо инструмент, который нужно убрать, либо --tout."

msgid "--garder-zone et --effacer vont avec --tout."
msgstr "--garder-zone и --effacer используются вместе с --tout."

msgid "Machines distantes indisponibles ici."
msgstr "Удалённые машины здесь недоступны."

msgid "Indiquez --machine MACHINE ou --toutes-machines."
msgstr "Укажите --machine MACHINE или --toutes-machines."

#, python-brace-format
msgid "Aucune machine distante du registre ne correspond à : {target}"
msgstr "Ни одна удалённая машина из реестра не соответствует: {target}"

#, python-brace-format
msgid "{machine} retirée du registre (rien n'a été modifié sur elle)."
msgstr "{machine} убрана из реестра (на ней ничего не изменено)."

#, python-brace-format
msgid "Rapport enregistré : {path}"
msgstr "Отчёт сохранён: {path}"

#, python-brace-format
msgid "aucune version publiée sur GitHub ({url})"
msgstr "на GitHub не опубликовано ни одной версии ({url})"

msgid "GitHub ne répond pas depuis cet ordinateur (réseau)"
msgstr "GitHub не отвечает с этого компьютера (сеть)"

msgid "l'archive n'est pas citée dans sha.txt de la Release : refusée"
msgstr "архив не указан в sha.txt релиза: отклонён"

msgid "empreinte différente de sha.txt : archive refusée, rien n'est envoyé"
msgstr ""
"контрольная сумма не совпадает с sha.txt: архив отклонён, ничего не "
"отправлено"

msgid "fichier trop volumineux pour une archive d'outil : refusé"
msgstr "файл слишком велик для архива инструмента: отклонён"

#, python-brace-format
msgid ""
"la dernière version publiée sur GitHub ({latest}) est encore trop ancienne"
msgstr ""
"последняя опубликованная на GitHub версия ({latest}) всё ещё слишком старая"

msgid "extraction par-dessus, puis son install.sh"
msgstr "распаковка поверх, затем его install.sh"

msgid ""
"ancienne installation mise de côté (sudo mv), nouvelle à sa place, puis son "
"install.sh qui reprend réglages et données"
msgstr ""
"старая установка отложена (sudo mv), новая на её месте, затем её install.sh "
"переносит настройки и данные"

msgid "Commande"
msgstr "Команда"

msgid "Mise à jour"
msgstr "Обновление"

msgid "Réparer"
msgstr "Исправить"

msgid "Synchroniser"
msgstr "Синхронизировать"

#, python-brace-format
msgid ""
"{tool} {version} ({root}) : réinstallation (installation inachevée) — {how}"
msgstr ""
"{tool} {version} ({root}): переустановка (незавершённая установка) — {how}"

msgid "(installation inachevée)"
msgstr "(незавершённая установка)"

#, python-brace-format
msgid "{head} → {latest} ({root}) : {how}"
msgstr "{head} → {latest} ({root}): {how}"

#, python-brace-format
msgid "{head} ({root}) : pas de mise à jour possible — {reason}"
msgstr "{head} ({root}): обновление невозможно — {reason}"

#, python-brace-format
msgid ""
"Tout se passe dans ce terminal : le mot de passe sudo de {name} est demandé "
"par la machine elle-même, une fois ; omega-connect ne le voit jamais."
msgstr ""
"Всё происходит в этом терминале: пароль sudo для {name} запрашивает сама "
"машина, один раз; omega-connect его никогда не видит."

#, python-brace-format
msgid "Réinstaller l'application — machine {name} ({target})"
msgstr "Переустановить приложение — машина {name} ({target})"

#, python-brace-format
msgid "Mettre à jour l'application — machine {name} ({target})"
msgstr "Обновить приложение — машина {name} ({target})"

msgid ""
"Aucune application trop ancienne sur cette machine : rien à mettre à jour."
msgstr "На этой машине нет слишком старых приложений: обновлять нечего."

msgid ""
"Archives prises sur la Release GitHub de chaque application (empreinte "
"vérifiée avec sha.txt avant tout envoi) :"
msgstr ""
"Архивы берутся из Release на GitHub каждого приложения (контрольная сумма "
"проверяется по sha.txt перед любой отправкой):"

msgid ""
"Rien d'autre n'est fait. Ensuite, pour remettre les liens en place : "
"Synchronisation."
msgstr ""
"Больше ничего не делается. Затем, чтобы восстановить связи: Синхронизация."

#, python-brace-format
msgid "Synchroniser — machine {name} ({target})"
msgstr "Синхронизировать — машина {name} ({target})"

msgid ""
"Laissées de côté, trop anciennes (Registre → « Mettre à jour l'application »"
" d'abord) :"
msgstr "Пропущены, слишком старые (сначала Реестр → «Обновить приложение»):"

msgid ""
"Rien à synchroniser : tout ce qui peut l'être est relié sur cette machine."
msgstr "Синхронизировать нечего: всё, что можно, на этой машине уже связано."

msgid "Réparer puis synchroniser, sur la machine. Plan :"
msgstr "Исправить, затем синхронизировать, на самой машине. План:"

msgid ""
"L'espace partagé de cette machine n'est lisible qu'avec sudo : il sera relu "
"au lancement."
msgstr ""
"Общее пространство этой машины доступно для чтения только через sudo: оно "
"будет перечитано при запуске."

#, python-brace-format
msgid "Réparer — machine {name} ({target})"
msgstr "Исправить — машина {name} ({target})"

#, python-brace-format
msgid "« Réparer {name} » lance ces commandes SUR la machine, depuis ici."
msgstr "«Исправить {name}» запускает эти команды НА машине, отсюда."

#, python-brace-format
msgid ""
"Commandes qu'aucun outil ne sait lancer — lancées AUSSI sur {name} par « "
"Réparer {name} », une à une, après les corrections des outils (celles déjà "
"réglées entre-temps sont sautées) :"
msgstr ""
"Команды, которые не умеет запускать ни один инструмент, — их ТОЖЕ запускает "
"на {name} кнопка «Исправить {name}», по одной, после исправлений "
"инструментов (уже исправленное за это время пропускается):"

#, python-brace-format
msgid "Rien n'a été envoyé à {target} :"
msgstr "На {target} ничего не отправлено:"

#, python-brace-format
msgid "Envoi impossible vers {target}."
msgstr "Не удалось отправить на {target}."

#, python-brace-format
msgid "Résultat pour {target} :"
msgstr "Результат для {target}:"

