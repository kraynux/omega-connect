msgid "Zone : établir…"
msgstr "क्षेत्र: स्थापित करें…"

msgid "Analyser de nouveau"
msgstr "फिर से विश्लेषण करें"

msgid "Liaisons à corriger"
msgstr "ठीक करने योग्य लिंक"

msgid "aucune machine distante : scannez-en une (Scanner)"
msgstr "कोई दूरस्थ मशीन नहीं: एक मशीन स्कैन करें (स्कैन करें)"

msgid "Préparation des réparations : vérification des liens en cours…"
msgstr "मरम्मत की तैयारी: लिंक की जाँच चल रही है…"

msgid "Lancer avec sudo"
msgstr "sudo से शुरू करें"

msgid ""
