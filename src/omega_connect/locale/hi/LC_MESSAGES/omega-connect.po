#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — मशीन {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== {tool} का {version} में अपडेट ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ {tool} {version} इंस्टॉल हो गया।"

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· पहले से सेट: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "आर्काइव अस्वीकृत: अनपेक्षित पथ {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr "आर्काइव अस्वीकृत: {name} न फ़ाइल है न फ़ोल्डर"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "आर्काइव अस्वीकृत: एक्सट्रैक्ट करने पर बहुत बड़ा"

#, python-brace-format
msgid "archive refusée : pas de dossier {tool}/"
msgstr "आर्काइव अस्वीकृत: कोई {tool}/ फ़ोल्डर नहीं"

#, python-brace-format
msgid "{path} est un lien : rien n'est copié dedans"
msgstr "{path} एक लिंक है: इसमें कुछ भी कॉपी नहीं किया जाता"

#, python-brace-format
msgid "{root} n'est pas un dossier d'installation"
msgstr "{root} इंस्टॉलेशन फ़ोल्डर नहीं है"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} इस खाते का नहीं है: अपडेट हाथ से करना होगा"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr ""
"आर्काइव का फ़िंगरप्रिंट sha.txt से अलग है: कुछ भी इंस्टॉल नहीं किया गया"

#, python-brace-format
msgid "Mise de côté de l'ancienne installation : {old} → {new}"
msgstr "पुराना इंस्टॉलेशन अलग रखा जा रहा है: {old} → {new}"

msgid "impossible de mettre l'ancienne installation de côté (sudo mv)"
msgstr "पुराना इंस्टॉलेशन अलग नहीं रखा जा सका (sudo mv)"

#, python-brace-format
msgid "{count} fichiers installés dans {root}."
msgstr "{root} में {count} फ़ाइलें इंस्टॉल की गईं।"

#, python-brace-format
msgid "install.sh introuvable dans {root}"
msgstr "{root} में install.sh नहीं मिला"

#, python-brace-format
msgid ""
"Environnement Python (.venv) incomplet mis de côté : {path} — install.sh en "
"recrée un."
msgstr ""
"अधूरा Python एनवायरनमेंट (.venv) अलग रखा गया: {path} — install.sh नया "
"बनाएगा।"

#, python-brace-format
msgid "Lancement de {path} :"
msgstr "{path} चलाया जा रहा है:"

#, python-brace-format
msgid "install.sh a échoué (code {code})"
msgstr "install.sh विफल रहा (कोड {code})"

#, python-brace-format
msgid "{script} introuvable : réglages et données restés dans {old}"
msgstr "{script} नहीं मिला: सेटिंग्स और डेटा {old} में ही रहे"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"{old} से सेटिंग्स और डेटा लिए जा रहे हैं (अन्य पुराने इंस्टॉलेशन अनदेखे किए "
"गए: {others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "{old} से सेटिंग्स और डेटा लेना विफल ({script})"

msgid "contient l'installation d'omega-connect"
msgstr "इसमें omega-connect का इंस्टॉलेशन है"

msgid "registre omega-serv"
msgstr "omega-serv रजिस्टर"

msgid "systemd"
msgstr "systemd"

msgid "OpenRC"
msgstr "OpenRC"

msgid "runit"
msgstr "runit"

msgid "dossier personnel"
msgstr "होम फ़ोल्डर"

msgid "/srv"
msgstr "/srv"

msgid "chemin saisi"
msgstr "दर्ज किया गया पथ"

msgid "absent"
msgstr "अनुपस्थित"

msgid "illisible (droits)"
msgstr "पढ़ा नहीं जा सकता (अनुमतियाँ)"

msgid "abîmé"
msgstr "क्षतिग्रस्त"

msgid "d'une version plus récente qu'omega-connect"
msgstr "omega-connect से नए संस्करण का"

msgid "non fournie (version de l'outil trop ancienne ?)"
msgstr "नहीं दिया गया (टूल का संस्करण बहुत पुराना?)"

msgid "non obtenue"
msgstr "प्राप्त नहीं हुआ"

msgid "illisible"
msgstr "पढ़ा नहीं जा सकता"

msgid "active"
msgstr "सक्रिय"

msgid "désactivée"
msgstr "अक्षम"

msgid "absente"
msgstr "अनुपस्थित"

msgid "inconnue"
msgstr "अज्ञात"

#, python-brace-format
msgid "registre des instances omega-serv illisible : {detail}"
msgstr "omega-serv इंस्टेंस रजिस्टर पढ़ा नहीं जा सकता: {detail}"

#, python-brace-format
msgid "instance omega-serv enregistrée mais dossier disparu : {detail}"
msgstr "omega-serv इंस्टेंस दर्ज है लेकिन फ़ोल्डर गायब है: {detail}"

#, python-brace-format
msgid "fichier de service illisible : {detail}"
msgstr "सेवा फ़ाइल पढ़ी नहीं जा सकती: {detail}"

#, python-brace-format
msgid "service {detail} : dossier d'installation introuvable"
msgstr "सेवा {detail}: इंस्टॉलेशन फ़ोल्डर नहीं मिला"

#, python-brace-format
msgid "recherche arrêtée (trop de dossiers) dans {detail}"
msgstr "{detail} में खोज रोकी गई (बहुत अधिक फ़ोल्डर)"

#, python-brace-format
msgid "montage réseau non parcouru : {detail}"
msgstr "नेटवर्क माउंट नहीं खोजा गया: {detail}"

#, python-brace-format
msgid "dossier introuvable : {detail}"
msgstr "फ़ोल्डर नहीं मिला: {detail}"

#, python-brace-format
msgid "aucun outil omega dans : {detail}"
msgstr "इसमें कोई omega टूल नहीं: {detail}"

#, python-brace-format
msgid "créez-le sous le compte {owner} : {command}"
msgstr "इसे {owner} खाते से बनाएँ: {command}"

msgid "outil inconnu"
msgstr "अज्ञात टूल"

#, python-brace-format
msgid "trouvé par : {sources}"
msgstr "इससे मिला: {sources}"

#, python-brace-format
msgid "propriétaire : {owner}"
msgstr "स्वामी: {owner}"

#, python-brace-format
msgid "service : {names}"
msgstr "सेवा: {names}"

#, python-brace-format
msgid "jeton : présent (identifiant {identifier}, version {version})"
msgstr "टोकन: मौजूद (ID {identifier}, संस्करण {version})"

#, python-brace-format
msgid "jeton : {state}"
msgstr "टोकन: {state}"

#, python-brace-format
msgid "fiche : {state}"
msgstr "विवरण-पत्र: {state}"

#, python-brace-format
msgid "détail technique : {detail}"
msgstr "तकनीकी विवरण: {detail}"

#, python-brace-format
msgid "fiche : instance {instance}"
msgstr "विवरण-पत्र: इंस्टेंस {instance}"

#, python-brace-format
msgid "service {manager} ({state})"
msgstr "सेवा {manager} ({state})"

msgid "partielle (sans root)"
msgstr "आंशिक (root के बिना)"

#, python-brace-format
msgid "fonctions : {states}"
msgstr "फ़ंक्शन: {states}"

#, python-brace-format
msgid "Détection des outils omega (HOME examiné : {home})"
msgstr "omega टूल्स की पहचान (जाँचा गया HOME: {home})"

msgid "Aucun outil omega trouvé. Indiquez un dossier avec --chemin."
msgstr "कोई omega टूल नहीं मिला। --chemin से एक फ़ोल्डर बताएँ।"

#, python-brace-format
msgid ""
"Identifiant en double {identifier} : {roots} (dossier copié à la main ?). "
"Ces installations ne sont pas fusionnées ; ouvrez la copie une fois pour lui"
" donner un nouvel identifiant."
msgstr ""
"डुप्लिकेट ID {identifier}: {roots} (फ़ोल्डर हाथ से कॉपी किया गया?)। इन "
"इंस्टॉलेशन को मिलाया नहीं जाता; कॉपी को एक बार खोलें ताकि उसे नई ID मिले।"

msgid "Remarques sur la recherche :"
msgstr "खोज पर टिप्पणियाँ:"

#, python-brace-format
msgid "{count} installation(s) trouvée(s)."
msgstr "{count} इंस्टॉलेशन मिले।"

msgid "Détectée"
msgstr "पहचानी गई"

msgid "Inscrite"
msgstr "पंजीकृत"

msgid "Reliée"
msgstr "जुड़ी हुई"

msgid "À réparer"
msgstr "मरम्मत ज़रूरी"

msgid "Ancienne version"
msgstr "पुराना संस्करण"

msgid "Installation inachevée"
msgstr "अधूरा इंस्टॉलेशन"

msgid "Injoignable"
msgstr "पहुँच से बाहर"

msgid "trouvée, sans carte d'identité : la Synchronisation la lui crée"
msgstr "मिली, पर पहचान पत्र नहीं है: सिंक्रनाइज़ेशन इसे बनाता है"

msgid ""
"a sa carte d'identité, pas encore dans l'espace partagé : la Synchronisation"
" l'y ajoute"
msgstr ""
"इसका पहचान पत्र है, पर अभी साझा स्थान में नहीं: सिंक्रनाइज़ेशन इसे जोड़ता है"

msgid "dans l'espace partagé, à jour"
msgstr "साझा स्थान में, अद्यतन"

msgid "un écart : Réparer le corrige"
msgstr "एक विसंगति: मरम्मत इसे ठीक करता है"

msgid "trop ancienne pour avoir une carte d'identité : mettez-la à jour"
msgstr "पहचान पत्र रखने के लिए बहुत पुरानी: इसे अपडेट करें"

msgid ""
"installée, mais son install.sh ne s'est pas terminé (environnement Python ou"
" carte d'identité manquants) : « Réinstaller l'application » (Registre)"
msgstr ""
"इंस्टॉल है, पर इसका install.sh पूरा नहीं हुआ (Python एनवायरनमेंट या पहचान "
"पत्र गायब): « एप्लिकेशन फिर से इंस्टॉल करें » (रजिस्टर)"

msgid "machine qui ne répond pas"
msgstr "मशीन जवाब नहीं दे रही"

#, python-brace-format
msgid ""
"trop ancienne pour avoir une carte d'identité : {tool} {version} ou plus "
"récent requis (machine distante : Synchronisation la met à jour depuis "
"GitHub)"
msgstr ""
"पहचान पत्र रखने के लिए बहुत पुरानी: {tool} {version} या नया आवश्यक (दूरस्थ "
"मशीन: सिंक्रनाइज़ेशन इसे GitHub से अपडेट करता है)"

msgid "pas encore préparé — la Synchronisation le prépare"
msgstr "अभी तैयार नहीं — सिंक्रनाइज़ेशन इसे तैयार करता है"

msgid "prêt"
msgstr "तैयार"

msgid "à corriger — la Synchronisation le remet en état"
msgstr "ठीक करना है — सिंक्रनाइज़ेशन इसे ठीक करता है"

msgid "prêt (lu avec votre autorisation)"
msgstr "तैयार (आपकी अनुमति से पढ़ा गया)"

msgid ""
"état inconnu depuis cette session — la Synchronisation le lira avec votre "
"autorisation"
msgstr "इस सत्र से स्थिति अज्ञात — सिंक्रनाइज़ेशन आपकी अनुमति से इसे पढ़ेगा"

#, python-brace-format
msgid "Registre — machine {machine}"
msgstr "रजिस्टर — मशीन {machine}"

msgid "Aucune application omega trouvée sur cette machine."
msgstr "इस मशीन पर कोई omega एप्लिकेशन नहीं मिला।"

#, python-brace-format
msgid "Espace partagé : {status}"
msgstr "साझा स्थान: {status}"

msgid "Synchroniser : un seul plan, un seul mot de passe administrateur"
msgstr "सिंक करें: एक ही योजना, एक ही एडमिन पासवर्ड"

msgid "Rien à faire : tout est déjà synchronisé."
msgstr "कुछ करने को नहीं: सब कुछ पहले से सिंक है।"

msgid ""
"1. Cartes d'identité à créer (par chaque outil, sous son compte, sans mot de"
" passe) :"
msgstr ""
"1. बनाए जाने वाले पहचान पत्र (हर टूल द्वारा, उसके अपने खाते से, बिना "
"पासवर्ड):"

msgid "aucune : chaque application choisie a déjà la sienne."
msgstr "कोई नहीं: हर चुने गए एप्लिकेशन के पास पहले से अपना पहचान पत्र है।"

msgid "2. Espace partagé (en administrateur, une commande après l'autre) :"
msgstr "2. साझा स्थान (एडमिन के रूप में, एक के बाद एक कमांड):"

#, python-brace-format
msgid "Recopier la carte d'identité de {root} (créée à l'étape 1)"
msgstr "{root} का पहचान पत्र कॉपी करें (चरण 1 में बनाया गया)"

msgid "rien : l'espace partagé est déjà à jour."
msgstr "कुछ नहीं: साझा स्थान पहले से अद्यतन है।"

msgid "Une commande qui n'est pas annoncée ici n'est jamais lancée."
msgstr "जो कमांड यहाँ नहीं बताई गई, वह कभी नहीं चलाई जाती।"

#, python-brace-format
msgid ""
"Arrêt : la carte d'identité de {root} n'a pas pu être créée ({error}). Rien "
"d'autre n'a été lancé."
msgstr ""
"रोका गया: {root} का पहचान पत्र नहीं बन सका ({error})। और कुछ नहीं चलाया गया।"

msgid "échec"
msgstr "विफल"

#, python-brace-format
msgid ""
"Arrêt avant l'espace partagé : le plan a changé ({step}). Rien de plus n'a "
"été lancé ; relancez la synchronisation pour voir le nouveau plan."
msgstr ""
"साझा स्थान से पहले रोका गया: योजना बदल गई ({step})। और कुछ नहीं चलाया गया; "
"नई योजना देखने के लिए सिंक्रनाइज़ेशन फिर से चलाएँ।"

#, python-brace-format
msgid ""
"Arrêt à l'étape « {step} » : {error}. Ce qui a été créé est noté ; relancez "
"la synchronisation après avoir corrigé la cause."
msgstr ""
"चरण « {step} » पर रोका गया: {error}। जो बनाया गया वह दर्ज है; कारण ठीक करने "
"के बाद सिंक्रनाइज़ेशन फिर से चलाएँ।"

msgid "Synchronisation terminée : les applications choisies sont reliées."
msgstr "सिंक्रनाइज़ेशन पूरा: चुने गए एप्लिकेशन जुड़ गए हैं।"

msgid "DÉMARRAGE RAPIDE"
msgstr "त्वरित शुरुआत"

msgid "RACCOURCIS"
msgstr "शॉर्टकट"

msgid "Aide d’omega-connect"
msgstr "omega-connect की सहायता"

msgid "Aide complète : chaque menu, sa fonction et le détail."
msgstr "पूरी सहायता: हर मेनू, उसका काम और विवरण।"

msgid "Démarrage rapide"
msgstr "त्वरित शुरुआत"

msgid "Raccourcis"
msgstr "शॉर्टकट"

msgid "Touche"
msgstr "कुंजी"

msgid "Action"
msgstr "एक्शन"

#, python-brace-format
msgid "OMEGA-CONNECT {version} — aide."
msgstr "OMEGA-CONNECT {version} — सहायता।"

msgid "Aide - Omega-Connect"
msgstr "सहायता - Omega-Connect"

msgid ""
"Interconnecteur de la suite omega : détecte les outils installés, vérifie et"
" attribue les droits entre eux."
msgstr ""
"omega सूट का इंटरकनेक्टर: इंस्टॉल किए गए टूल्स पहचानता है, उनके बीच "
"अनुमतियाँ जाँचता और देता है।"

msgid "commandes"
msgstr "कमांड"

msgid "COMMANDE"
msgstr "कमांड"

msgid "Cherche les outils omega installés (lecture seule, sans root)."
msgstr "इंस्टॉल किए गए omega टूल्स खोजता है (केवल पढ़ना, root के बिना)।"

msgid ""
"Cherche les outils omega installés : registre d'omega-serv, services systemd"
" / OpenRC / runit, HOME (3 niveaux), /srv (2 niveaux) et chemins saisis. Ne "
"suit jamais un lien symbolique ni un montage réseau. Lit le jeton de chaque "
"installation et demande sa fiche à l'outil, sous le compte propriétaire du "
"dossier."
msgstr ""
"इंस्टॉल किए गए omega टूल्स खोजता है: omega-serv का रजिस्टर, systemd / OpenRC"
" / runit सेवाएँ, HOME (3 स्तर), /srv (2 स्तर) और दर्ज किए गए पथ। कभी किसी "
"सिंबॉलिक लिंक या नेटवर्क माउंट का अनुसरण नहीं करता। हर इंस्टॉलेशन का टोकन "
"पढ़ता है और फ़ोल्डर के स्वामी खाते से टूल से उसका विवरण-पत्र माँगता है।"

msgid "DOSSIER"
msgstr "फ़ोल्डर"

msgid "Dossier d'installation à examiner en plus (option répétable)."
msgstr ""
"अतिरिक्त रूप से जाँचने के लिए इंस्टॉलेशन फ़ोल्डर (विकल्प दोहराया जा सकता "
"है)।"

msgid ""
"Ne demande pas la fiche aux outils (plus rapide, aucune commande lancée)."
msgstr "टूल्स से विवरण-पत्र नहीं माँगता (तेज़, कोई कमांड नहीं चलाई जाती)।"

msgid "texte (défaut, traduit) ou json (pour les scripts, jamais traduit)."
msgstr ""
"texte (डिफ़ॉल्ट, अनुवादित) या json (स्क्रिप्ट के लिए, कभी अनुवादित नहीं)।"

msgid "Vérifie les liens existants entre outils (lecture seule, sans root)."
msgstr "टूल्स के बीच मौजूदा लिंक जाँचता है (केवल पढ़ना, root के बिना)।"

msgid ""
"Détecte les outils (avec leur fiche), puis contrôle chaque lien : journaux "
"d'omega-serv et de magnet lus par les jails d'omega-jail, pont fail2ban vers"
" la liste noire, liste protégée, droits de la liste noire, fichiers d'omega-"
"jail dans fail2ban, jetons. Chaque écart affiche la commande qui le "
"corrigerait, sans jamais la lancer. Code de sortie : 0 sans écart, 1 si un "
"lien est cassé ou dégradé."
msgstr ""
"टूल्स पहचानता है (उनके विवरण-पत्र के साथ), फिर हर लिंक जाँचता है: omega-jail"
" के jails द्वारा पढ़े जाने वाले omega-serv और magnet के लॉग, ब्लैकलिस्ट तक "
"fail2ban ब्रिज, संरक्षित सूची, ब्लैकलिस्ट की अनुमतियाँ, fail2ban में omega-"
"jail की फ़ाइलें, टोकन। हर विसंगति के साथ उसे ठीक करने वाली कमांड दिखती है, "
"पर उसे कभी चलाया नहीं जाता। एग्ज़िट कोड: कोई विसंगति न हो तो 0, कोई लिंक "
"टूटा या कमज़ोर हो तो 1।"

msgid "Affiche aussi les contrôles conformes."
msgstr "अनुरूप जाँचें भी दिखाता है।"

msgid ""
"Ouvre le tableau de bord (défaut sans commande) : outils, liens et leur "
"état, en lecture seule."
msgstr ""
"डैशबोर्ड खोलता है (बिना कमांड के डिफ़ॉल्ट): टूल्स, लिंक और उनकी स्थिति, केवल"
" पढ़ने के लिए।"

msgid ""
"Tableau de bord en lecture seule : outils et instances, état de chaque lien,"
" contrôles et commandes de correction (jamais lancées). Nouvelle "
"vérification à intervalle régulier tant que l'écran est ouvert."
msgstr ""
"केवल पढ़ने वाला डैशबोर्ड: टूल्स और इंस्टेंस, हर लिंक की स्थिति, जाँचें और "
"सुधार कमांड (कभी चलाई नहीं जातीं)। जब तक स्क्रीन खुली है, नियमित अंतराल पर "
"फिर से जाँच।"

msgid ""
"Crée la zone neutre et y recopie jetons et fiches (root, après accord)."
msgstr ""
"तटस्थ क्षेत्र बनाता है और उसमें टोकन और विवरण-पत्र कॉपी करता है (root, सहमति"
" के बाद)।"

msgid ""
"Crée le groupe omega-synchro et la zone neutre (/var/lib/omega-synchro, "
"2750), vous ajoute au groupe, recopie le jeton et la fiche de chaque outil "
"détecté, et inscrit tout au registre. Relancée, elle actualise les copies. "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"omega-synchro समूह और तटस्थ क्षेत्र (/var/lib/omega-synchro, 2750) बनाता है,"
" आपको समूह में जोड़ता है, हर पहचाने गए टूल का टोकन और विवरण-पत्र कॉपी करता "
"है, और सब कुछ रजिस्टर में दर्ज करता है। दोबारा चलाने पर कॉपियाँ अद्यतन करता "
"है। हर कमांड sudo से चलाने से पहले दिखाई जाती है।"

msgid ""
"Défait ce qu'omega-connect a créé : un outil désinstallé, ou toute la zone "
"(root, après accord)."
msgstr ""
"omega-connect ने जो बनाया उसे पूर्ववत करता है: एक अनइंस्टॉल किया गया टूल, या"
" पूरा क्षेत्र (root, सहमति के बाद)।"

msgid ""
"« retirer CIBLE » enlève de la zone un outil désinstallé (nom, dossier ou 8 "
"premiers caractères de l'identifiant). « retirer --tout » défait exactement "
"ce que le registre liste, ou garde la zone telle quelle (liens figés). "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"« retirer लक्ष्य » क्षेत्र से एक अनइंस्टॉल किया गया टूल हटाता है (नाम, "
"फ़ोल्डर या ID के पहले 8 अक्षर)। « retirer --tout » ठीक वही पूर्ववत करता है "
"जो रजिस्टर में सूचीबद्ध है, या क्षेत्र को जैसा है वैसा रखता है (लिंक स्थिर)।"
" हर कमांड sudo से चलाने से पहले दिखाई जाती है।"

msgid "CIBLE"
msgstr "लक्ष्य"

msgid "Outil à retirer de la zone."
msgstr "क्षेत्र से हटाया जाने वाला टूल।"

msgid "Toute la zone (question : garder ou tout retirer)."
msgstr "पूरा क्षेत्र (प्रश्न: रखें या सब हटाएँ)।"

msgid "Avec --tout : garder la zone, liens figés (rien n'est supprimé)."
msgstr "--tout के साथ: क्षेत्र रखें, लिंक स्थिर (कुछ भी हटाया नहीं जाता)।"

msgid "Avec --tout : tout retirer, sans question."
msgstr "--tout के साथ: सब हटाएँ, बिना प्रश्न के।"

msgid ""
"Recherche les applications omega de cette machine et met à jour le registre "
"(lecture seule)."
msgstr ""
"इस मशीन के omega एप्लिकेशन खोजता है और रजिस्टर अपडेट करता है (केवल पढ़ना)।"

msgid ""
"Lecture seule, sans mot de passe : chaque application trouvée, son service "
"et son état (Détectée, Inscrite, Reliée, À réparer, Ancienne version, "
"Installation inachevée). Le résultat est enregistré dans le registre du parc"
" (var/parc.json)."
msgstr ""
"केवल पढ़ने के लिए, बिना पासवर्ड: मिला हर एप्लिकेशन, उसकी सेवा और उसकी स्थिति"
" (पहचानी गई, पंजीकृत, जुड़ी हुई, मरम्मत ज़रूरी, पुराना संस्करण, अधूरा "
"इंस्टॉलेशन)। परिणाम मशीनों के रजिस्टर (var/parc.json) में सहेजा जाता है।"

msgid "UTILISATEUR@MACHINE"
msgstr "उपयोगकर्ता@मशीन"

msgid ""
"Machine distante à scanner par SSH avec vos clés (rien n'y est installé) ; "
"sans cible : cette machine."
msgstr ""
"SSH द्वारा आपकी कुंजियों से स्कैन की जाने वाली दूरस्थ मशीन (वहाँ कुछ भी "
"इंस्टॉल नहीं होता); लक्ष्य के बिना: यह मशीन।"

msgid "MACHINE"
msgstr "MACHINE"

msgid ""
"Retire une machine distante du registre (nom, adresse ou "
"utilisateur@adresse) ; rien n'est modifié sur elle."
msgstr ""
"रजिस्टर से एक दूरस्थ मशीन हटाता है (नाम, पता या उपयोगकर्ता@पता); उस पर कुछ "
"भी नहीं बदला जाता।"

msgid ""
"Liste les machines que cet ordinateur sait déjà joindre (profils Unison, "
"~/.ssh/config, known_hosts)."
msgstr ""
"वे मशीनें दिखाता है जिन तक यह कंप्यूटर पहले से पहुँच सकता है (Unison "
"प्रोफ़ाइल, ~/.ssh/config, known_hosts)।"

msgid ""
"Remet en place les liens de ce qui est installé : cartes d'identité, espace "
"partagé, accès des services — un seul plan."
msgstr ""
"जो इंस्टॉल है उसके लिंक फिर से ठीक करता है: पहचान पत्र, साझा स्थान, सेवाओं "
"की पहुँच — एक ही योजना।"

msgid ""
"Une seule action (décision de l'auteur) : recrée les cartes d'identité qui "
"manquent (commande de chaque outil, sous son compte), prépare l'espace "
"partagé, y recopie les cartes et donne l'accès aux services. Tout est "
"affiché avant d'agir ; un seul mot de passe administrateur. Sans CIBLE : "
"toutes les applications de la machine."
msgstr ""
"एक ही क्रिया (लेखक का निर्णय): गायब पहचान पत्र फिर से बनाता है (हर टूल की "
"कमांड, उसके खाते से), साझा स्थान तैयार करता है, उसमें पहचान पत्र कॉपी करता "
"है और सेवाओं को पहुँच देता है। कार्रवाई से पहले सब दिखाया जाता है; एक ही "
"एडमिन पासवर्ड। लक्ष्य के बिना: मशीन के सभी एप्लिकेशन।"

msgid ""
"Application à synchroniser : nom (omega-fire) ou dossier ; plusieurs "
"possibles."
msgstr ""
"सिंक करने वाला एप्लिकेशन: नाम (omega-fire) या फ़ोल्डर; एक से अधिक संभव।"

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; option "
"répétable) : réparer puis synchroniser, sans rien taper là-bas (une "
"application trop ancienne : mettre-a-jour d'abord)."
msgstr ""
"पहले से स्कैन की गई दूरस्थ मशीन (नाम, पता या उपयोगकर्ता@मशीन; विकल्प दोहराया"
" जा सकता है): मरम्मत फिर सिंक, वहाँ कुछ भी टाइप किए बिना (बहुत पुराना "
"एप्लिकेशन: पहले mettre-a-jour)।"

msgid ""
"Toutes les machines distantes du registre, une à une (un mot de passe par "
"machine)."
msgstr "रजिस्टर की सभी दूरस्थ मशीनें, एक-एक करके (हर मशीन के लिए एक पासवर्ड)।"

msgid ""
"Met à jour les applications trop anciennes d'une machine distante, depuis "
"leur Release GitHub (rien d'autre)."
msgstr ""
"दूरस्थ मशीन के बहुत पुराने एप्लिकेशन उनकी GitHub Release से अपडेट करता है "
"(और कुछ नहीं)।"

msgid ""
"Archive prise sur GitHub, empreinte vérifiée avec sha.txt, puis installée "
"sur la machine (comme la section « Mise à jour » du README de l'outil). Ne "
"répare ni ne synchronise : voir synchroniser."
msgstr ""
"आर्काइव GitHub से लिया जाता है, sha.txt से फ़िंगरप्रिंट जाँचा जाता है, फिर "
"मशीन पर इंस्टॉल किया जाता है (टूल के README के « अपडेट » खंड की तरह)। मरम्मत"
" या सिंक नहीं करता: synchroniser देखें।"

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; "
"répétable)."
msgstr ""
"पहले से स्कैन की गई दूरस्थ मशीन (नाम, पता या उपयोगकर्ता@मशीन; दोहराया जा "
"सकता है)।"

msgid "Toutes les machines distantes du registre, une à une."
msgstr "रजिस्टर की सभी दूरस्थ मशीनें, एक-एक करके।"

msgid ""
"Corrige les écarts trouvés par verifier avec la commande de l'outil qui les "
"possède (root, après accord)."
msgstr ""
"verifier द्वारा मिली विसंगतियों को उनके स्वामी टूल की कमांड से ठीक करता है "
"(root, सहमति के बाद)।"

msgid ""
"Ne corrige que ce qu'un outil sait corriger lui-même (omega-jail --apply "
"--update, omega-serv service permissions, synchro jeton de chaque outil) et "
"ce que le registre de la zone dit qu'omega-connect a créé (plan d'etablir, "
"affiché à son tour). omega-connect ne réécrit jamais le fichier d'un autre "
"outil : le reste est affiché, à faire à la main. Chaque commande est "
"affichée avant d'être lancée."
msgstr ""
"केवल वही ठीक करता है जो कोई टूल स्वयं ठीक कर सकता है (omega-jail --apply "
"--update, omega-serv service permissions, हर टूल का synchro jeton) और जो "
"क्षेत्र का रजिस्टर बताता है कि omega-connect ने बनाया (etablir की योजना, "
"अपनी बारी में दिखाई जाती है)। omega-connect कभी किसी दूसरे टूल की फ़ाइल "
"दोबारा नहीं लिखता: बाकी दिखाया जाता है, हाथ से करना होगा। हर कमांड चलाने से "
"पहले दिखाई जाती है।"

msgid ""
"Machine distante déjà scannée : réparée depuis ici, rien à taper là-bas "
"(répétable)."
msgstr ""
"पहले से स्कैन की गई दूरस्थ मशीन: यहीं से मरम्मत, वहाँ कुछ टाइप नहीं करना "
"(दोहराया जा सकता है)।"

msgid ""
"Rapport complet : outils, jetons, fiches, liens et tous leurs contrôles, "
"zone et registre (lecture seule)."
msgstr ""
"पूरी रिपोर्ट: टूल्स, टोकन, विवरण-पत्र, लिंक और उनकी सभी जाँचें, क्षेत्र और "
"रजिस्टर (केवल पढ़ना)।"

msgid ""
"Tout ce qu'omega-connect sait à cet instant, en lecture seule et sans root :"
" outils et instances, jetons, fiches, chaque lien avec tous ses contrôles et"
" les commandes de correction, remarques de la recherche, zone neutre et son "
"registre. Affiché, ou enregistré dans var/exports/ avec --enregistrer."
msgstr ""
"इस समय omega-connect जो कुछ जानता है, केवल पढ़ने के लिए और root के बिना: "
"टूल्स और इंस्टेंस, टोकन, विवरण-पत्र, हर लिंक उसकी सभी जाँचों और सुधार कमांड "
"के साथ, खोज की टिप्पणियाँ, तटस्थ क्षेत्र और उसका रजिस्टर। दिखाया जाता है, या"
" --enregistrer के साथ var/exports/ में सेव किया जाता है।"

msgid ""
"texte (défaut, traduit), json (jamais traduit) ou html (page autonome)."
msgstr ""
"texte (डिफ़ॉल्ट, अनुवादित), json (कभी अनुवादित नहीं) या html (स्वतंत्र पेज)।"

msgid "Thème de la page HTML."
msgstr "HTML पेज की थीम।"

msgid "Enregistre dans var/exports/ au lieu d'afficher, et donne le chemin."
msgstr "दिखाने के बजाय var/exports/ में सेव करता है, और पथ बताता है।"

msgid "Affiche seulement les commandes, sans rien lancer."
msgstr "केवल कमांड दिखाता है, कुछ भी चलाए बिना।"

msgid "Lance sans demander l'accord (les commandes restent affichées)."
msgstr "सहमति माँगे बिना चलाता है (कमांड फिर भी दिखाई जाती हैं)।"

msgid ""
"Votre session n'a pas encore le groupe omega-synchro (il ne compte qu'après "
"une reconnexion) : lecture de la zone avec sudo (find, stat, cat)."
msgstr ""
"आपके सत्र में अभी omega-synchro समूह नहीं है (यह दोबारा लॉग इन करने के बाद "
"ही लागू होता है): क्षेत्र sudo से पढ़ा जा रहा है (find, stat, cat)।"

msgid "Authentification sudo refusée ou annulée : rien n'est fait."
msgstr "sudo प्रमाणीकरण अस्वीकृत या रद्द: कुछ नहीं किया गया।"

#, python-brace-format
msgid "Lancer ces {count} commande(s) en root ? [o/N] "
msgstr "ये {count} कमांड root के रूप में चलाएँ? [o/N] "

msgid "Authentification sudo refusée ou annulée : rien n'a été lancé."
msgstr "sudo प्रमाणीकरण अस्वीकृत या रद्द: कुछ भी नहीं चलाया गया।"

msgid ""
"Pas de terminal pour poser la question : relancez avec --garder-zone ou "
"--effacer."
msgstr ""
"प्रश्न पूछने के लिए कोई टर्मिनल नहीं: --garder-zone या --effacer के साथ फिर "
"से चलाएँ।"

msgid "Garder la zone (liens figés) [g], tout retirer [t], ou annuler [a] ? "
msgstr "क्षेत्र रखें (लिंक स्थिर) [g], सब हटाएँ [t], या रद्द करें [a]? "

msgid ""
"Pas de terminal pour demander l'accord : relancez avec --oui, ou "
"--simulation."
msgstr ""
"सहमति माँगने के लिए कोई टर्मिनल नहीं: --oui या --simulation के साथ फिर से "
"चलाएँ।"

msgid "Abandon : rien n'a été lancé."
msgstr "रद्द किया गया: कुछ भी नहीं चलाया गया।"

#, python-brace-format
msgid "Lancer ces {count} commande(s) ? [o/N] "
msgstr "ये {count} कमांड चलाएँ? [o/N] "

msgid ""
"Zone neutre : plan d'« etablir » (seulement ce que le registre dit avoir "
"créé)."
msgstr ""
"तटस्थ क्षेत्र: « etablir » की योजना (केवल वही जो रजिस्टर के अनुसार बनाया गया"
" था)।"

#, python-brace-format
msgid "Registre du parc non enregistré : {error}"
msgstr "मशीनों का रजिस्टर सेव नहीं हुआ: {error}"

msgid "Saisissez utilisateur@machine (nom ou adresse), sans espace ni option."
msgstr "उपयोगकर्ता@मशीन (नाम या पता) दर्ज करें, बिना स्पेस या विकल्प के।"

msgid "Pas de terminal pour demander la confiance : rien n'a été fait."
msgstr "भरोसे की पुष्टि माँगने के लिए कोई टर्मिनल नहीं: कुछ नहीं किया गया।"

msgid "Faire confiance à cette machine ? [o/N] "
msgstr "इस मशीन पर भरोसा करें? [o/N] "

msgid "Rien n'a été fait."
msgstr "कुछ नहीं किया गया।"

msgid "Impossible d'ajouter la clé à ~/.ssh/known_hosts."
msgstr "कुंजी ~/.ssh/known_hosts में नहीं जोड़ी जा सकी।"

#, python-brace-format
msgid "Aucune application ne correspond à : {targets}"
msgstr "कोई एप्लिकेशन मेल नहीं खाता: {targets}"

msgid "Lancer ce plan ? [o/N] "
msgstr "यह योजना चलाएँ? [o/N] "

msgid "Authentification refusée ou annulée : rien n'a été lancé."
msgstr "प्रमाणीकरण अस्वीकृत या रद्द: कुछ भी नहीं चलाया गया।"

#, python-brace-format
msgid "Machine inconnue ou mal écrite : {target}"
msgstr "अज्ञात या गलत लिखी मशीन: {target}"

msgid ""
"Aucune machine distante dans le registre : scannez-en une d'abord (scanner "
"utilisateur@machine)."
msgstr ""
"रजिस्टर में कोई दूरस्थ मशीन नहीं: पहले एक स्कैन करें (scanner "
"उपयोगकर्ता@मशीन)।"

#, python-brace-format
msgid ""
"{target} : clé de la machine pas encore acceptée, ou machine injoignable — "
