#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — máy {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== Cập nhật {tool} lên {version} ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ Đã cài đặt {tool} {version}."

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· đã thiết lập sẵn: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "từ chối bản lưu trữ: đường dẫn không mong đợi {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr "từ chối bản lưu trữ: {name} không phải tệp cũng không phải thư mục"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "từ chối bản lưu trữ: quá lớn sau khi giải nén"

#, python-brace-format
msgid "archive refusée : pas de dossier {tool}/"
msgstr "từ chối bản lưu trữ: không có thư mục {tool}/"

#, python-brace-format
msgid "{path} est un lien : rien n'est copié dedans"
msgstr "{path} là một liên kết: không sao chép gì vào đó"

#, python-brace-format
msgid "{root} n'est pas un dossier d'installation"
msgstr "{root} không phải thư mục cài đặt"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} không thuộc tài khoản này: hãy cập nhật thủ công"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr "mã băm của bản lưu trữ khác với sha.txt: không cài đặt gì"

#, python-brace-format
msgid "Mise de côté de l'ancienne installation : {old} → {new}"
msgstr "Cất bản cài đặt cũ sang một bên: {old} → {new}"

msgid "impossible de mettre l'ancienne installation de côté (sudo mv)"
msgstr "không thể cất bản cài đặt cũ sang một bên (sudo mv)"

#, python-brace-format
msgid "{count} fichiers installés dans {root}."
msgstr "Đã cài {count} tệp vào {root}."

#, python-brace-format
msgid "install.sh introuvable dans {root}"
msgstr "không tìm thấy install.sh trong {root}"

#, python-brace-format
msgid ""
"Environnement Python (.venv) incomplet mis de côté : {path} — install.sh en "
"recrée un."
msgstr ""
"Môi trường Python (.venv) chưa hoàn chỉnh đã được cất sang một bên: {path} —"
" install.sh sẽ tạo lại."

#, python-brace-format
msgid "Lancement de {path} :"
msgstr "Đang chạy {path}:"

#, python-brace-format
msgid "install.sh a échoué (code {code})"
msgstr "install.sh thất bại (mã {code})"

#, python-brace-format
msgid "{script} introuvable : réglages et données restés dans {old}"
msgstr "không tìm thấy {script}: thiết lập và dữ liệu vẫn nằm trong {old}"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"Lấy lại thiết lập và dữ liệu từ {old} (các bản cài đặt cũ khác bị bỏ qua: "
"{others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "lấy lại từ {old} thất bại ({script})"

msgid "contient l'installation d'omega-connect"
msgstr "chứa bản cài đặt của omega-connect"

msgid "registre omega-serv"
msgstr "sổ đăng ký omega-serv"

msgid "systemd"
msgstr "systemd"

msgid "OpenRC"
msgstr "OpenRC"

msgid "runit"
msgstr "runit"

msgid "dossier personnel"
msgstr "thư mục cá nhân"

msgid "/srv"
msgstr "/srv"

msgid "chemin saisi"
msgstr "đường dẫn đã nhập"

msgid "absent"
msgstr "không có"

msgid "illisible (droits)"
msgstr "không đọc được (quyền)"

msgid "abîmé"
msgstr "bị hỏng"

msgid "d'une version plus récente qu'omega-connect"
msgstr "từ phiên bản mới hơn omega-connect"

msgid "non fournie (version de l'outil trop ancienne ?)"
msgstr "không được cung cấp (phiên bản công cụ quá cũ?)"

msgid "non obtenue"
msgstr "không lấy được"

msgid "illisible"
msgstr "không đọc được"

msgid "active"
msgstr "hoạt động"

msgid "désactivée"
msgstr "đã tắt"

msgid "absente"
msgstr "không có"

msgid "inconnue"
msgstr "không xác định"

#, python-brace-format
msgid "registre des instances omega-serv illisible : {detail}"
msgstr "không đọc được sổ đăng ký instance omega-serv: {detail}"

#, python-brace-format
msgid "instance omega-serv enregistrée mais dossier disparu : {detail}"
msgstr "instance omega-serv đã đăng ký nhưng thư mục đã biến mất: {detail}"

#, python-brace-format
msgid "fichier de service illisible : {detail}"
msgstr "không đọc được tệp dịch vụ: {detail}"

#, python-brace-format
msgid "service {detail} : dossier d'installation introuvable"
msgstr "dịch vụ {detail}: không tìm thấy thư mục cài đặt"

#, python-brace-format
msgid "recherche arrêtée (trop de dossiers) dans {detail}"
msgstr "đã dừng tìm kiếm (quá nhiều thư mục) trong {detail}"

#, python-brace-format
msgid "montage réseau non parcouru : {detail}"
msgstr "không duyệt ổ gắn mạng: {detail}"

#, python-brace-format
msgid "dossier introuvable : {detail}"
msgstr "không tìm thấy thư mục: {detail}"

#, python-brace-format
msgid "aucun outil omega dans : {detail}"
msgstr "không có công cụ omega nào trong: {detail}"

#, python-brace-format
msgid "créez-le sous le compte {owner} : {command}"
msgstr "hãy tạo nó dưới tài khoản {owner}: {command}"

msgid "outil inconnu"
msgstr "công cụ không xác định"

#, python-brace-format
msgid "trouvé par : {sources}"
msgstr "tìm thấy qua: {sources}"

#, python-brace-format
msgid "propriétaire : {owner}"
msgstr "chủ sở hữu: {owner}"

#, python-brace-format
msgid "service : {names}"
msgstr "dịch vụ: {names}"

#, python-brace-format
msgid "jeton : présent (identifiant {identifier}, version {version})"
msgstr "token: có (định danh {identifier}, phiên bản {version})"

#, python-brace-format
msgid "jeton : {state}"
msgstr "token: {state}"

#, python-brace-format
msgid "fiche : {state}"
msgstr "phiếu mô tả: {state}"

#, python-brace-format
msgid "détail technique : {detail}"
msgstr "chi tiết kỹ thuật: {detail}"

#, python-brace-format
msgid "fiche : instance {instance}"
msgstr "phiếu mô tả: instance {instance}"

#, python-brace-format
msgid "service {manager} ({state})"
msgstr "dịch vụ {manager} ({state})"

msgid "partielle (sans root)"
msgstr "một phần (không có root)"

#, python-brace-format
msgid "fonctions : {states}"
msgstr "chức năng: {states}"

#, python-brace-format
msgid "Détection des outils omega (HOME examiné : {home})"
msgstr "Phát hiện công cụ omega (HOME được xem xét: {home})"

msgid "Aucun outil omega trouvé. Indiquez un dossier avec --chemin."
msgstr ""
"Không tìm thấy công cụ omega nào. Hãy chỉ định một thư mục bằng --chemin."

#, python-brace-format
msgid ""
"Identifiant en double {identifier} : {roots} (dossier copié à la main ?). "
"Ces installations ne sont pas fusionnées ; ouvrez la copie une fois pour lui"
" donner un nouvel identifiant."
msgstr ""
"Định danh trùng lặp {identifier}: {roots} (thư mục bị sao chép thủ công?). "
"Các bản cài đặt này không được gộp lại; hãy mở bản sao một lần để nó nhận "
"định danh mới."

msgid "Remarques sur la recherche :"
msgstr "Ghi chú về việc tìm kiếm:"

#, python-brace-format
msgid "{count} installation(s) trouvée(s)."
msgstr "Tìm thấy {count} bản cài đặt."

msgid "Détectée"
msgstr "Đã phát hiện"

msgid "Inscrite"
msgstr "Đã đăng ký"

msgid "Reliée"
msgstr "Đã liên kết"

msgid "À réparer"
msgstr "Cần sửa"

msgid "Ancienne version"
msgstr "Phiên bản cũ"

msgid "Installation inachevée"
msgstr "Cài đặt dở dang"

msgid "Injoignable"
msgstr "Không liên lạc được"

msgid "trouvée, sans carte d'identité : la Synchronisation la lui crée"
msgstr "đã tìm thấy, chưa có thẻ định danh: Đồng bộ hóa sẽ tạo cho nó"

msgid ""
"a sa carte d'identité, pas encore dans l'espace partagé : la Synchronisation"
" l'y ajoute"
msgstr ""
"đã có thẻ định danh, chưa có trong không gian chia sẻ: Đồng bộ hóa sẽ thêm "
"vào"

msgid "dans l'espace partagé, à jour"
msgstr "có trong không gian chia sẻ, đã cập nhật"

msgid "un écart : Réparer le corrige"
msgstr "có một sai lệch: Sửa chữa sẽ khắc phục"

msgid "trop ancienne pour avoir une carte d'identité : mettez-la à jour"
msgstr "quá cũ để có thẻ định danh: hãy cập nhật"

msgid ""
"installée, mais son install.sh ne s'est pas terminé (environnement Python ou"
" carte d'identité manquants) : « Réinstaller l'application » (Registre)"
msgstr ""
"đã cài đặt, nhưng install.sh của nó chưa chạy xong (thiếu môi trường Python "
"hoặc thẻ định danh): “Cài đặt lại ứng dụng” (Sổ đăng ký)"

msgid "machine qui ne répond pas"
msgstr "máy không phản hồi"

#, python-brace-format
msgid ""
"trop ancienne pour avoir une carte d'identité : {tool} {version} ou plus "
"récent requis (machine distante : Synchronisation la met à jour depuis "
"GitHub)"
msgstr ""
"quá cũ để có thẻ định danh: cần {tool} {version} hoặc mới hơn (máy từ xa: "
"Đồng bộ hóa sẽ cập nhật từ GitHub)"

msgid "pas encore préparé — la Synchronisation le prépare"
msgstr "chưa được chuẩn bị — Đồng bộ hóa sẽ chuẩn bị"

msgid "prêt"
msgstr "sẵn sàng"

msgid "à corriger — la Synchronisation le remet en état"
msgstr "cần chỉnh lại — Đồng bộ hóa sẽ khôi phục"

msgid "prêt (lu avec votre autorisation)"
msgstr "sẵn sàng (đọc với sự cho phép của bạn)"

msgid ""
"état inconnu depuis cette session — la Synchronisation le lira avec votre "
"autorisation"
msgstr ""
"trạng thái chưa biết trong phiên này — Đồng bộ hóa sẽ đọc với sự cho phép "
"của bạn"

#, python-brace-format
msgid "Registre — machine {machine}"
msgstr "Sổ đăng ký — máy {machine}"

msgid "Aucune application omega trouvée sur cette machine."
msgstr "Không tìm thấy ứng dụng omega nào trên máy này."

#, python-brace-format
msgid "Espace partagé : {status}"
msgstr "Không gian chia sẻ: {status}"

msgid "Synchroniser : un seul plan, un seul mot de passe administrateur"
msgstr "Đồng bộ: một kế hoạch duy nhất, một mật khẩu quản trị duy nhất"

msgid "Rien à faire : tout est déjà synchronisé."
msgstr "Không có gì để làm: mọi thứ đã được đồng bộ."

msgid ""
"1. Cartes d'identité à créer (par chaque outil, sous son compte, sans mot de"
" passe) :"
msgstr ""
"1. Thẻ định danh cần tạo (bởi từng công cụ, dưới tài khoản của nó, không cần"
" mật khẩu):"

msgid "aucune : chaque application choisie a déjà la sienne."
msgstr "không có: mỗi ứng dụng đã chọn đều đã có thẻ của mình."

msgid "2. Espace partagé (en administrateur, une commande après l'autre) :"
msgstr "2. Không gian chia sẻ (với quyền quản trị, từng lệnh một):"

#, python-brace-format
msgid "Recopier la carte d'identité de {root} (créée à l'étape 1)"
msgstr "Sao chép thẻ định danh của {root} (đã tạo ở bước 1)"

msgid "rien : l'espace partagé est déjà à jour."
msgstr "không có gì: không gian chia sẻ đã được cập nhật."

msgid "Une commande qui n'est pas annoncée ici n'est jamais lancée."
msgstr "Lệnh nào không được thông báo ở đây sẽ không bao giờ được chạy."

#, python-brace-format
msgid ""
"Arrêt : la carte d'identité de {root} n'a pas pu être créée ({error}). Rien "
"d'autre n'a été lancé."
msgstr ""
"Dừng: không thể tạo thẻ định danh của {root} ({error}). Không có gì khác "
"được chạy."

msgid "échec"
msgstr "thất bại"

#, python-brace-format
msgid ""
"Arrêt avant l'espace partagé : le plan a changé ({step}). Rien de plus n'a "
"été lancé ; relancez la synchronisation pour voir le nouveau plan."
msgstr ""
"Dừng trước không gian chia sẻ: kế hoạch đã thay đổi ({step}). Không chạy "
"thêm gì; hãy chạy lại đồng bộ để xem kế hoạch mới."

#, python-brace-format
msgid ""
"Arrêt à l'étape « {step} » : {error}. Ce qui a été créé est noté ; relancez "
"la synchronisation après avoir corrigé la cause."
msgstr ""
"Dừng ở bước “{step}”: {error}. Những gì đã tạo đều được ghi lại; hãy chạy "
"lại đồng bộ sau khi khắc phục nguyên nhân."

msgid "Synchronisation terminée : les applications choisies sont reliées."
msgstr "Đồng bộ hoàn tất: các ứng dụng đã chọn đã được liên kết."

msgid "DÉMARRAGE RAPIDE"
msgstr "BẮT ĐẦU NHANH"

msgid "RACCOURCIS"
msgstr "PHÍM TẮT"

msgid "Aide d’omega-connect"
msgstr "Trợ giúp omega-connect"

msgid "Aide complète : chaque menu, sa fonction et le détail."
msgstr "Trợ giúp đầy đủ: từng menu, chức năng và chi tiết."

msgid "Démarrage rapide"
msgstr "Bắt đầu nhanh"

msgid "Raccourcis"
msgstr "Phím tắt"

msgid "Touche"
msgstr "Phím"

msgid "Action"
msgstr "Hành động"

#, python-brace-format
msgid "OMEGA-CONNECT {version} — aide."
msgstr "OMEGA-CONNECT {version} — trợ giúp."

msgid "Aide - Omega-Connect"
msgstr "Trợ giúp - Omega-Connect"

msgid ""
"Interconnecteur de la suite omega : détecte les outils installés, vérifie et"
" attribue les droits entre eux."
msgstr ""
"Bộ kết nối của bộ công cụ omega: phát hiện các công cụ đã cài, kiểm tra và "
"cấp quyền giữa chúng."

msgid "commandes"
msgstr "các lệnh"

msgid "COMMANDE"
msgstr "LỆNH"

msgid "Cherche les outils omega installés (lecture seule, sans root)."
msgstr "Tìm các công cụ omega đã cài (chỉ đọc, không cần root)."

msgid ""
"Cherche les outils omega installés : registre d'omega-serv, services systemd"
" / OpenRC / runit, HOME (3 niveaux), /srv (2 niveaux) et chemins saisis. Ne "
"suit jamais un lien symbolique ni un montage réseau. Lit le jeton de chaque "
"installation et demande sa fiche à l'outil, sous le compte propriétaire du "
"dossier."
msgstr ""
"Tìm các công cụ omega đã cài: sổ đăng ký của omega-serv, dịch vụ systemd / "
"OpenRC / runit, HOME (3 cấp), /srv (2 cấp) và các đường dẫn đã nhập. Không "
"bao giờ đi theo liên kết tượng trưng hay ổ gắn mạng. Đọc token của từng bản "
"cài đặt và yêu cầu công cụ cung cấp phiếu mô tả, dưới tài khoản sở hữu thư "
"mục."

msgid "DOSSIER"
msgstr "THƯ MỤC"

msgid "Dossier d'installation à examiner en plus (option répétable)."
msgstr "Thư mục cài đặt cần xem xét thêm (tùy chọn có thể lặp lại)."

msgid ""
"Ne demande pas la fiche aux outils (plus rapide, aucune commande lancée)."
msgstr ""
"Không yêu cầu phiếu mô tả từ các công cụ (nhanh hơn, không chạy lệnh nào)."

msgid "texte (défaut, traduit) ou json (pour les scripts, jamais traduit)."
msgstr ""
"văn bản (mặc định, được dịch) hoặc json (cho script, không bao giờ dịch)."

msgid "Vérifie les liens existants entre outils (lecture seule, sans root)."
msgstr ""
"Kiểm tra các liên kết hiện có giữa các công cụ (chỉ đọc, không cần root)."

msgid ""
"Détecte les outils (avec leur fiche), puis contrôle chaque lien : journaux "
"d'omega-serv et de magnet lus par les jails d'omega-jail, pont fail2ban vers"
" la liste noire, liste protégée, droits de la liste noire, fichiers d'omega-"
"jail dans fail2ban, jetons. Chaque écart affiche la commande qui le "
"corrigerait, sans jamais la lancer. Code de sortie : 0 sans écart, 1 si un "
"lien est cassé ou dégradé."
msgstr ""
"Phát hiện các công cụ (kèm phiếu mô tả), rồi kiểm tra từng liên kết: nhật ký"
" của omega-serv và magnet được các jail của omega-jail đọc, cầu nối fail2ban"
" tới danh sách đen, danh sách được bảo vệ, quyền của danh sách đen, tệp của "
"omega-jail trong fail2ban, token. Mỗi sai lệch hiển thị lệnh để khắc phục, "
"nhưng không bao giờ chạy lệnh đó. Mã thoát: 0 nếu không có sai lệch, 1 nếu "
"một liên kết bị hỏng hoặc suy giảm."

msgid "Affiche aussi les contrôles conformes."
msgstr "Hiển thị cả các mục kiểm tra đạt."

msgid ""
"Ouvre le tableau de bord (défaut sans commande) : outils, liens et leur "
"état, en lecture seule."
msgstr ""
"Mở bảng điều khiển (mặc định khi không có lệnh): công cụ, liên kết và trạng "
"thái của chúng, chỉ đọc."

msgid ""
"Tableau de bord en lecture seule : outils et instances, état de chaque lien,"
" contrôles et commandes de correction (jamais lancées). Nouvelle "
"vérification à intervalle régulier tant que l'écran est ouvert."
msgstr ""
"Bảng điều khiển chỉ đọc: công cụ và instance, trạng thái từng liên kết, các "
"mục kiểm tra và lệnh khắc phục (không bao giờ được chạy). Tự kiểm tra lại "
"định kỳ khi màn hình còn mở."

msgid ""
"Crée la zone neutre et y recopie jetons et fiches (root, après accord)."
msgstr ""
"Tạo vùng trung lập và sao chép token cùng phiếu mô tả vào đó (root, sau khi "
"bạn đồng ý)."

msgid ""
"Crée le groupe omega-synchro et la zone neutre (/var/lib/omega-synchro, "
"2750), vous ajoute au groupe, recopie le jeton et la fiche de chaque outil "
"détecté, et inscrit tout au registre. Relancée, elle actualise les copies. "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"Tạo nhóm omega-synchro và vùng trung lập (/var/lib/omega-synchro, 2750), "
"thêm bạn vào nhóm, sao chép token và phiếu mô tả của từng công cụ đã phát "
"hiện, rồi ghi tất cả vào sổ đăng ký. Khi chạy lại, nó cập nhật các bản sao. "
"Mỗi lệnh được hiển thị trước khi chạy bằng sudo."

msgid ""
"Défait ce qu'omega-connect a créé : un outil désinstallé, ou toute la zone "
"(root, après accord)."
msgstr ""
"Hoàn tác những gì omega-connect đã tạo: một công cụ đã gỡ cài đặt, hoặc toàn"
" bộ vùng (root, sau khi bạn đồng ý)."

msgid ""
"« retirer CIBLE » enlève de la zone un outil désinstallé (nom, dossier ou 8 "
"premiers caractères de l'identifiant). « retirer --tout » défait exactement "
"ce que le registre liste, ou garde la zone telle quelle (liens figés). "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"“retirer CIBLE” gỡ khỏi vùng một công cụ đã gỡ cài đặt (tên, thư mục hoặc 8 "
"ký tự đầu của định danh). “retirer --tout” hoàn tác đúng những gì sổ đăng ký"
" liệt kê, hoặc giữ nguyên vùng (liên kết bị đóng băng). Mỗi lệnh được hiển "
"thị trước khi chạy bằng sudo."

msgid "CIBLE"
msgstr "ĐÍCH"

msgid "Outil à retirer de la zone."
msgstr "Công cụ cần gỡ khỏi vùng."

msgid "Toute la zone (question : garder ou tout retirer)."
msgstr "Toàn bộ vùng (hỏi: giữ lại hay gỡ tất cả)."

msgid "Avec --tout : garder la zone, liens figés (rien n'est supprimé)."
msgstr "Với --tout: giữ vùng, liên kết bị đóng băng (không xóa gì)."

msgid "Avec --tout : tout retirer, sans question."
msgstr "Với --tout: gỡ tất cả, không hỏi."

msgid ""
"Recherche les applications omega de cette machine et met à jour le registre "
"(lecture seule)."
msgstr "Tìm các ứng dụng omega trên máy này và cập nhật sổ đăng ký (chỉ đọc)."

msgid ""
"Lecture seule, sans mot de passe : chaque application trouvée, son service "
"et son état (Détectée, Inscrite, Reliée, À réparer, Ancienne version, "
"Installation inachevée). Le résultat est enregistré dans le registre du parc"
" (var/parc.json)."
msgstr ""
"Chỉ đọc, không cần mật khẩu: mỗi ứng dụng được tìm thấy, dịch vụ và trạng "
"thái của nó (Đã phát hiện, Đã đăng ký, Đã liên kết, Cần sửa, Phiên bản cũ, "
"Cài đặt dở dang). Kết quả được lưu trong sổ đăng ký các máy (var/parc.json)."

msgid "UTILISATEUR@MACHINE"
msgstr "NGƯỜI_DÙNG@MÁY"

msgid ""
"Machine distante à scanner par SSH avec vos clés (rien n'y est installé) ; "
"sans cible : cette machine."
msgstr ""
"Máy từ xa cần quét qua SSH bằng khóa của bạn (không cài gì lên đó); không có"
" đích: máy này."

msgid "MACHINE"
msgstr "MACHINE"

msgid ""
"Retire une machine distante du registre (nom, adresse ou "
"utilisateur@adresse) ; rien n'est modifié sur elle."
msgstr ""
"Gỡ một máy từ xa khỏi sổ đăng ký (tên, địa chỉ hoặc người_dùng@địa_chỉ); "
"không thay đổi gì trên máy đó."

msgid ""
"Liste les machines que cet ordinateur sait déjà joindre (profils Unison, "
"~/.ssh/config, known_hosts)."
msgstr ""
"Liệt kê các máy mà máy tính này đã biết cách kết nối (hồ sơ Unison, "
"~/.ssh/config, known_hosts)."

msgid ""
"Remet en place les liens de ce qui est installé : cartes d'identité, espace "
"partagé, accès des services — un seul plan."
msgstr ""
"Khôi phục liên kết cho những gì đã cài: thẻ định danh, không gian chia sẻ, "
"quyền truy cập của dịch vụ — một kế hoạch duy nhất."

msgid ""
"Une seule action (décision de l'auteur) : recrée les cartes d'identité qui "
"manquent (commande de chaque outil, sous son compte), prépare l'espace "
"partagé, y recopie les cartes et donne l'accès aux services. Tout est "
"affiché avant d'agir ; un seul mot de passe administrateur. Sans CIBLE : "
"toutes les applications de la machine."
msgstr ""
"Một hành động duy nhất (quyết định của tác giả): tạo lại các thẻ định danh "
"còn thiếu (bằng lệnh của từng công cụ, dưới tài khoản của nó), chuẩn bị "
"không gian chia sẻ, sao chép thẻ vào đó và cấp quyền truy cập cho các dịch "
"vụ. Mọi thứ được hiển thị trước khi thực hiện; chỉ một mật khẩu quản trị. "
"Không có ĐÍCH: tất cả ứng dụng trên máy."

msgid ""
"Application à synchroniser : nom (omega-fire) ou dossier ; plusieurs "
"possibles."
msgstr "Ứng dụng cần đồng bộ: tên (omega-fire) hoặc thư mục; có thể nhiều."

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; option "
"répétable) : réparer puis synchroniser, sans rien taper là-bas (une "
"application trop ancienne : mettre-a-jour d'abord)."
msgstr ""
"Máy từ xa đã quét (tên, địa chỉ hoặc người_dùng@máy; tùy chọn có thể lặp "
"lại): sửa chữa rồi đồng bộ, không cần gõ gì trên máy đó (ứng dụng quá cũ: "
"chạy mettre-a-jour trước)."

msgid ""
"Toutes les machines distantes du registre, une à une (un mot de passe par "
"machine)."
msgstr ""
"Tất cả máy từ xa trong sổ đăng ký, lần lượt từng máy (mỗi máy một mật khẩu)."

msgid ""
"Met à jour les applications trop anciennes d'une machine distante, depuis "
"leur Release GitHub (rien d'autre)."
msgstr ""
"Cập nhật các ứng dụng quá cũ của một máy từ xa, từ bản Release GitHub của "
"chúng (không làm gì khác)."

msgid ""
"Archive prise sur GitHub, empreinte vérifiée avec sha.txt, puis installée "
"sur la machine (comme la section « Mise à jour » du README de l'outil). Ne "
"répare ni ne synchronise : voir synchroniser."
msgstr ""
"Bản lưu trữ lấy từ GitHub, mã băm được kiểm tra với sha.txt, rồi được cài "
"lên máy (như phần “Cập nhật” trong README của công cụ). Không sửa chữa cũng "
"không đồng bộ: xem synchroniser."

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; "
"répétable)."
msgstr "Máy từ xa đã quét (tên, địa chỉ hoặc người_dùng@máy; có thể lặp lại)."

msgid "Toutes les machines distantes du registre, une à une."
msgstr "Tất cả máy từ xa trong sổ đăng ký, lần lượt từng máy."

msgid ""
"Corrige les écarts trouvés par verifier avec la commande de l'outil qui les "
"possède (root, après accord)."
msgstr ""
"Khắc phục các sai lệch mà verifier tìm thấy bằng lệnh của công cụ sở hữu "
"chúng (root, sau khi bạn đồng ý)."

msgid ""
"Ne corrige que ce qu'un outil sait corriger lui-même (omega-jail --apply "
"--update, omega-serv service permissions, synchro jeton de chaque outil) et "
"ce que le registre de la zone dit qu'omega-connect a créé (plan d'etablir, "
"affiché à son tour). omega-connect ne réécrit jamais le fichier d'un autre "
"outil : le reste est affiché, à faire à la main. Chaque commande est "
"affichée avant d'être lancée."
msgstr ""
"Chỉ khắc phục những gì một công cụ tự biết khắc phục (omega-jail --apply "
"--update, omega-serv service permissions, synchro jeton của từng công cụ) và"
" những gì sổ đăng ký của vùng ghi là do omega-connect tạo (kế hoạch của "
"etablir, được hiển thị lần lượt). omega-connect không bao giờ ghi đè tệp của"
" công cụ khác: phần còn lại được hiển thị để làm thủ công. Mỗi lệnh được "
"hiển thị trước khi chạy."

msgid ""
"Machine distante déjà scannée : réparée depuis ici, rien à taper là-bas "
"(répétable)."
msgstr ""
"Máy từ xa đã quét: được sửa chữa từ đây, không cần gõ gì trên máy đó (có thể"
" lặp lại)."

msgid ""
"Rapport complet : outils, jetons, fiches, liens et tous leurs contrôles, "
"zone et registre (lecture seule)."
msgstr ""
"Báo cáo đầy đủ: công cụ, token, phiếu mô tả, liên kết và mọi mục kiểm tra, "
"vùng và sổ đăng ký (chỉ đọc)."

msgid ""
"Tout ce qu'omega-connect sait à cet instant, en lecture seule et sans root :"
" outils et instances, jetons, fiches, chaque lien avec tous ses contrôles et"
" les commandes de correction, remarques de la recherche, zone neutre et son "
"registre. Affiché, ou enregistré dans var/exports/ avec --enregistrer."
msgstr ""
"Mọi điều omega-connect biết tại thời điểm này, chỉ đọc và không cần root: "
"công cụ và instance, token, phiếu mô tả, từng liên kết với mọi mục kiểm tra "
"và lệnh khắc phục, ghi chú về việc tìm kiếm, vùng trung lập và sổ đăng ký "
"của nó. Hiển thị, hoặc lưu vào var/exports/ với --enregistrer."

msgid ""
"texte (défaut, traduit), json (jamais traduit) ou html (page autonome)."
msgstr ""
"văn bản (mặc định, được dịch), json (không bao giờ dịch) hoặc html (trang "
"độc lập)."

msgid "Thème de la page HTML."
msgstr "Giao diện của trang HTML."

msgid "Enregistre dans var/exports/ au lieu d'afficher, et donne le chemin."
msgstr "Lưu vào var/exports/ thay vì hiển thị, và cho biết đường dẫn."

msgid "Affiche seulement les commandes, sans rien lancer."
msgstr "Chỉ hiển thị các lệnh, không chạy gì."

msgid "Lance sans demander l'accord (les commandes restent affichées)."
msgstr "Chạy mà không hỏi ý kiến (các lệnh vẫn được hiển thị)."

msgid ""
"Votre session n'a pas encore le groupe omega-synchro (il ne compte qu'après "
"une reconnexion) : lecture de la zone avec sudo (find, stat, cat)."
msgstr ""
"Phiên của bạn chưa có nhóm omega-synchro (nhóm chỉ có hiệu lực sau khi đăng "
"nhập lại): đọc vùng bằng sudo (find, stat, cat)."

msgid "Authentification sudo refusée ou annulée : rien n'est fait."
msgstr "Xác thực sudo bị từ chối hoặc bị hủy: không làm gì cả."

#, python-brace-format
msgid "Lancer ces {count} commande(s) en root ? [o/N] "
msgstr "Chạy {count} lệnh này với quyền root? [y/N] "

msgid "Authentification sudo refusée ou annulée : rien n'a été lancé."
msgstr "Xác thực sudo bị từ chối hoặc bị hủy: không chạy gì cả."

msgid ""
"Pas de terminal pour poser la question : relancez avec --garder-zone ou "
"--effacer."
msgstr ""
"Không có terminal để hỏi: hãy chạy lại với --garder-zone hoặc --effacer."

msgid "Garder la zone (liens figés) [g], tout retirer [t], ou annuler [a] ? "
msgstr "Giữ vùng (liên kết bị đóng băng) [g], gỡ tất cả [t], hoặc hủy [a]? "

msgid ""
"Pas de terminal pour demander l'accord : relancez avec --oui, ou "
"--simulation."
msgstr ""
"Không có terminal để hỏi ý kiến: hãy chạy lại với --oui, hoặc --simulation."

msgid "Abandon : rien n'a été lancé."
msgstr "Đã hủy: không chạy gì cả."

#, python-brace-format
msgid "Lancer ces {count} commande(s) ? [o/N] "
msgstr "Chạy {count} lệnh này? [y/N] "

msgid ""
"Zone neutre : plan d'« etablir » (seulement ce que le registre dit avoir "
"créé)."
msgstr ""
"Vùng trung lập: kế hoạch “etablir” (chỉ những gì sổ đăng ký ghi là đã tạo)."

#, python-brace-format
msgid "Registre du parc non enregistré : {error}"
msgstr "Chưa lưu được sổ đăng ký các máy: {error}"

msgid "Saisissez utilisateur@machine (nom ou adresse), sans espace ni option."
msgstr ""
"Hãy nhập người_dùng@máy (tên hoặc địa chỉ), không có dấu cách hay tùy chọn."

msgid "Pas de terminal pour demander la confiance : rien n'a été fait."
msgstr "Không có terminal để hỏi về độ tin cậy: không làm gì cả."

msgid "Faire confiance à cette machine ? [o/N] "
msgstr "Tin cậy máy này? [y/N] "

msgid "Rien n'a été fait."
msgstr "Không làm gì cả."

msgid "Impossible d'ajouter la clé à ~/.ssh/known_hosts."
msgstr "Không thể thêm khóa vào ~/.ssh/known_hosts."

#, python-brace-format
msgid "Aucune application ne correspond à : {targets}"
msgstr "Không có ứng dụng nào khớp với: {targets}"

msgid "Lancer ce plan ? [o/N] "
msgstr "Chạy kế hoạch này? [y/N] "

msgid "Authentification refusée ou annulée : rien n'a été lancé."
msgstr "Xác thực bị từ chối hoặc bị hủy: không chạy gì cả."

#, python-brace-format
msgid "Machine inconnue ou mal écrite : {target}"
msgstr "Máy không xác định hoặc viết sai: {target}"

msgid ""
"Aucune machine distante dans le registre : scannez-en une d'abord (scanner "
"utilisateur@machine)."
msgstr ""
"Chưa có máy từ xa nào trong sổ đăng ký: hãy quét một máy trước (scanner "
"người_dùng@máy)."

#, python-brace-format
msgid ""
"{target} : clé de la machine pas encore acceptée, ou machine injoignable — "
"scannez-la d'abord (scanner {target})."
msgstr ""
"{target}: khóa của máy chưa được chấp nhận, hoặc máy không liên lạc được — "
"hãy quét nó trước (scanner {target})."

#, python-brace-format
msgid "Lancer sur {name} ? [o/N] "
msgstr "Chạy trên {name}? [y/N] "

#, python-brace-format
msgid "Rien n'a été lancé sur {name}."
msgstr "Không chạy gì trên {name}."

msgid "Indiquez soit un outil à retirer, soit --tout."
msgstr "Hãy chỉ định một công cụ cần gỡ, hoặc --tout."

msgid "--garder-zone et --effacer vont avec --tout."
msgstr "--garder-zone và --effacer đi kèm với --tout."

msgid "Machines distantes indisponibles ici."
msgstr "Máy từ xa không khả dụng ở đây."

msgid "Indiquez --machine MACHINE ou --toutes-machines."
msgstr "Hãy chỉ định --machine MACHINE hoặc --toutes-machines."

#, python-brace-format
msgid "Aucune machine distante du registre ne correspond à : {target}"
msgstr "Không có máy từ xa nào trong sổ đăng ký khớp với: {target}"

#, python-brace-format
msgid "{machine} retirée du registre (rien n'a été modifié sur elle)."
msgstr "Đã gỡ {machine} khỏi sổ đăng ký (không thay đổi gì trên máy đó)."

#, python-brace-format
msgid "Rapport enregistré : {path}"
msgstr "Đã lưu báo cáo: {path}"

#, python-brace-format
msgid "aucune version publiée sur GitHub ({url})"
msgstr "chưa có phiên bản nào được phát hành trên GitHub ({url})"

msgid "GitHub ne répond pas depuis cet ordinateur (réseau)"
msgstr "GitHub không phản hồi từ máy tính này (mạng)"

msgid "l'archive n'est pas citée dans sha.txt de la Release : refusée"
msgstr "bản lưu trữ không có trong sha.txt của bản Release: bị từ chối"

msgid "empreinte différente de sha.txt : archive refusée, rien n'est envoyé"
msgstr "mã băm khác với sha.txt: từ chối bản lưu trữ, không gửi gì"

msgid "fichier trop volumineux pour une archive d'outil : refusé"
msgstr "tệp quá lớn đối với bản lưu trữ của công cụ: bị từ chối"

#, python-brace-format
msgid ""
"la dernière version publiée sur GitHub ({latest}) est encore trop ancienne"
msgstr "phiên bản mới nhất phát hành trên GitHub ({latest}) vẫn quá cũ"

msgid "extraction par-dessus, puis son install.sh"
msgstr "giải nén đè lên, rồi chạy install.sh của nó"

msgid ""
"ancienne installation mise de côté (sudo mv), nouvelle à sa place, puis son "
"install.sh qui reprend réglages et données"
msgstr ""
"bản cài đặt cũ được cất sang một bên (sudo mv), bản mới thay vào chỗ đó, rồi"
" install.sh của nó lấy lại thiết lập và dữ liệu"

msgid "Commande"
msgstr "Lệnh"

msgid "Mise à jour"
msgstr "Cập nhật"

msgid "Réparer"
msgstr "Sửa chữa"

msgid "Synchroniser"
msgstr "Đồng bộ"

#, python-brace-format
msgid ""
"{tool} {version} ({root}) : réinstallation (installation inachevée) — {how}"
msgstr "{tool} {version} ({root}): cài đặt lại (cài đặt dở dang) — {how}"

msgid "(installation inachevée)"
msgstr "(cài đặt dở dang)"

#, python-brace-format
msgid "{head} → {latest} ({root}) : {how}"
msgstr "{head} → {latest} ({root}): {how}"

#, python-brace-format
msgid "{head} ({root}) : pas de mise à jour possible — {reason}"
msgstr "{head} ({root}): không thể cập nhật — {reason}"

#, python-brace-format
msgid ""
"Tout se passe dans ce terminal : le mot de passe sudo de {name} est demandé "
"par la machine elle-même, une fois ; omega-connect ne le voit jamais."
msgstr ""
"Mọi việc diễn ra trong terminal này: chính máy {name} sẽ hỏi mật khẩu sudo, "
"một lần; omega-connect không bao giờ thấy mật khẩu đó."

#, python-brace-format
msgid "Réinstaller l'application — machine {name} ({target})"
msgstr "Cài đặt lại ứng dụng — máy {name} ({target})"

#, python-brace-format
msgid "Mettre à jour l'application — machine {name} ({target})"
msgstr "Cập nhật ứng dụng — máy {name} ({target})"

msgid ""
"Aucune application trop ancienne sur cette machine : rien à mettre à jour."
msgstr "Không có ứng dụng nào quá cũ trên máy này: không có gì để cập nhật."

msgid ""
"Archives prises sur la Release GitHub de chaque application (empreinte "
"vérifiée avec sha.txt avant tout envoi) :"
msgstr ""
"Bản lưu trữ lấy từ bản Release GitHub của từng ứng dụng (mã băm được kiểm "
"tra với sha.txt trước khi gửi):"

msgid ""
"Rien d'autre n'est fait. Ensuite, pour remettre les liens en place : "
"Synchronisation."
msgstr "Không làm gì khác. Sau đó, để khôi phục liên kết: Đồng bộ hóa."

#, python-brace-format
msgid "Synchroniser — machine {name} ({target})"
msgstr "Đồng bộ — máy {name} ({target})"

msgid ""
"Laissées de côté, trop anciennes (Registre → « Mettre à jour l'application »"
" d'abord) :"
msgstr "Bỏ qua, quá cũ (trước hết: Sổ đăng ký → “Cập nhật ứng dụng”):"

msgid ""
"Rien à synchroniser : tout ce qui peut l'être est relié sur cette machine."
msgstr ""
"Không có gì để đồng bộ: mọi thứ có thể liên kết đều đã được liên kết trên "
"máy này."

msgid "Réparer puis synchroniser, sur la machine. Plan :"
msgstr "Sửa chữa rồi đồng bộ, trên máy đó. Kế hoạch:"

msgid ""
"L'espace partagé de cette machine n'est lisible qu'avec sudo : il sera relu "
"au lancement."
msgstr ""
"Không gian chia sẻ của máy này chỉ đọc được bằng sudo: nó sẽ được đọc lại "
"khi chạy."

#, python-brace-format
msgid "Réparer — machine {name} ({target})"
msgstr "Sửa chữa — máy {name} ({target})"

#, python-brace-format
msgid "« Réparer {name} » lance ces commandes SUR la machine, depuis ici."
msgstr "“Sửa chữa {name}” chạy các lệnh này TRÊN máy đó, từ đây."

#, python-brace-format
msgid ""
"Commandes qu'aucun outil ne sait lancer — lancées AUSSI sur {name} par « "
"Réparer {name} », une à une, après les corrections des outils (celles déjà "
"réglées entre-temps sont sautées) :"
msgstr ""
"Các lệnh mà không công cụ nào biết chạy — CŨNG được chạy trên {name} bởi "
"“Sửa chữa {name}”, lần lượt từng lệnh, sau các bước khắc phục của công cụ "
"(lệnh nào trong lúc đó đã được thiết lập sẽ bị bỏ qua):"

#, python-brace-format
msgid "Rien n'a été envoyé à {target} :"
msgstr "Không gửi gì đến {target}:"

#, python-brace-format
msgid "Envoi impossible vers {target}."
msgstr "Không thể gửi đến {target}."

#, python-brace-format
msgid "Résultat pour {target} :"
msgstr "Kết quả cho {target}:"

