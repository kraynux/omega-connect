msgstr "Không gian chia sẻ của {machine}: "

#, python-brace-format
msgid "{tool} : {hint}"
msgstr "{tool}: {hint}"

msgid "Lecture de l'espace partagé…"
msgstr "Đang đọc không gian chia sẻ…"

#, python-brace-format
msgid "Préparation du plan de synchronisation de {machine}…"
msgstr "Đang chuẩn bị kế hoạch đồng bộ cho {machine}…"

