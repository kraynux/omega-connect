#, python-brace-format
msgid "omega-connect — machine {machine}"
msgstr "omega-connect — الجهاز {machine}"

#, python-brace-format
msgid "== Mise à jour de {tool} vers {version} ({root})"
msgstr "== تحديث {tool} إلى {version} ({root})"

#, python-brace-format
msgid "✗ {tool} : {error}"
msgstr "✗ {tool}: {error}"

#, python-brace-format
msgid "✓ {tool} {version} installé."
msgstr "✓ تم تثبيت {tool} {version}."

#, python-brace-format
msgid "· déjà réglé : {command}"
msgstr "· مضبوط مسبقًا: {command}"

#, python-brace-format
msgid "archive refusée : chemin inattendu {name}"
msgstr "رُفض الأرشيف: مسار غير متوقع {name}"

#, python-brace-format
msgid "archive refusée : {name} n'est ni un fichier ni un dossier"
msgstr "رُفض الأرشيف: {name} ليس ملفًا ولا مجلدًا"

msgid "archive refusée : trop volumineuse une fois extraite"
msgstr "رُفض الأرشيف: حجمه كبير جدًا بعد الاستخراج"

#, python-brace-format
msgid "archive refusée : pas de dossier {tool}/"
msgstr "رُفض الأرشيف: لا يوجد مجلد {tool}/"

#, python-brace-format
msgid "{path} est un lien : rien n'est copié dedans"
msgstr "{path} رابط رمزي: لا يُنسخ شيء داخله"

#, python-brace-format
msgid "{root} n'est pas un dossier d'installation"
msgstr "{root} ليس مجلد تثبيت"

#, python-brace-format
msgid "{root} n'appartient pas à ce compte : mise à jour faite à la main"
msgstr "{root} لا يخص هذا الحساب: يجب التحديث يدويًا"

msgid "empreinte de l'archive différente de sha.txt : rien n'est installé"
msgstr "بصمة الأرشيف تختلف عن sha.txt: لم يُثبَّت شيء"

#, python-brace-format
msgid "Mise de côté de l'ancienne installation : {old} → {new}"
msgstr "نقل التثبيت القديم جانبًا: {old} → {new}"

msgid "impossible de mettre l'ancienne installation de côté (sudo mv)"
msgstr "تعذّر نقل التثبيت القديم جانبًا (sudo mv)"

#, python-brace-format
msgid "{count} fichiers installés dans {root}."
msgstr "تم تثبيت {count} ملفًا في {root}."

#, python-brace-format
msgid "install.sh introuvable dans {root}"
msgstr "install.sh غير موجود في {root}"

#, python-brace-format
msgid ""
"Environnement Python (.venv) incomplet mis de côté : {path} — install.sh en "
"recrée un."
msgstr ""
"نُقلت بيئة Python (.venv) غير المكتملة جانبًا: {path} — سيُنشئ install.sh "
"بيئة جديدة."

#, python-brace-format
msgid "Lancement de {path} :"
msgstr "تشغيل {path}:"

#, python-brace-format
msgid "install.sh a échoué (code {code})"
msgstr "فشل install.sh (الرمز {code})"

#, python-brace-format
msgid "{script} introuvable : réglages et données restés dans {old}"
msgstr "{script} غير موجود: بقيت الإعدادات والبيانات في {old}"

#, python-brace-format
msgid ""
"Reprise des réglages et données de {old} (autres anciennes installations "
"ignorées : {others})"
msgstr ""
"استعادة الإعدادات والبيانات من {old} (تم تجاهل التثبيتات القديمة الأخرى: "
"{others})"

#, python-brace-format
msgid "reprise de {old} échouée ({script})"
msgstr "فشلت الاستعادة من {old} ({script})"

msgid "contient l'installation d'omega-connect"
msgstr "يحتوي على تثبيت omega-connect"

msgid "registre omega-serv"
msgstr "سجل omega-serv"

msgid "systemd"
msgstr "systemd"

msgid "OpenRC"
msgstr "OpenRC"

msgid "runit"
msgstr "runit"

msgid "dossier personnel"
msgstr "المجلد الشخصي"

msgid "/srv"
msgstr "/srv"

msgid "chemin saisi"
msgstr "مسار مُدخَل"

msgid "absent"
msgstr "غائب"

msgid "illisible (droits)"
msgstr "غير قابل للقراءة (أذونات)"

msgid "abîmé"
msgstr "تالف"

msgid "d'une version plus récente qu'omega-connect"
msgstr "من إصدار أحدث من omega-connect"

msgid "non fournie (version de l'outil trop ancienne ?)"
msgstr "غير متوفرة (إصدار الأداة قديم جدًا؟)"

msgid "non obtenue"
msgstr "لم يتم الحصول عليها"

msgid "illisible"
msgstr "غير قابل للقراءة"

msgid "active"
msgstr "نشط"

msgid "désactivée"
msgstr "معطّل"

msgid "absente"
msgstr "غائب"

msgid "inconnue"
msgstr "غير معروفة"

#, python-brace-format
msgid "registre des instances omega-serv illisible : {detail}"
msgstr "سجل مثيلات omega-serv غير قابل للقراءة: {detail}"

#, python-brace-format
msgid "instance omega-serv enregistrée mais dossier disparu : {detail}"
msgstr "مثيل omega-serv مسجَّل لكن مجلده اختفى: {detail}"

#, python-brace-format
msgid "fichier de service illisible : {detail}"
msgstr "ملف الخدمة غير قابل للقراءة: {detail}"

#, python-brace-format
msgid "service {detail} : dossier d'installation introuvable"
msgstr "الخدمة {detail}: مجلد التثبيت غير موجود"

#, python-brace-format
msgid "recherche arrêtée (trop de dossiers) dans {detail}"
msgstr "توقف البحث (مجلدات كثيرة جدًا) في {detail}"

#, python-brace-format
msgid "montage réseau non parcouru : {detail}"
msgstr "لم يُستعرض مجلد مُركَّب عبر الشبكة: {detail}"

#, python-brace-format
msgid "dossier introuvable : {detail}"
msgstr "المجلد غير موجود: {detail}"

#, python-brace-format
msgid "aucun outil omega dans : {detail}"
msgstr "لا توجد أي أداة omega في: {detail}"

#, python-brace-format
msgid "créez-le sous le compte {owner} : {command}"
msgstr "أنشئه باسم الحساب {owner}: {command}"

msgid "outil inconnu"
msgstr "أداة غير معروفة"

#, python-brace-format
msgid "trouvé par : {sources}"
msgstr "عُثر عليه عبر: {sources}"

#, python-brace-format
msgid "propriétaire : {owner}"
msgstr "المالك: {owner}"

#, python-brace-format
msgid "service : {names}"
msgstr "الخدمة: {names}"

#, python-brace-format
msgid "jeton : présent (identifiant {identifier}, version {version})"
msgstr "الرمز: موجود (المعرّف {identifier}، الإصدار {version})"

#, python-brace-format
msgid "jeton : {state}"
msgstr "الرمز: {state}"

#, python-brace-format
msgid "fiche : {state}"
msgstr "البطاقة الوصفية: {state}"

#, python-brace-format
msgid "détail technique : {detail}"
msgstr "تفاصيل تقنية: {detail}"

#, python-brace-format
msgid "fiche : instance {instance}"
msgstr "البطاقة الوصفية: المثيل {instance}"

#, python-brace-format
msgid "service {manager} ({state})"
msgstr "الخدمة {manager} ({state})"

msgid "partielle (sans root)"
msgstr "جزئية (دون root)"

#, python-brace-format
msgid "fonctions : {states}"
msgstr "الوظائف: {states}"

#, python-brace-format
msgid "Détection des outils omega (HOME examiné : {home})"
msgstr "اكتشاف أدوات omega (المجلد HOME المفحوص: {home})"

msgid "Aucun outil omega trouvé. Indiquez un dossier avec --chemin."
msgstr "لم يُعثر على أي أداة omega. حدّد مجلدًا باستخدام --chemin."

#, python-brace-format
msgid ""
"Identifiant en double {identifier} : {roots} (dossier copié à la main ?). "
"Ces installations ne sont pas fusionnées ; ouvrez la copie une fois pour lui"
" donner un nouvel identifiant."
msgstr ""
"معرّف مكرر {identifier}: {roots} (مجلد نُسخ يدويًا؟). لا تُدمج هذه "
"التثبيتات؛ افتح النسخة مرة واحدة لتحصل على معرّف جديد."

msgid "Remarques sur la recherche :"
msgstr "ملاحظات حول البحث:"

#, python-brace-format
msgid "{count} installation(s) trouvée(s)."
msgstr "عُثر على {count} تثبيت/تثبيتات."

msgid "Détectée"
msgstr "مُكتشَف"

msgid "Inscrite"
msgstr "مُسجَّل"

msgid "Reliée"
msgstr "مرتبط"

msgid "À réparer"
msgstr "يحتاج إصلاحًا"

msgid "Ancienne version"
msgstr "إصدار قديم"

msgid "Installation inachevée"
msgstr "تثبيت غير مكتمل"

msgid "Injoignable"
msgstr "يتعذّر الوصول إليه"

msgid "trouvée, sans carte d'identité : la Synchronisation la lui crée"
msgstr "عُثر عليه، دون بطاقة هوية: المزامنة تُنشئها له"

msgid ""
"a sa carte d'identité, pas encore dans l'espace partagé : la Synchronisation"
" l'y ajoute"
msgstr ""
"لديه بطاقة هوية، لكنه ليس بعد في المساحة المشتركة: المزامنة تضيفه إليها"

msgid "dans l'espace partagé, à jour"
msgstr "في المساحة المشتركة، محدَّث"

msgid "un écart : Réparer le corrige"
msgstr "خلل: الإصلاح يصحّحه"

msgid "trop ancienne pour avoir une carte d'identité : mettez-la à jour"
msgstr "قديم جدًا ليملك بطاقة هوية: حدِّثه"

msgid ""
"installée, mais son install.sh ne s'est pas terminé (environnement Python ou"
" carte d'identité manquants) : « Réinstaller l'application » (Registre)"
msgstr ""
"مثبَّت، لكن install.sh الخاص به لم يكتمل (بيئة Python أو بطاقة الهوية "
"مفقودة): «إعادة تثبيت التطبيق» (السجل)"

msgid "machine qui ne répond pas"
msgstr "جهاز لا يستجيب"

#, python-brace-format
msgid ""
"trop ancienne pour avoir une carte d'identité : {tool} {version} ou plus "
"récent requis (machine distante : Synchronisation la met à jour depuis "
"GitHub)"
msgstr ""
"قديم جدًا ليملك بطاقة هوية: يلزم {tool} {version} أو أحدث (جهاز بعيد: "
"المزامنة تحدّثه من GitHub)"

msgid "pas encore préparé — la Synchronisation le prépare"
msgstr "لم تُجهَّز بعد — المزامنة تجهّزها"

msgid "prêt"
msgstr "جاهزة"

msgid "à corriger — la Synchronisation le remet en état"
msgstr "تحتاج تصحيحًا — المزامنة تعيدها إلى حالتها السليمة"

msgid "prêt (lu avec votre autorisation)"
msgstr "جاهزة (قُرئت بإذنك)"

msgid ""
"état inconnu depuis cette session — la Synchronisation le lira avec votre "
"autorisation"
msgstr "حالة غير معروفة في هذه الجلسة — ستقرؤها المزامنة بإذنك"

#, python-brace-format
msgid "Registre — machine {machine}"
msgstr "السجل — الجهاز {machine}"

msgid "Aucune application omega trouvée sur cette machine."
msgstr "لم يُعثر على أي تطبيق omega على هذا الجهاز."

#, python-brace-format
msgid "Espace partagé : {status}"
msgstr "المساحة المشتركة: {status}"

msgid "Synchroniser : un seul plan, un seul mot de passe administrateur"
msgstr "المزامنة: خطة واحدة، كلمة مرور مسؤول واحدة"

msgid "Rien à faire : tout est déjà synchronisé."
msgstr "لا شيء للقيام به: كل شيء متزامن مسبقًا."

msgid ""
"1. Cartes d'identité à créer (par chaque outil, sous son compte, sans mot de"
" passe) :"
msgstr ""
"1. بطاقات الهوية المطلوب إنشاؤها (بواسطة كل أداة، باسم حسابها، دون كلمة "
"مرور):"

msgid "aucune : chaque application choisie a déjà la sienne."
msgstr "لا شيء: كل تطبيق مختار لديه بطاقته مسبقًا."

msgid "2. Espace partagé (en administrateur, une commande après l'autre) :"
msgstr "2. المساحة المشتركة (بصلاحيات المسؤول، أمر تلو الآخر):"

#, python-brace-format
msgid "Recopier la carte d'identité de {root} (créée à l'étape 1)"
msgstr "نسخ بطاقة هوية {root} (المُنشأة في الخطوة 1)"

msgid "rien : l'espace partagé est déjà à jour."
msgstr "لا شيء: المساحة المشتركة محدَّثة مسبقًا."

msgid "Une commande qui n'est pas annoncée ici n'est jamais lancée."
msgstr "لا يُشغَّل أبدًا أي أمر غير معلن هنا."

#, python-brace-format
msgid ""
"Arrêt : la carte d'identité de {root} n'a pas pu être créée ({error}). Rien "
"d'autre n'a été lancé."
msgstr "توقف: تعذّر إنشاء بطاقة هوية {root} ({error}). لم يُشغَّل أي شيء آخر."

msgid "échec"
msgstr "فشل"

#, python-brace-format
msgid ""
"Arrêt avant l'espace partagé : le plan a changé ({step}). Rien de plus n'a "
"été lancé ; relancez la synchronisation pour voir le nouveau plan."
msgstr ""
"توقف قبل المساحة المشتركة: تغيّرت الخطة ({step}). لم يُشغَّل شيء إضافي؛ أعد "
"تشغيل المزامنة لرؤية الخطة الجديدة."

#, python-brace-format
msgid ""
"Arrêt à l'étape « {step} » : {error}. Ce qui a été créé est noté ; relancez "
"la synchronisation après avoir corrigé la cause."
msgstr ""
"توقف عند الخطوة «{step}»: {error}. ما أُنشئ مُدوَّن؛ أعد تشغيل المزامنة بعد "
"تصحيح السبب."

msgid "Synchronisation terminée : les applications choisies sont reliées."
msgstr "اكتملت المزامنة: التطبيقات المختارة مرتبطة."

msgid "DÉMARRAGE RAPIDE"
msgstr "بدء سريع"

msgid "RACCOURCIS"
msgstr "الاختصارات"

msgid "Aide d’omega-connect"
msgstr "مساعدة omega-connect"

msgid "Aide complète : chaque menu, sa fonction et le détail."
msgstr "المساعدة الكاملة: كل قائمة ووظيفتها وتفاصيلها."

msgid "Démarrage rapide"
msgstr "بدء سريع"

msgid "Raccourcis"
msgstr "الاختصارات"

msgid "Touche"
msgstr "المفتاح"

msgid "Action"
msgstr "الإجراء"

#, python-brace-format
msgid "OMEGA-CONNECT {version} — aide."
msgstr "OMEGA-CONNECT {version} — المساعدة."

msgid "Aide - Omega-Connect"
msgstr "مساعدة - Omega-Connect"

msgid ""
"Interconnecteur de la suite omega : détecte les outils installés, vérifie et"
" attribue les droits entre eux."
msgstr ""
"أداة الربط في مجموعة omega: تكتشف الأدوات المثبَّتة، وتتحقق من الأذونات "
"بينها وتمنحها."

msgid "commandes"
msgstr "الأوامر"

msgid "COMMANDE"
msgstr "أمر"

msgid "Cherche les outils omega installés (lecture seule, sans root)."
msgstr "يبحث عن أدوات omega المثبَّتة (للقراءة فقط، دون root)."

msgid ""
"Cherche les outils omega installés : registre d'omega-serv, services systemd"
" / OpenRC / runit, HOME (3 niveaux), /srv (2 niveaux) et chemins saisis. Ne "
"suit jamais un lien symbolique ni un montage réseau. Lit le jeton de chaque "
"installation et demande sa fiche à l'outil, sous le compte propriétaire du "
"dossier."
msgstr ""
"يبحث عن أدوات omega المثبَّتة: سجل omega-serv، وخدمات systemd / OpenRC / "
"runit، و HOME (3 مستويات)، و /srv (مستويان) والمسارات المُدخَلة. لا يتبع "
"أبدًا رابطًا رمزيًا ولا مجلدًا مُركَّبًا عبر الشبكة. يقرأ رمز كل تثبيت ويطلب"
" بطاقته الوصفية من الأداة، باسم الحساب المالك للمجلد."

msgid "DOSSIER"
msgstr "DOSSIER"

msgid "Dossier d'installation à examiner en plus (option répétable)."
msgstr "مجلد تثبيت إضافي للفحص (خيار قابل للتكرار)."

msgid ""
"Ne demande pas la fiche aux outils (plus rapide, aucune commande lancée)."
msgstr "لا يطلب البطاقة الوصفية من الأدوات (أسرع، دون تشغيل أي أمر)."

msgid "texte (défaut, traduit) ou json (pour les scripts, jamais traduit)."
msgstr "نص (افتراضي، مترجَم) أو json (للسكربتات، غير مترجَم أبدًا)."

msgid "Vérifie les liens existants entre outils (lecture seule, sans root)."
msgstr "يتحقق من الروابط القائمة بين الأدوات (للقراءة فقط، دون root)."

msgid ""
"Détecte les outils (avec leur fiche), puis contrôle chaque lien : journaux "
"d'omega-serv et de magnet lus par les jails d'omega-jail, pont fail2ban vers"
" la liste noire, liste protégée, droits de la liste noire, fichiers d'omega-"
"jail dans fail2ban, jetons. Chaque écart affiche la commande qui le "
"corrigerait, sans jamais la lancer. Code de sortie : 0 sans écart, 1 si un "
"lien est cassé ou dégradé."
msgstr ""
"يكتشف الأدوات (مع بطاقاتها الوصفية)، ثم يفحص كل رابط: ملفات سجل omega-serv و"
" magnet التي تقرؤها jails الخاصة بـ omega-jail، وجسر fail2ban نحو القائمة "
"السوداء، والقائمة المحمية، وأذونات القائمة السوداء، وملفات omega-jail في "
"fail2ban، والرموز. كل خلل يعرض الأمر الذي يصحّحه دون تشغيله أبدًا. رمز "
"الخروج: 0 دون خلل، 1 إذا كان رابط معطّلًا أو متدهورًا."

msgid "Affiche aussi les contrôles conformes."
msgstr "يعرض أيضًا الفحوص المطابقة."

msgid ""
"Ouvre le tableau de bord (défaut sans commande) : outils, liens et leur "
"état, en lecture seule."
msgstr ""
"يفتح لوحة المعلومات (الافتراضي دون أمر): الأدوات والروابط وحالتها، للقراءة "
"فقط."

msgid ""
"Tableau de bord en lecture seule : outils et instances, état de chaque lien,"
" contrôles et commandes de correction (jamais lancées). Nouvelle "
"vérification à intervalle régulier tant que l'écran est ouvert."
msgstr ""
"لوحة معلومات للقراءة فقط: الأدوات والمثيلات، وحالة كل رابط، والفحوص وأوامر "
"التصحيح (لا تُشغَّل أبدًا). تحقق جديد على فترات منتظمة ما دامت الشاشة "
"مفتوحة."

msgid ""
"Crée la zone neutre et y recopie jetons et fiches (root, après accord)."
msgstr ""
"يُنشئ المنطقة المحايدة وينسخ إليها الرموز والبطاقات الوصفية (root، بعد "
"الموافقة)."

msgid ""
"Crée le groupe omega-synchro et la zone neutre (/var/lib/omega-synchro, "
"2750), vous ajoute au groupe, recopie le jeton et la fiche de chaque outil "
"détecté, et inscrit tout au registre. Relancée, elle actualise les copies. "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"يُنشئ المجموعة omega-synchro والمنطقة المحايدة (/var/lib/omega-synchro، "
"2750)، ويضيفك إلى المجموعة، وينسخ رمز كل أداة مكتشَفة وبطاقتها الوصفية، "
"ويسجّل كل شيء في السجل. عند إعادة تشغيله، يحدّث النسخ. يُعرض كل أمر قبل "
"تشغيله باستخدام sudo."

msgid ""
"Défait ce qu'omega-connect a créé : un outil désinstallé, ou toute la zone "
"(root, après accord)."
msgstr ""
"يتراجع عمّا أنشأه omega-connect: أداة أُلغي تثبيتها، أو المنطقة كلها (root، "
"بعد الموافقة)."

msgid ""
"« retirer CIBLE » enlève de la zone un outil désinstallé (nom, dossier ou 8 "
"premiers caractères de l'identifiant). « retirer --tout » défait exactement "
"ce que le registre liste, ou garde la zone telle quelle (liens figés). "
"Chaque commande est affichée avant d'être lancée avec sudo."
msgstr ""
"«retirer CIBLE» يُزيل من المنطقة أداة أُلغي تثبيتها (الاسم أو المجلد أو أول "
"8 أحرف من المعرّف). «retirer --tout» يتراجع عمّا يُدرجه السجل بالضبط، أو "
"يُبقي المنطقة كما هي (روابط مجمّدة). يُعرض كل أمر قبل تشغيله باستخدام sudo."

msgid "CIBLE"
msgstr "CIBLE"

msgid "Outil à retirer de la zone."
msgstr "الأداة المراد إزالتها من المنطقة."

msgid "Toute la zone (question : garder ou tout retirer)."
msgstr "المنطقة كلها (سؤال: الإبقاء أو إزالة الكل)."

msgid "Avec --tout : garder la zone, liens figés (rien n'est supprimé)."
msgstr "مع --tout: إبقاء المنطقة، روابط مجمّدة (لا يُحذف شيء)."

msgid "Avec --tout : tout retirer, sans question."
msgstr "مع --tout: إزالة الكل، دون سؤال."

msgid ""
"Recherche les applications omega de cette machine et met à jour le registre "
"(lecture seule)."
msgstr "يبحث عن تطبيقات omega على هذا الجهاز ويحدّث السجل (للقراءة فقط)."

msgid ""
"Lecture seule, sans mot de passe : chaque application trouvée, son service "
"et son état (Détectée, Inscrite, Reliée, À réparer, Ancienne version, "
"Installation inachevée). Le résultat est enregistré dans le registre du parc"
" (var/parc.json)."
msgstr ""
"قراءة فقط، دون كلمة مرور: كل تطبيق موجود وخدمته وحالته (مُكتشَف، مُسجَّل، "
"مرتبط، يحتاج إصلاحًا، إصدار قديم، تثبيت غير مكتمل). تُحفَظ النتيجة في سجل "
"الأجهزة (var/parc.json)."

msgid "UTILISATEUR@MACHINE"
msgstr "UTILISATEUR@MACHINE"

msgid ""
"Machine distante à scanner par SSH avec vos clés (rien n'y est installé) ; "
"sans cible : cette machine."
msgstr ""
"جهاز بعيد يُمسح عبر SSH بمفاتيحك (لا يُثبَّت عليه شيء)؛ دون هدف: هذا الجهاز."

msgid "MACHINE"
msgstr "MACHINE"

msgid ""
"Retire une machine distante du registre (nom, adresse ou "
"utilisateur@adresse) ; rien n'est modifié sur elle."
msgstr ""
"يُزيل جهازًا بعيدًا من السجل (الاسم أو العنوان أو المستخدم@العنوان)؛ لا "
"يُعدَّل عليه شيء."

msgid ""
"Liste les machines que cet ordinateur sait déjà joindre (profils Unison, "
"~/.ssh/config, known_hosts)."
msgstr ""
"يسرد الأجهزة التي يعرف هذا الحاسوب الوصول إليها مسبقًا (ملفات تعريف Unison، "
"~/.ssh/config، known_hosts)."

msgid ""
"Remet en place les liens de ce qui est installé : cartes d'identité, espace "
"partagé, accès des services — un seul plan."
msgstr ""
"يعيد ربط ما هو مثبَّت: بطاقات الهوية، والمساحة المشتركة، ووصول الخدمات — خطة"
" واحدة."

msgid ""
"Une seule action (décision de l'auteur) : recrée les cartes d'identité qui "
"manquent (commande de chaque outil, sous son compte), prépare l'espace "
"partagé, y recopie les cartes et donne l'accès aux services. Tout est "
"affiché avant d'agir ; un seul mot de passe administrateur. Sans CIBLE : "
"toutes les applications de la machine."
msgstr ""
"إجراء واحد (قرار المؤلف): يعيد إنشاء بطاقات الهوية المفقودة (أمر كل أداة، "
"باسم حسابها)، ويجهّز المساحة المشتركة، وينسخ إليها البطاقات ويمنح الخدمات حق"
" الوصول. يُعرض كل شيء قبل التنفيذ؛ كلمة مرور مسؤول واحدة. دون CIBLE: كل "
"تطبيقات الجهاز."

msgid ""
"Application à synchroniser : nom (omega-fire) ou dossier ; plusieurs "
"possibles."
msgstr ""
"التطبيق المراد مزامنته: الاسم (omega-fire) أو المجلد؛ يمكن تحديد عدة "
"تطبيقات."

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; option "
"répétable) : réparer puis synchroniser, sans rien taper là-bas (une "
"application trop ancienne : mettre-a-jour d'abord)."
msgstr ""
"جهاز بعيد سبق مسحه (الاسم أو العنوان أو المستخدم@الجهاز؛ خيار قابل للتكرار):"
" إصلاح ثم مزامنة، دون كتابة أي شيء هناك (تطبيق قديم جدًا: mettre-a-jour "
"أولًا)."

msgid ""
"Toutes les machines distantes du registre, une à une (un mot de passe par "
"machine)."
msgstr "كل الأجهزة البعيدة في السجل، واحدًا تلو الآخر (كلمة مرور لكل جهاز)."

msgid ""
"Met à jour les applications trop anciennes d'une machine distante, depuis "
"leur Release GitHub (rien d'autre)."
msgstr ""
"يحدّث التطبيقات القديمة جدًا على جهاز بعيد، من Release الخاص بها على GitHub "
"(لا شيء آخر)."

msgid ""
"Archive prise sur GitHub, empreinte vérifiée avec sha.txt, puis installée "
"sur la machine (comme la section « Mise à jour » du README de l'outil). Ne "
"répare ni ne synchronise : voir synchroniser."
msgstr ""
"يُجلب الأرشيف من GitHub، وتُتحقق بصمته باستخدام sha.txt، ثم يُثبَّت على "
"الجهاز (كما في قسم «التحديث» من README الأداة). لا يُصلح ولا يُزامن: انظر "
"synchroniser."

msgid ""
"Machine distante déjà scannée (nom, adresse ou utilisateur@machine ; "
"répétable)."
msgstr ""
"جهاز بعيد سبق مسحه (الاسم أو العنوان أو المستخدم@الجهاز؛ قابل للتكرار)."

msgid "Toutes les machines distantes du registre, une à une."
msgstr "كل الأجهزة البعيدة في السجل، واحدًا تلو الآخر."

msgid ""
"Corrige les écarts trouvés par verifier avec la commande de l'outil qui les "
"possède (root, après accord)."
msgstr ""
"يصحّح الاختلالات التي وجدها verifier بأمر الأداة المالكة لها (root، بعد "
"الموافقة)."

msgid ""
"Ne corrige que ce qu'un outil sait corriger lui-même (omega-jail --apply "
"--update, omega-serv service permissions, synchro jeton de chaque outil) et "
"ce que le registre de la zone dit qu'omega-connect a créé (plan d'etablir, "
"affiché à son tour). omega-connect ne réécrit jamais le fichier d'un autre "
"outil : le reste est affiché, à faire à la main. Chaque commande est "
"affichée avant d'être lancée."
msgstr ""
"لا يصحّح إلا ما تعرف الأداة تصحيحه بنفسها (omega-jail --apply --update، "
"omega-serv service permissions، synchro jeton لكل أداة) وما يقول سجل المنطقة"
" إن omega-connect أنشأه (خطة etablir، تُعرض بدورها). لا يعيد omega-connect "
"أبدًا كتابة ملف أداة أخرى: يُعرض الباقي ليُنفَّذ يدويًا. يُعرض كل أمر قبل "
"تشغيله."

msgid ""
"Machine distante déjà scannée : réparée depuis ici, rien à taper là-bas "
"(répétable)."
msgstr ""
"جهاز بعيد سبق مسحه: يُصلَح من هنا، دون كتابة أي شيء هناك (قابل للتكرار)."

msgid ""
"Rapport complet : outils, jetons, fiches, liens et tous leurs contrôles, "
"zone et registre (lecture seule)."
msgstr ""
"تقرير كامل: الأدوات، والرموز، والبطاقات الوصفية، والروابط وكل فحوصها، "
"والمنطقة والسجل (للقراءة فقط)."

msgid ""
"Tout ce qu'omega-connect sait à cet instant, en lecture seule et sans root :"
" outils et instances, jetons, fiches, chaque lien avec tous ses contrôles et"
" les commandes de correction, remarques de la recherche, zone neutre et son "
"registre. Affiché, ou enregistré dans var/exports/ avec --enregistrer."
msgstr ""
"كل ما يعرفه omega-connect في هذه اللحظة، للقراءة فقط ودون root: الأدوات "
"والمثيلات، والرموز، والبطاقات الوصفية، وكل رابط مع كل فحوصه وأوامر التصحيح، "
"وملاحظات البحث، والمنطقة المحايدة وسجلها. يُعرض، أو يُحفظ في var/exports/ "
"باستخدام --enregistrer."

msgid ""
"texte (défaut, traduit), json (jamais traduit) ou html (page autonome)."
msgstr ""
"نص (افتراضي، مترجَم)، أو json (غير مترجَم أبدًا) أو html (صفحة مستقلة)."

msgid "Thème de la page HTML."
msgstr "سمة صفحة HTML."

msgid "Enregistre dans var/exports/ au lieu d'afficher, et donne le chemin."
msgstr "يحفظ في var/exports/ بدل العرض، ويعطي المسار."

msgid "Affiche seulement les commandes, sans rien lancer."
msgstr "يعرض الأوامر فقط، دون تشغيل أي شيء."

msgid "Lance sans demander l'accord (les commandes restent affichées)."
msgstr "يشغّل دون طلب الموافقة (تبقى الأوامر معروضة)."

msgid ""
"Votre session n'a pas encore le groupe omega-synchro (il ne compte qu'après "
"une reconnexion) : lecture de la zone avec sudo (find, stat, cat)."
msgstr ""
"جلستك لا تملك بعد المجموعة omega-synchro (لا تُحتسب إلا بعد إعادة تسجيل "
"الدخول): قراءة المنطقة باستخدام sudo (find، stat، cat)."

msgid "Authentification sudo refusée ou annulée : rien n'est fait."
msgstr "رُفضت مصادقة sudo أو أُلغيت: لم يُنفَّذ شيء."

#, python-brace-format
msgid "Lancer ces {count} commande(s) en root ? [o/N] "
msgstr "تشغيل هذه الأوامر ({count}) بصلاحيات root؟ [o/N] "

msgid "Authentification sudo refusée ou annulée : rien n'a été lancé."
msgstr "رُفضت مصادقة sudo أو أُلغيت: لم يُشغَّل شيء."

msgid ""
"Pas de terminal pour poser la question : relancez avec --garder-zone ou "
"--effacer."
msgstr "لا توجد طرفية لطرح السؤال: أعد التشغيل مع --garder-zone أو --effacer."

msgid "Garder la zone (liens figés) [g], tout retirer [t], ou annuler [a] ? "
msgstr ""
"الإبقاء على المنطقة (روابط مجمّدة) [g]، إزالة الكل [t]، أو الإلغاء [a]؟ "

msgid ""
"Pas de terminal pour demander l'accord : relancez avec --oui, ou "
"--simulation."
msgstr "لا توجد طرفية لطلب الموافقة: أعد التشغيل مع --oui، أو --simulation."

msgid "Abandon : rien n'a été lancé."
msgstr "إلغاء: لم يُشغَّل شيء."

#, python-brace-format
msgid "Lancer ces {count} commande(s) ? [o/N] "
msgstr "تشغيل هذه الأوامر ({count})؟ [o/N] "

msgid ""
"Zone neutre : plan d'« etablir » (seulement ce que le registre dit avoir "
"créé)."
msgstr "المنطقة المحايدة: خطة «etablir» (فقط ما يقول السجل إنه أنشأه)."

#, python-brace-format
msgid "Registre du parc non enregistré : {error}"
msgstr "لم يُحفظ سجل الأجهزة: {error}"

msgid "Saisissez utilisateur@machine (nom ou adresse), sans espace ni option."
msgstr "أدخل المستخدم@الجهاز (الاسم أو العنوان)، دون مسافة ولا خيار."

msgid "Pas de terminal pour demander la confiance : rien n'a été fait."
msgstr "لا توجد طرفية لطلب الثقة: لم يُنفَّذ شيء."

msgid "Faire confiance à cette machine ? [o/N] "
msgstr "الوثوق بهذا الجهاز؟ [o/N] "

msgid "Rien n'a été fait."
msgstr "لم يُنفَّذ شيء."

msgid "Impossible d'ajouter la clé à ~/.ssh/known_hosts."
msgstr "تعذّرت إضافة المفتاح إلى ~/.ssh/known_hosts."

#, python-brace-format
msgid "Aucune application ne correspond à : {targets}"
msgstr "لا يوجد تطبيق يطابق: {targets}"

msgid "Lancer ce plan ? [o/N] "
msgstr "تشغيل هذه الخطة؟ [o/N] "

msgid "Authentification refusée ou annulée : rien n'a été lancé."
msgstr "رُفضت المصادقة أو أُلغيت: لم يُشغَّل شيء."

#, python-brace-format
msgid "Machine inconnue ou mal écrite : {target}"
msgstr "جهاز غير معروف أو مكتوب بشكل خاطئ: {target}"

msgid ""
"Aucune machine distante dans le registre : scannez-en une d'abord (scanner "
"utilisateur@machine)."
msgstr ""
"لا يوجد أي جهاز بعيد في السجل: امسح جهازًا أولًا (scanner "
"utilisateur@machine)."

#, python-brace-format
msgid ""
"{target} : clé de la machine pas encore acceptée, ou machine injoignable — "
"scannez-la d'abord (scanner {target})."
msgstr ""
"{target}: لم يُقبل مفتاح الجهاز بعد، أو يتعذّر الوصول إلى الجهاز — امسحه "
"أولًا (scanner {target})."

#, python-brace-format
msgid "Lancer sur {name} ? [o/N] "
msgstr "التشغيل على {name}؟ [o/N] "

#, python-brace-format
msgid "Rien n'a été lancé sur {name}."
msgstr "لم يُشغَّل شيء على {name}."

msgid "Indiquez soit un outil à retirer, soit --tout."
msgstr "حدّد إما أداة لإزالتها، وإما --tout."

msgid "--garder-zone et --effacer vont avec --tout."
msgstr "--garder-zone و --effacer يُستخدمان مع --tout."

msgid "Machines distantes indisponibles ici."
msgstr "الأجهزة البعيدة غير متاحة هنا."

msgid "Indiquez --machine MACHINE ou --toutes-machines."
msgstr "حدّد --machine MACHINE أو --toutes-machines."

#, python-brace-format
msgid "Aucune machine distante du registre ne correspond à : {target}"
msgstr "لا يوجد جهاز بعيد في السجل يطابق: {target}"

#, python-brace-format
msgid "{machine} retirée du registre (rien n'a été modifié sur elle)."
msgstr "أُزيل {machine} من السجل (لم يُعدَّل عليه شيء)."

#, python-brace-format
msgid "Rapport enregistré : {path}"
msgstr "تم حفظ التقرير: {path}"

#, python-brace-format
msgid "aucune version publiée sur GitHub ({url})"
msgstr "لا يوجد أي إصدار منشور على GitHub ({url})"

msgid "GitHub ne répond pas depuis cet ordinateur (réseau)"
msgstr "GitHub لا يستجيب من هذا الحاسوب (الشبكة)"

msgid "l'archive n'est pas citée dans sha.txt de la Release : refusée"
msgstr "الأرشيف غير مذكور في sha.txt الخاص بالـ Release: مرفوض"

msgid "empreinte différente de sha.txt : archive refusée, rien n'est envoyé"
msgstr "البصمة تختلف عن sha.txt: رُفض الأرشيف، لم يُرسَل شيء"

msgid "fichier trop volumineux pour une archive d'outil : refusé"
msgstr "ملف كبير جدًا بالنسبة لأرشيف أداة: مرفوض"

#, python-brace-format
msgid ""
"la dernière version publiée sur GitHub ({latest}) est encore trop ancienne"
msgstr "آخر إصدار منشور على GitHub ({latest}) لا يزال قديمًا جدًا"

msgid "extraction par-dessus, puis son install.sh"
msgstr "استخراج فوق التثبيت الحالي، ثم install.sh الخاص به"

msgid ""
"ancienne installation mise de côté (sudo mv), nouvelle à sa place, puis son "
"install.sh qui reprend réglages et données"
msgstr ""
"نُقل التثبيت القديم جانبًا (sudo mv)، والجديد في مكانه، ثم install.sh الخاص "
"به الذي يستعيد الإعدادات والبيانات"

msgid "Commande"
msgstr "الأمر"

msgid "Mise à jour"
msgstr "تحديث"

msgid "Réparer"
msgstr "إصلاح"

msgid "Synchroniser"
msgstr "مزامنة"

#, python-brace-format
msgid ""
"{tool} {version} ({root}) : réinstallation (installation inachevée) — {how}"
msgstr "{tool} {version} ({root}): إعادة تثبيت (تثبيت غير مكتمل) — {how}"

msgid "(installation inachevée)"
msgstr "(تثبيت غير مكتمل)"

#, python-brace-format
msgid "{head} → {latest} ({root}) : {how}"
msgstr "{head} → {latest} ({root}): {how}"

#, python-brace-format
msgid "{head} ({root}) : pas de mise à jour possible — {reason}"
msgstr "{head} ({root}): لا يمكن التحديث — {reason}"

#, python-brace-format
msgid ""
"Tout se passe dans ce terminal : le mot de passe sudo de {name} est demandé "
"par la machine elle-même, une fois ; omega-connect ne le voit jamais."
msgstr ""
"كل شيء يجري في هذه الطرفية: كلمة مرور sudo الخاصة بـ {name} يطلبها الجهاز "
"نفسه، مرة واحدة؛ ولا يراها omega-connect أبدًا."

#, python-brace-format
msgid "Réinstaller l'application — machine {name} ({target})"
msgstr "إعادة تثبيت التطبيق — الجهاز {name} ({target})"

#, python-brace-format
msgid "Mettre à jour l'application — machine {name} ({target})"
msgstr "تحديث التطبيق — الجهاز {name} ({target})"

msgid ""
"Aucune application trop ancienne sur cette machine : rien à mettre à jour."
msgstr "لا يوجد تطبيق قديم جدًا على هذا الجهاز: لا شيء للتحديث."

msgid ""
"Archives prises sur la Release GitHub de chaque application (empreinte "
"vérifiée avec sha.txt avant tout envoi) :"
msgstr ""
"أرشيفات مأخوذة من Release كل تطبيق على GitHub (البصمة مُتحقَّق منها باستخدام"
" sha.txt قبل أي إرسال):"

msgid ""
"Rien d'autre n'est fait. Ensuite, pour remettre les liens en place : "
"Synchronisation."
msgstr "لا يُنفَّذ أي شيء آخر. بعد ذلك، لإعادة ربط الروابط: المزامنة."

#, python-brace-format
msgid "Synchroniser — machine {name} ({target})"
msgstr "المزامنة — الجهاز {name} ({target})"

msgid ""
"Laissées de côté, trop anciennes (Registre → « Mettre à jour l'application »"
" d'abord) :"
msgstr "مُستبعَدة لأنها قديمة جدًا (السجل → «تحديث التطبيق» أولًا):"

msgid ""
"Rien à synchroniser : tout ce qui peut l'être est relié sur cette machine."
msgstr "لا شيء للمزامنة: كل ما يمكن ربطه مرتبط على هذا الجهاز."

msgid "Réparer puis synchroniser, sur la machine. Plan :"
msgstr "الإصلاح ثم المزامنة، على الجهاز. الخطة:"

msgid ""
"L'espace partagé de cette machine n'est lisible qu'avec sudo : il sera relu "
"au lancement."
msgstr ""
"المساحة المشتركة لهذا الجهاز لا تُقرأ إلا باستخدام sudo: ستُعاد قراءتها عند "
"التشغيل."

#, python-brace-format
msgid "Réparer — machine {name} ({target})"
msgstr "إصلاح — الجهاز {name} ({target})"

#, python-brace-format
msgid "« Réparer {name} » lance ces commandes SUR la machine, depuis ici."
msgstr "«إصلاح {name}» يشغّل هذه الأوامر على الجهاز نفسه، من هنا."

#, python-brace-format
msgid ""
"Commandes qu'aucun outil ne sait lancer — lancées AUSSI sur {name} par « "
