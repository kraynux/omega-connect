#, python-brace-format
msgid ""
"Registre {status} ({detail}) : rien ne sera retiré tant qu'il n'est pas "
"réparé."
msgstr "السجل {status} ({detail}): لن يُزال شيء ما دام لم يُصلَح."

#, python-brace-format
msgid "Zone {zone} — {state} — mise à jour le {date}."
msgstr "المنطقة {zone} — {state} — حُدّثت في {date}."

