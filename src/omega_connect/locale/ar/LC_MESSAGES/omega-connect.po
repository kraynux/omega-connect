msgstr "{subject} غير مرتبط: الرمز {detail} (انظر «verifier»)."

#, python-brace-format
msgid "{subject} n'est pas relié : identifiant {detail} en double."
msgstr "{subject} غير مرتبط: المعرّف {detail} مكرر."

#, python-brace-format
