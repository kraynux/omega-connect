msgstr "السجل {subject} تالف ({detail}): لن يُنفَّذ شيء ما دام لم يُصلَح."

#, python-brace-format
msgid "aucune zone en {subject} : rien à retirer."
msgstr "لا توجد منطقة في {subject}: لا شيء للإزالة."

#, python-brace-format
msgid ""
"« {subject} » ne désigne aucun outil du registre (nom, dossier ou 8 premiers"
