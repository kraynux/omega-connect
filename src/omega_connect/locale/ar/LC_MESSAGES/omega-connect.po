msgstr ""
"المجموعة {subject} محفوظة (لم يُنشئها omega-connect، أو المنطقة غير فارغة)."

#, python-brace-format
msgid ""
"le service {subject} a toujours le groupe omega-synchro, mais omega-serv est"
